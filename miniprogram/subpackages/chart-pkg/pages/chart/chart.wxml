<view class="canvas-bg theme-{{theme}}" wx:if="{{!reduceMotion}}"></view>

<view class="page {{reduceMotion ? 'no-motion' : ''}} theme-{{theme}}">
  <view class="chart-halo"></view>

  <!-- 透明导航栏 -->
  <view class="navbar" style="padding-top: {{statusBarHeight}}px;">
    <view class="nav-btn tap" hover-class="nav-btn-hover" bindtap="onBack">
      <view class="ic ic-xs ic-back"></view>
    </view>
    <text class="nav-title">趋势</text>
    <view class="nav-spacer"></view>
  </view>

  <!-- 文字摘要 -->
  <view class="summary glass entry-up" wx:if="{{summary.rangeText}}">
    <text class="sum-label">{{summary.rangeText}}</text>
    <view class="sum-lines">
      <text class="sum-line" wx:for="{{summary.lines}}" wx:key="*this">{{item}}</text>
    </view>
  </view>

  <!-- Tab 切换 + 名义/真实 口径切换 -->
  <view class="tabs-row entry-up d1">
    <view class="tabs">
      <view
        wx:for="{{tabs}}"
        wx:key="key"
        class="tab tap {{tabKey === item.key ? 'tab-active' : ''}}"
        data-key="{{item.key}}"
        bindtap="onTabTap">
        {{item.label}}
      </view>
    </view>
    <view class="basis">
      <view class="basis-item tap {{basis === 'nominal' ? 'basis-active' : ''}}" data-key="nominal" bindtap="onBasisTap">名义</view>
      <view class="basis-item tap {{basis === 'real' ? 'basis-active' : ''}}" data-key="real" bindtap="onBasisTap">真实</view>
    </view>
  </view>

  <!-- 图表容器 -->
  <view class="chart-wrap glass entry-up d2">
    <view class="empty" wx:if="{{!loading && !hasData}}">
      <view class="empty-orb"></view>
      <text class="empty-desc">暂无数据 · 先在首页添加账户并记录余额</text>
    </view>
    <ec-canvas
      id="chart"
      canvas-id="property-chart"
      ec="{{ ec }}"
      style="width: 100%; height: 100%; {{!hasData ? 'opacity: 0;' : ''}}">
    </ec-canvas>
  </view>

  <!-- 真实口径说明 -->
  <view class="basis-note entry-up" wx:if="{{basis === 'real' && hasData}}">
    <text>已按国家统计局 CPI 折算为今日购买力 · 截至 {{cpiLatest}}</text>
    <text wx:if="{{!realCoverage}}" class="basis-note-warn">含更早无 CPI 数据的区间，该段按名义显示</text>
  </view>

  <!-- 时间范围 Segmented Control -->
  <view class="ranges entry-up d3">
    <view
      wx:for="{{ranges}}"
      wx:key="key"
      class="range tap {{rangeKey === item.key ? 'range-active' : ''}}"
      data-key="{{item.key}}"
      bindtap="onRangeTap">
      {{item.label}}
    </view>
  </view>

  <!-- 自定义日期范围 -->
  <view class="custom-row entry-up d4" wx:if="{{rangeKey === 'custom'}}">
    <picker mode="date" value="{{customStart}}" end="{{customEnd}}" bindchange="onCustomStart">
      <view class="date-pick glass tap">起 · {{customStart}}</view>
    </picker>
    <picker mode="date" value="{{customEnd}}" start="{{customStart}}" bindchange="onCustomEnd">
      <view class="date-pick glass tap">止 · {{customEnd}}</view>
    </picker>
  </view>
</view>
