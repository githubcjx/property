<view class="canvas-bg theme-{{theme}}" wx:if="{{!reduceMotion}}"></view>

<view class="page {{reduceMotion ? 'no-motion' : ''}} theme-{{theme}}">
  <view class="chart-halo"></view>

  <!-- 透明导航栏 -->
  <view class="navbar" style="padding-top: {{statusBarHeight}}px;">
    <view class="nav-btn tap" hover-class="nav-btn-hover" bindtap="onBack">
      <view class="ic ic-xs ic-back"></view>
    </view>
    <text class="nav-title">回顾</text>
    <view class="nav-spacer"></view>
  </view>

  <!-- ============ 回顾中枢 ============
       V3.0：首页那个「四个镜头」的工具抽屉没了，四扇门合成一扇「回顾」，落在这里。
       三块摘要 —— 构成（横切）、目标（前方）、上月（回望），曲线（下方）是它们的底稿。
       每块只给摘要与一个去处，详情仍在各自的页面里，这里不重复实现任何计算。
       顺序：三块摘要在前，趋势曲线在最下面（曲线连同它的摘要/口径 Tab/时间区间是一整块，
       Tab 和区间在改的就是那条曲线和那段摘要，跟着它一起搬，不能拆开）。 -->
  <view class="hub" wx:if="{{hasData}}">

    <!-- 构成：环图摘要 → 资产配置页 -->
    <view wx:if="{{alloc}}" class="hub-card glass tap entry-up" hover-class="btn-hover" bindtap="onOpenInsights">
      <view class="hub-head">
        <text class="hub-title">资产构成</text>
        <view class="ic ic-xs ic-chevron-right hub-go"></view>
      </view>
      <view class="hub-alloc">
        <view class="hub-donut" style="background: {{alloc.conicGradient}};">
          <view class="hub-donut-hole"></view>
        </view>
        <view class="hub-legend">
          <view class="hub-leg-row" wx:for="{{alloc.rows}}" wx:key="id">
            <view class="hub-leg-dot cat-bg-{{item.colorClass}}"></view>
            <text class="hub-leg-name">{{item.name}}</text>
            <text class="hub-leg-pct cat-{{item.colorClass}} num">{{item.pctText}}%</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 前方：目标进度 → 净值目标页 -->
    <view class="hub-card glass tap entry-up d1" hover-class="btn-hover" bindtap="onOpenGoal">
      <block wx:if="{{goal.hasGoal}}">
        <view class="hub-head">
          <text class="hub-title">{{goal.name}}</text>
          <text class="hub-pct num">{{goal.pctText}}%</text>
        </view>
        <view class="hub-bar"><view class="hub-bar-fill" style="width: {{goal.pct}}%;"></view></view>
        <view class="hub-sub">
          <block wx:if="{{goal.achieved}}">已达成，去看看 →</block>
          <block wx:else>还差 {{hideAmount ? '••••' : goal.remainingText}} · 看预计达成时间 →</block>
        </view>
      </block>
      <block wx:else>
        <view class="hub-head">
          <text class="hub-title">净值目标</text>
          <view class="ic ic-xs ic-chevron-right hub-go"></view>
        </view>
        <view class="hub-sub">还没设目标 · 设一个，让曲线有个奔头 →</view>
      </block>
    </view>

    <!-- 回望：上月小结 → 月度小结页 -->
    <view class="hub-row glass tap entry-up d2" hover-class="btn-hover" bindtap="onOpenReport">
      <view class="hub-row-ico"><view class="ic ic-xs ic-report"></view></view>
      <view class="hub-row-txt">
        <view class="hub-row-t">{{prevMonthLabel}}小结</view>
        <view class="hub-row-s">看看上个月是谁在推动</view>
      </view>
      <view class="ic ic-xs ic-chevron-right hub-go"></view>
    </view>

  </view>

  <!-- ============ 趋势曲线（页面最下面）============ -->

  <!-- 文字摘要。通胀那句话长在这里，不再是一个「名义/真实」开关：
       开关在问「你想用哪种口径看」，可用户既不知道存在两种口径，也不知道该选哪个；
       而且真实序列的右端就是今天（两线在右侧收敛），30天/6月/年初至今三个区间按下去
       几乎什么都不会变 —— 一个按了没反应的开关比看不懂更糟。
       现在它是一句在该出现时自己出现的话，见 chart.js _inflationLine()。 -->
  <view class="summary glass entry-up d3" wx:if="{{summary.rangeText}}">
    <text class="sum-label">{{summary.rangeText}}</text>
    <view class="sum-lines">
      <text class="sum-line" wx:for="{{summary.lines}}" wx:key="*this">{{item}}</text>
    </view>
    <view wx:if="{{inflationLine}}" class="sum-infl">{{inflationLine}}</view>
  </view>

  <!-- Tab 切换 -->
  <view class="tabs-row entry-up d4">
    <view class="tabs">
      <view
        wx:for="{{tabs}}"
        wx:key="key"
        class="tab tap {{tabKey === item.key ? 'tab-active' : ''}}"
        data-key="{{item.key}}"
        bindtap="onTabTap">
        {{item.label}}
      </view>
    </view>
  </view>

  <!-- 图表容器 -->
  <view class="chart-wrap glass entry-up d5">
    <view class="empty" wx:if="{{!loading && !hasData}}">
      <view class="empty-orb"></view>
      <text class="empty-desc">暂无数据 · 先在首页添加账户并记录余额</text>
    </view>
    <ec-canvas
      id="chart"
      canvas-id="property-chart"
      ec="{{ ec }}"
      style="width: 100%; height: 100%; {{!hasData ? 'opacity: 0;' : ''}}">
    </ec-canvas>
  </view>

  <!-- 时间范围 Segmented Control -->
  <view class="ranges entry-up d6">
    <view
      wx:for="{{ranges}}"
      wx:key="key"
      class="range tap {{rangeKey === item.key ? 'range-active' : ''}}"
      data-key="{{item.key}}"
      bindtap="onRangeTap">
      {{item.label}}
    </view>
  </view>

  <!-- 这里【曾经】有一个「自定义」区间 + 两个日期选择器。删除，别加回来：
       这个 App 的数据一个月才产生一个点，一年 12 个点，
       「2024-03-17 到 2024-08-02」这种精度没有任何东西可切 —— 那是电子表格的条件反射。 -->
</view>
