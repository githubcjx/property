.page {
  min-height: 100vh;
  padding: 0 28rpx 64rpx;
  display: flex;
  flex-direction: column;
  position: relative;
  overflow: hidden;
}

/* ============ 透明 navbar ============ */
.navbar {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding-bottom: 14rpx;
  position: relative;
  z-index: 5;
}
.nav-title {
  font-size: 26rpx;
  color: var(--ink-80);
  font-weight: 500;
  letter-spacing: 0.04em;
}
.nav-btn {
  width: 56rpx; height: 56rpx;
  border-radius: 50%;
  background: var(--glass-1);
  border: 1rpx solid var(--hairline);
  display: flex; align-items: center; justify-content: center;
  -webkit-backdrop-filter: blur(20rpx);
  backdrop-filter: blur(20rpx);
}
.nav-btn-hover { background: var(--glass-3); transform: scale(0.95); }
.nav-spacer { width: 56rpx; }
.chart-halo {
  position: absolute;
  top: -80rpx; left: 50%;
  transform: translateX(-50%);
  width: 760rpx; height: 480rpx;
  background: radial-gradient(ellipse at center, rgba(var(--accent-rgb), 0.22), transparent 70%);
  filter: blur(56rpx);
  animation: pulse-glow 8s ease-in-out infinite;
  pointer-events: none;
  z-index: 0;
}

/* 摘要（曲线整块搬到页面最下面后，它接在中枢三块之后，需要自己的起手间距） */
.summary {
  position: relative;
  z-index: 1;
  margin-top: 32rpx;
  border-radius: 28rpx;
  padding: 28rpx 32rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}
.sum-label {
  font-size: 18rpx;
  color: var(--ink-40);
  letter-spacing: 0.18em;
  text-transform: uppercase;
}
.sum-lines {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}
.sum-line {
  font-size: 26rpx;
  color: var(--ink-100);
  line-height: 1.55;
}

/* Tab */
.tabs {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: row;
  gap: 12rpx;
  margin-top: 24rpx;
}
.tab {
  flex: 1;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 500;
  color: var(--ink-60);
  background: var(--glass-1);
  border: 1rpx solid var(--hairline);
  border-radius: 22rpx;
  transition: all 0.3s var(--ease-soft);
}
.tab-active {
  background: var(--glass-3);
  border-color: var(--hairline-hi);
  color: var(--ink-100);
  box-shadow: inset 0 2rpx 0 rgba(255,255,255,0.10), 0 0 32rpx rgba(var(--accent-rgb), 0.18);
}

/* 图表容器 */
.chart-wrap {
  position: relative;
  z-index: 1;
  width: 100%;
  height: 600rpx;
  margin-top: 18rpx;
  border-radius: 32rpx;
  padding: 16rpx 8rpx;
  overflow: hidden;
}
.empty {
  position: absolute;
  inset: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 24rpx;
  pointer-events: none;
}
.empty-orb {
  width: 120rpx; height: 120rpx;
  border-radius: 50%;
  background: radial-gradient(circle at 30% 30%, rgba(var(--accent-rgb), 0.6), rgba(var(--accent-rgb), 0.1) 70%);
  border: 1rpx solid rgba(var(--accent-rgb), 0.35);
  box-shadow: inset 0 4rpx 0 rgba(255,255,255,0.2), 0 0 48rpx rgba(var(--accent-rgb), 0.3);
  animation: pulse-glow 5s ease-in-out infinite;
}
.empty-desc {
  font-size: 22rpx;
  color: var(--ink-60);
  padding: 0 64rpx;
  text-align: center;
  letter-spacing: 0.05em;
}

/* Segmented Control */
.ranges {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: row;
  background: var(--glass-1);
  border: 1rpx solid var(--hairline);
  border-radius: 22rpx;
  padding: 6rpx;
  margin-top: 18rpx;
}
.range {
  flex: 1;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  color: var(--ink-60);
  border-radius: 16rpx;
  transition: all 0.25s var(--ease-soft);
}
.range-active {
  background: var(--glass-3);
  color: var(--ink-100);
  font-weight: 500;
  box-shadow: inset 0 2rpx 0 rgba(255,255,255,0.10);
}

/* Tab 行 */
.tabs-row {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 16rpx;
  margin-top: 24rpx;
}
.tabs-row .tabs { margin-top: 0; flex: 1; }

/* 通胀那一句：贴在摘要下面，比正文再轻一档 —— 它是补充口径，不是新结论。 */
.sum-infl {
  margin-top: 14rpx;
  padding-top: 14rpx;
  border-top: 1rpx solid var(--hairline);
  font-size: 21rpx;
  color: var(--ink-40);
  line-height: 1.5;
}

/* ============ 回顾中枢 ============
   曲线下方的三块摘要：构成 / 目标 / 上月。每块都是「一眼 + 一个去处」，
   刻意做得比曲线轻 —— 主角只有一个，它们是通往详情的路标，不是并列的第二张图表。 */
/* 本页原本没有通用按下态；中枢三块都要用，在这里补一条（与首页/盘点页同款手感） */
.btn-hover { opacity: 0.75; transform: scale(0.98); }

.hub {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  margin-top: 32rpx;
}
.hub-card {
  border-radius: 28rpx;
  padding: 26rpx 28rpx;
}
.hub-head {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.hub-title {
  flex: 1;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--ink-100);
  letter-spacing: 0.02em;
}
.hub-go { opacity: 0.45; }
.hub-pct {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--accent);
}

/* 构成：小环图 + 图例 */
.hub-alloc {
  display: flex;
  align-items: center;
  gap: 28rpx;
  margin-top: 22rpx;
}
.hub-donut {
  position: relative;
  width: 150rpx; height: 150rpx;
  border-radius: 50%;
  flex-shrink: 0;
}
.hub-donut-hole {
  position: absolute;
  inset: 30rpx;
  border-radius: 50%;
  background: var(--bg-1);
}
.hub-legend {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  min-width: 0;
}
.hub-leg-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.hub-leg-dot {
  width: 14rpx; height: 14rpx;
  border-radius: 50%;
  flex-shrink: 0;
}
.hub-leg-name {
  flex: 1;
  font-size: 24rpx;
  color: var(--ink-80);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.hub-leg-pct {
  font-size: 24rpx;
  font-weight: 600;
}

/* 目标：进度条 */
.hub-bar {
  height: 12rpx;
  border-radius: 6rpx;
  background: var(--glass-1);
  overflow: hidden;
  margin-top: 20rpx;
}
.hub-bar-fill {
  height: 100%;
  border-radius: 6rpx;
  background: linear-gradient(90deg, rgba(var(--accent-rgb), 0.55), var(--accent));
}
.hub-sub {
  margin-top: 16rpx;
  font-size: 22rpx;
  color: var(--ink-60);
  line-height: 1.5;
}

/* 上月小结：一行 */
.hub-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  border-radius: 24rpx;
  padding: 22rpx 26rpx;
}
.hub-row-ico {
  width: 60rpx; height: 60rpx;
  border-radius: 18rpx;
  background: var(--glass-1);
  border: 1rpx solid var(--hairline);
  display: flex; align-items: center; justify-content: center;
  flex-shrink: 0;
}
.hub-row-txt { flex: 1; min-width: 0; }
.hub-row-t {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--ink-100);
}
.hub-row-s {
  margin-top: 4rpx;
  font-size: 20rpx;
  color: var(--ink-40);
}
