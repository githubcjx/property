.page {
  min-height: 100vh;
  padding: 0 28rpx 64rpx;
  display: flex;
  flex-direction: column;
  position: relative;
  overflow: hidden;
}

/* ============ 透明 navbar ============ */
.navbar {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding-bottom: 14rpx;
  position: relative;
  z-index: 5;
}
.nav-title {
  font-size: 26rpx;
  color: var(--ink-80);
  font-weight: 500;
  letter-spacing: 0.04em;
}
.nav-btn {
  width: 56rpx; height: 56rpx;
  border-radius: 50%;
  background: var(--glass-1);
  border: 1rpx solid var(--hairline);
  display: flex; align-items: center; justify-content: center;
  -webkit-backdrop-filter: blur(20rpx);
  backdrop-filter: blur(20rpx);
}
.nav-btn-hover { background: var(--glass-3); transform: scale(0.95); }
.nav-spacer { width: 56rpx; }
.chart-halo {
  position: absolute;
  top: -80rpx; left: 50%;
  transform: translateX(-50%);
  width: 760rpx; height: 480rpx;
  background: radial-gradient(ellipse at center, rgba(var(--accent-rgb), 0.22), transparent 70%);
  filter: blur(56rpx);
  animation: pulse-glow 8s ease-in-out infinite;
  pointer-events: none;
  z-index: 0;
}

/* 摘要 */
.summary {
  position: relative;
  z-index: 1;
  border-radius: 28rpx;
  padding: 28rpx 32rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}
.sum-label {
  font-size: 18rpx;
  color: var(--ink-40);
  letter-spacing: 0.18em;
  text-transform: uppercase;
}
.sum-lines {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}
.sum-line {
  font-size: 26rpx;
  color: var(--ink-100);
  line-height: 1.55;
}

/* Tab */
.tabs {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: row;
  gap: 12rpx;
  margin-top: 24rpx;
}
.tab {
  flex: 1;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 500;
  color: var(--ink-60);
  background: var(--glass-1);
  border: 1rpx solid var(--hairline);
  border-radius: 22rpx;
  transition: all 0.3s var(--ease-soft);
}
.tab-active {
  background: var(--glass-3);
  border-color: var(--hairline-hi);
  color: var(--ink-100);
  box-shadow: inset 0 2rpx 0 rgba(255,255,255,0.10), 0 0 32rpx rgba(var(--accent-rgb), 0.18);
}

/* 图表容器 */
.chart-wrap {
  position: relative;
  z-index: 1;
  width: 100%;
  height: 600rpx;
  margin-top: 18rpx;
  border-radius: 32rpx;
  padding: 16rpx 8rpx;
  overflow: hidden;
}
.empty {
  position: absolute;
  inset: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 24rpx;
  pointer-events: none;
}
.empty-orb {
  width: 120rpx; height: 120rpx;
  border-radius: 50%;
  background: radial-gradient(circle at 30% 30%, rgba(var(--accent-rgb), 0.6), rgba(var(--accent-rgb), 0.1) 70%);
  border: 1rpx solid rgba(var(--accent-rgb), 0.35);
  box-shadow: inset 0 4rpx 0 rgba(255,255,255,0.2), 0 0 48rpx rgba(var(--accent-rgb), 0.3);
  animation: pulse-glow 5s ease-in-out infinite;
}
.empty-desc {
  font-size: 22rpx;
  color: var(--ink-60);
  padding: 0 64rpx;
  text-align: center;
  letter-spacing: 0.05em;
}

/* Segmented Control */
.ranges {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: row;
  background: var(--glass-1);
  border: 1rpx solid var(--hairline);
  border-radius: 22rpx;
  padding: 6rpx;
  margin-top: 18rpx;
}
.range {
  flex: 1;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  color: var(--ink-60);
  border-radius: 16rpx;
  transition: all 0.25s var(--ease-soft);
}
.range-active {
  background: var(--glass-3);
  color: var(--ink-100);
  font-weight: 500;
  box-shadow: inset 0 2rpx 0 rgba(255,255,255,0.10);
}

/* 自定义日期 */
.custom-row {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: row;
  gap: 16rpx;
  margin-top: 18rpx;
}
.date-pick {
  flex: 1;
  height: 88rpx;
  border-radius: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: var(--ink-100);
}

/* Tab 行 + 名义/真实 口径切换 */
.tabs-row {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 16rpx;
  margin-top: 24rpx;
}
.tabs-row .tabs { margin-top: 0; flex: 1; }
.basis {
  display: flex;
  flex-direction: row;
  background: var(--glass-1);
  border: 1rpx solid var(--hairline);
  border-radius: 18rpx;
  padding: 4rpx;
  flex-shrink: 0;
}
.basis-item {
  padding: 0 20rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  color: var(--ink-60);
  border-radius: 14rpx;
}
.basis-active {
  background: var(--glass-3);
  color: var(--ink-100);
  font-weight: 500;
  box-shadow: inset 0 2rpx 0 rgba(255,255,255,0.10);
}

/* 真实口径说明 */
.basis-note {
  position: relative;
  z-index: 1;
  margin-top: 14rpx;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  font-size: 20rpx;
  color: var(--ink-40);
  line-height: 1.5;
}
.basis-note-warn { color: var(--warn); }
