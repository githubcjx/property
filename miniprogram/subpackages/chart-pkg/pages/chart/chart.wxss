.page {
  min-height: 100vh;
  background-color: #000000;
  padding: 24rpx 32rpx 64rpx;
  display: flex;
  flex-direction: column;
}

/* 顶部摘要 */
.summary {
  background-color: #1C1C1E;
  border-radius: 24rpx;
  padding: 24rpx 28rpx;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}
.sum-range {
  font-size: 24rpx;
  color: rgba(235, 235, 245, 0.5);
}
.sum-line {
  font-size: 28rpx;
  color: #FFFFFF;
  line-height: 1.5;
}

/* Tab */
.tabs {
  display: flex;
  flex-direction: row;
  gap: 8rpx;
  background-color: rgba(255, 255, 255, 0.06);
  border-radius: 16rpx;
  padding: 4rpx;
  margin-top: 24rpx;
}
.tab {
  flex: 1;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  color: rgba(235, 235, 245, 0.6);
  border-radius: 12rpx;
}
.tab-active {
  background-color: #2C2C2E;
  color: #FFFFFF;
  font-weight: 500;
}

/* 图表容器 */
.chart-wrap {
  position: relative;
  width: 100%;
  height: 560rpx;
  margin-top: 16rpx;
  border-radius: 24rpx;
  overflow: hidden;
}
.empty {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  pointer-events: none;
}
.empty-emoji { font-size: 64rpx; }
.empty-desc {
  font-size: 26rpx;
  color: rgba(235, 235, 245, 0.5);
  padding: 0 64rpx;
  text-align: center;
}

/* Segmented Control */
.ranges {
  display: flex;
  flex-direction: row;
  background-color: rgba(255, 255, 255, 0.06);
  border-radius: 16rpx;
  padding: 4rpx;
  margin-top: 16rpx;
}
.range {
  flex: 1;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: rgba(235, 235, 245, 0.6);
  border-radius: 12rpx;
}
.range-active {
  background-color: #2C2C2E;
  color: #FFFFFF;
  font-weight: 500;
}

/* 自定义日期 */
.custom-row {
  display: flex;
  flex-direction: row;
  gap: 16rpx;
  margin-top: 16rpx;
}
.date-pick {
  flex: 1;
  height: 80rpx;
  background-color: #1C1C1E;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  color: #FFFFFF;
}
