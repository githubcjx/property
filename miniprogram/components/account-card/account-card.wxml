<view class="acc-card tap" bindtap="onTap">
  <view class="acc-icon">
    <view class="ic ic-{{iconKey}}" wx:if="{{iconKey}}"></view>
    <text wx:else>{{iconText}}</text>
  </view>
  <view class="acc-main">
    <view class="acc-row">
      <text class="acc-name">{{name}}</text>
      <text class="acc-amount" style="color: {{amountColor}};">{{amountText}}</text>
    </view>
    <view class="acc-row sub">
      <text class="acc-note">{{note || (excludedFromChart ? '不计入图表' : ' ')}}</text>
      <text class="acc-date">{{updatedText}}</text>
    </view>
  </view>
</view>
