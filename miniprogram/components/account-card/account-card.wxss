.acc-card {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 20rpx;
  padding: 20rpx 24rpx;
  background-color: rgba(255, 255, 255, 0.06);
  border-radius: 24rpx;
}
.acc-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background-color: rgba(255, 255, 255, 0.08);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 38rpx;
  flex-shrink: 0;
}
.acc-icon .ic { width: 36rpx; height: 36rpx; }
.acc-main {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  min-width: 0;
}
.acc-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}
.acc-row.sub {
  margin-top: 2rpx;
}
.acc-name {
  font-size: 30rpx;
  font-weight: 500;
  color: #FFFFFF;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.acc-amount {
  font-size: 30rpx;
  font-weight: 600;
  font-variant-numeric: tabular-nums;
  flex-shrink: 0;
}
.acc-note {
  font-size: 24rpx;
  color: rgba(235, 235, 245, 0.5);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  flex: 1;
}
.acc-date {
  font-size: 24rpx;
  color: rgba(235, 235, 245, 0.4);
  flex-shrink: 0;
}
