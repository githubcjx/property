.cat-header {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 8rpx 16rpx;
}
.left {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 16rpx;
  flex: 1;
  min-width: 0;
}
.dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  margin-right: 4rpx;
  flex-shrink: 0;
}
.cat-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.cat-icon .ic { width: 36rpx; height: 36rpx; }
.col {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  min-width: 0;
}
/* 覆盖 app.wxss 里 30% 太淡的 text-tertiary，组件内单独提亮 */
.col .text-tertiary {
  color: rgba(235, 235, 245, 0.5);
  font-size: 22rpx;
}
.right {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 12rpx;
  flex-shrink: 0;
}
.amount {
  font-size: 32rpx;
  font-weight: 600;
  font-variant-numeric: tabular-nums;
}
.chev {
  width: 32rpx;
  height: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: transform 0.22s ease;
  opacity: 0.5;
}
.chev-open {
  transform: rotate(180deg);
  opacity: 0.85;
}
