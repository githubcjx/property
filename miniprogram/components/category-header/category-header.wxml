<view class="cat-header tap" bindtap="onTap">
  <view class="left">
    <view class="cat-icon {{tintClass}}">
      <view class="ic ic-{{iconKey}}" wx:if="{{iconKey}}"></view>
    </view>
    <view class="col">
      <text class="title-sm">{{name}}</text>
      <text class="text-tertiary" wx:if="{{lastUpdatedText}}">{{lastUpdatedText}}</text>
    </view>
  </view>
  <view class="right">
    <text class="amount" style="color: {{color}};">{{amountText}}</text>
    <view class="chev {{expanded ? 'chev-open' : ''}}">
      <view class="ic ic-sm ic-chevron-down"></view>
    </view>
  </view>
</view>
