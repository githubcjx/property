.ai-mask {
  position: fixed;
  inset: 0;
  z-index: 1000;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  background: rgba(5, 6, 10, 0.6);
  -webkit-backdrop-filter: blur(14rpx) saturate(120%);
  backdrop-filter: blur(14rpx) saturate(120%);
}
.ai-mask-in  { animation: fade-in  0.30s var(--ease-soft) forwards; }
.ai-mask-out { animation: fade-out 0.24s var(--ease-soft) forwards; }

.ai-sheet {
  background: linear-gradient(180deg, rgba(15, 17, 23, 0.88), rgba(8, 9, 12, 0.96));
  border-top-left-radius: 40rpx;
  border-top-right-radius: 40rpx;
  border-top: 1rpx solid var(--hairline-hi);
  padding: 16rpx 28rpx 36rpx;
  padding-bottom: calc(36rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -40rpx 80rpx rgba(0,0,0,0.5), inset 0 2rpx 0 rgba(255,255,255,0.1);
}
.ai-sheet-in  { animation: drawer-up   0.55s var(--ease-spring) forwards; }
.ai-sheet-out { animation: drawer-down 0.26s var(--ease-organic) forwards; }

.ai-handle {
  width: 56rpx; height: 6rpx;
  background: rgba(255,255,255,0.22);
  border-radius: 4rpx;
  margin: 0 auto 18rpx;
}

.ai-head {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding: 0 4rpx 12rpx;
}
.ai-title {
  font-size: 28rpx;
  color: var(--ink-100);
  font-weight: 500;
}
.ai-cancel {
  font-size: 26rpx;
  color: var(--ink-60);
  padding: 8rpx 4rpx;
}
.ai-confirm {
  font-size: 26rpx;
  font-weight: 600;
  padding: 8rpx 4rpx;
}

.ai-acc {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 18rpx;
  padding: 14rpx 18rpx;
  background: var(--glass-1);
  border: 1rpx solid var(--hairline);
  border-radius: 22rpx;
  margin-bottom: 18rpx;
}
.ai-acc-icon {
  width: 56rpx; height: 56rpx;
  border-radius: 18rpx;
  display: flex; align-items: center; justify-content: center;
}
.ai-acc-icon .ic { width: 32rpx; height: 32rpx; }
.ai-acc-meta {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}
.ai-acc-name {
  font-size: 26rpx;
  color: var(--ink-100);
  font-weight: 500;
}
.ai-acc-bal {
  font-size: 20rpx;
  color: var(--ink-40);
}

.ai-amount {
  display: flex;
  align-items: baseline;
  justify-content: center;
  gap: 10rpx;
  padding: 14rpx 0 18rpx;
  font-weight: 200;
  font-variant-numeric: tabular-nums;
}
.ai-amount-sign {
  font-size: 56rpx;
  margin-right: 6rpx;
}
.ai-amount-cny {
  font-size: 44rpx;
  opacity: 0.55;
}
.ai-amount-num {
  font-size: 96rpx;
  letter-spacing: -2rpx;
}
.ai-amount-caret {
  display: inline-block;
  width: 4rpx;
  height: 64rpx;
  margin-left: 6rpx;
  border-radius: 2rpx;
  animation: blink 1s steps(2) infinite;
}

.ai-sign-tabs {
  display: flex;
  flex-direction: row;
  gap: 12rpx;
  margin-bottom: 14rpx;
}
.ai-sign-tab {
  flex: 1;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  font-size: 26rpx;
  font-weight: 500;
  color: var(--ink-60);
  background: var(--glass-1);
  border: 1rpx solid var(--hairline);
  border-radius: 22rpx;
  transition: all 0.3s var(--ease-spring);
}
.ai-sign-tab.active.pos {
  background: rgba(var(--accent-rgb), 0.18);
  border-color: rgba(var(--accent-rgb), 0.55);
  color: var(--ice-blue);
  box-shadow: 0 0 28rpx rgba(var(--accent-rgb), 0.25), inset 0 2rpx 0 rgba(var(--accent-rgb), 0.3);
}
.ai-sign-tab.active.neg {
  background: rgba(255, 179, 179, 0.16);
  border-color: rgba(255, 179, 179, 0.5);
  color: var(--debt);
  box-shadow: 0 0 28rpx rgba(255, 179, 179, 0.22), inset 0 2rpx 0 rgba(255, 179, 179, 0.3);
}

.ai-note-wrap {
  margin-bottom: 16rpx;
  background: var(--glass-1);
  border: 1rpx solid var(--hairline);
  border-radius: 22rpx;
  padding: 20rpx 24rpx;
}
.ai-note {
  width: 100%;
  font-size: 26rpx;
  color: var(--ink-100);
}
.ai-note-ph { color: var(--ink-40); }

.ai-keys {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 14rpx;
}
.ai-key {
  height: 104rpx;
  background: var(--glass-2);
  border: 1rpx solid var(--hairline);
  border-radius: 24rpx;
  display: flex; align-items: center; justify-content: center;
  font-size: 38rpx;
  font-weight: 400;
  color: var(--ink-100);
  box-shadow: inset 0 2rpx 0 rgba(255,255,255,0.08);
  position: relative;
}
.ai-key-back { background: var(--glass-1); }
.ai-key-press {
  transform: scale(0.94);
  background: var(--glass-3);
  box-shadow: inset 0 0 0 2rpx rgba(var(--accent-rgb), 0.4), inset 0 4rpx 12rpx rgba(0,0,0,0.4);
}
