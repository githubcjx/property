// 在 WXML 中拼装输入展示
function display(raw, sign) {
  if (!raw) {
    return sign < 0 ? '-0' : '0'
  }
  var prefix = sign < 0 ? '-' : ''
  return prefix + raw
}

// 把分转成「¥xx,xxx」（用于「当前余额」展示，四舍五入到元）
function fenToCNY(fen) {
  if (fen === null || fen === undefined) return '¥0'
  var n = fen / 100
  var neg = n < 0
  n = neg ? -n : n
  var rounded = Math.round(n).toString()
  var s = ''
  var i = rounded.length
  while (i > 3) {
    s = ',' + rounded.substring(i - 3, i) + s
    i -= 3
  }
  s = rounded.substring(0, i) + s
  return (neg ? '-¥' : '¥') + s
}

module.exports = {
  display: display,
  fenToCNY: fenToCNY,
}
