/* ============================================================
   主题 · Theme overrides
   机制：每套主题 = 一组 CSS 变量覆盖。页面根节点(.page)与 .canvas-bg 上挂
   class="theme-{{theme}}"，变量级联到全部子元素。默认主题(aurora)即 page 基色，
   无需 class。所有白色玻璃叠加在深色底上继续有效，只切换强调色 / 类别色 / 星云色。
   --debt / --neg 在所有主题保持红色（财务「负向」语义）。
   ============================================================ */
.theme-gilded {
  --bg-0: #0a0805; --bg-1: #0e0b07; --bg-2: #14100a;
  --ink-100: #fbf6ec;
  --ink-80: rgba(251, 246, 236, 0.78);
  --ink-60: rgba(251, 246, 236, 0.55);
  --ink-40: rgba(251, 246, 236, 0.36);
  --ink-20: rgba(251, 246, 236, 0.18);
  --ice-blue: #f3dfa3; --accent: #f3dfa3; --accent-2: #e8b96a;
  --accent-rgb: 243, 223, 163;
  --liquid: #f3dfa3;     --liquid-rgb: 243, 223, 163;
  --investment: #e8c98a; --investment-rgb: 232, 201, 138;
  --fixed: #d9b38c;      --fixed-rgb: 217, 179, 140;
  --receivable: #f7ecd2; --receivable-rgb: 247, 236, 210;
  --pos: #f3dfa3;
  --neb-1: rgba(243, 223, 163, 0.13);
  --neb-2: rgba(232, 185, 106, 0.08);
}
.theme-neon {
  --bg-0: #05060a; --bg-1: #080910; --bg-2: #0d0f1a;
  --ink-100: #f5f0ff;
  --ink-80: rgba(245, 240, 255, 0.78);
  --ink-60: rgba(245, 240, 255, 0.55);
  --ink-40: rgba(245, 240, 255, 0.36);
  --ink-20: rgba(245, 240, 255, 0.18);
  --ice-blue: #5ee7ff; --accent: #5ee7ff; --accent-2: #ff6ec7;
  --accent-rgb: 94, 231, 255;
  --liquid: #5ee7ff;     --liquid-rgb: 94, 231, 255;
  --investment: #ff6ec7; --investment-rgb: 255, 110, 199;
  --fixed: #a78bfa;      --fixed-rgb: 167, 139, 250;
  --receivable: #c9f7ff; --receivable-rgb: 201, 247, 255;
  --pos: #5ee7ff;
  --neb-1: rgba(255, 110, 199, 0.16);
  --neb-2: rgba(94, 231, 255, 0.12);
}
.theme-emerald {
  --bg-0: #040806; --bg-1: #060c09; --bg-2: #0a1410;
  --ink-100: #eefbf4;
  --ink-80: rgba(238, 251, 244, 0.78);
  --ink-60: rgba(238, 251, 244, 0.55);
  --ink-40: rgba(238, 251, 244, 0.36);
  --ink-20: rgba(238, 251, 244, 0.18);
  --ice-blue: #6ee7b7; --accent: #6ee7b7; --accent-2: #a3e635;
  --accent-rgb: 110, 231, 183;
  --liquid: #6ee7b7;     --liquid-rgb: 110, 231, 183;
  --investment: #a3e635; --investment-rgb: 163, 230, 53;
  --fixed: #5eead4;      --fixed-rgb: 94, 234, 212;
  --receivable: #ecfccb; --receivable-rgb: 236, 252, 203;
  --pos: #6ee7b7;
  --neb-1: rgba(110, 231, 183, 0.14);
  --neb-2: rgba(163, 230, 53, 0.08);
}
.theme-twilight {
  --bg-0: #0a0710; --bg-1: #0e0a16; --bg-2: #161020;
  --ink-100: #f6f0ff;
  --ink-80: rgba(246, 240, 255, 0.78);
  --ink-60: rgba(246, 240, 255, 0.55);
  --ink-40: rgba(246, 240, 255, 0.36);
  --ink-20: rgba(246, 240, 255, 0.18);
  --ice-blue: #c4a3ff; --accent: #c4a3ff; --accent-2: #ff9ec4;
  --accent-rgb: 196, 163, 255;
  --liquid: #c4a3ff;     --liquid-rgb: 196, 163, 255;
  --investment: #ff9ec4; --investment-rgb: 255, 158, 196;
  --fixed: #a3c4ff;      --fixed-rgb: 163, 196, 255;
  --receivable: #f0e6ff; --receivable-rgb: 240, 230, 255;
  --pos: #c4a3ff;
  --neb-1: rgba(196, 163, 255, 0.15);
  --neb-2: rgba(255, 158, 196, 0.09);
}
.theme-obsidian {
  --bg-0: #000000; --bg-1: #070708; --bg-2: #0e0e10;
  --ink-100: #f5f6f8;
  --ink-80: rgba(245, 246, 248, 0.78);
  --ink-60: rgba(245, 246, 248, 0.55);
  --ink-40: rgba(245, 246, 248, 0.36);
  --ink-20: rgba(245, 246, 248, 0.18);
  --ice-blue: #e8eaed; --accent: #e8eaed; --accent-2: #b8bcc4;
  --accent-rgb: 232, 234, 237;
  --liquid: #e8eaed;     --liquid-rgb: 232, 234, 237;
  --investment: #b8bcc4; --investment-rgb: 184, 188, 196;
  --fixed: #9aa0aa;      --fixed-rgb: 154, 160, 170;
  --receivable: #f5f6f8; --receivable-rgb: 245, 246, 248;
  --pos: #e8eaed;
  --neb-1: rgba(232, 234, 237, 0.08);
  --neb-2: rgba(184, 188, 196, 0.05);
}
