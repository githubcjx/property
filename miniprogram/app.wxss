/* ============================================================
   净值本 · 冰玻璃 (Vision Pro inspired)
   black + ice-blue + cool-white · multi-layer glass · liquid edges
   ============================================================ */

page {
  /* —— Surfaces —— */
  --bg-0: #050507;
  --bg-1: #08090c;
  --bg-2: #0c0d12;

  --glass-0: rgba(255, 255, 255, 0.025);
  --glass-1: rgba(255, 255, 255, 0.05);
  --glass-2: rgba(255, 255, 255, 0.08);
  --glass-3: rgba(255, 255, 255, 0.12);

  --hairline: rgba(255, 255, 255, 0.08);
  --hairline-hi: rgba(255, 255, 255, 0.16);

  /* —— Ink —— */
  --ink-100: #f5f8ff;
  --ink-80:  rgba(245, 248, 255, 0.78);
  --ink-60:  rgba(245, 248, 255, 0.55);
  --ink-40:  rgba(245, 248, 255, 0.36);
  --ink-20:  rgba(245, 248, 255, 0.18);

  /* legacy aliases for compatibility */
  --bg: var(--bg-1);
  --bg-elev: var(--bg-2);
  --card: var(--glass-2);
  --card-2: var(--glass-3);
  --line: var(--hairline);
  --text: var(--ink-100);
  --text-2: var(--ink-80);
  --text-3: var(--ink-60);
  --text-4: var(--ink-40);

  /* —— Cool palette (categories tinted but cool) —— */
  --ice-blue:   #a7d3ff;
  --liquid:     #a7d3ff;
  --investment: #c8b5ff;
  --fixed:      #b7e8f0;
  --receivable: #e0eaff;
  --debt:       #ffb3b3;

  --liquid-rgb:     167, 211, 255;
  --investment-rgb: 200, 181, 255;
  --fixed-rgb:      183, 232, 240;
  --receivable-rgb: 224, 234, 255;
  --debt-rgb:       255, 179, 179;

  --pos: #a7d3ff;
  --neg: #ffb3b3;

  --accent: var(--ice-blue);
  --accent-2: var(--investment);
  --accent-rgb: 167, 211, 255;

  /* —— Nebula tints (page-level background, overridden per theme) —— */
  --neb-1: rgba(167, 211, 255, 0.14);
  --neb-2: rgba(200, 181, 255, 0.09);

  /* —— Motion easing —— */
  --ease-spring: cubic-bezier(0.34, 1.56, 0.64, 1);
  --ease-soft:   cubic-bezier(0.25, 1, 0.5, 1);
  --ease-organic: cubic-bezier(0.4, 0.0, 0.2, 1);

  background-color: var(--bg-0);
  color: var(--ink-100);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", system-ui, sans-serif;
  font-size: 28rpx;
  line-height: 1.4;
  min-height: 100vh;
}

view, text { box-sizing: border-box; }

/* —— Tabular numerals utility —— */
.num {
  font-variant-numeric: tabular-nums;
  font-feature-settings: 'tnum' on;
  letter-spacing: -0.02em;
}

/* ============================================================
   Page-level cool nebula background
   ============================================================ */
.canvas-bg {
  position: fixed;
  inset: 0;
  z-index: -1;
  pointer-events: none;
  background:
    radial-gradient(ellipse 80% 50% at 50% 0%, var(--neb-1), transparent 60%),
    radial-gradient(ellipse 50% 40% at 100% 100%, var(--neb-2), transparent 60%),
    linear-gradient(180deg, var(--bg-1) 0%, var(--bg-0) 100%);
  overflow: hidden;
}
.canvas-bg::before {
  content: '';
  position: absolute;
  inset: -20%;
  background:
    radial-gradient(ellipse 30% 25% at 28% 30%, var(--neb-1), transparent 65%),
    radial-gradient(ellipse 35% 28% at 72% 65%, var(--neb-2), transparent 65%),
    radial-gradient(ellipse 25% 20% at 80% 20%, rgba(var(--fixed-rgb), 0.07), transparent 60%);
  /* 性能:背景保持静态。原 drift 无限动画会让全屏 blur(48rpx) 层每帧重新栅格化,
     并强制其上方所有 backdrop-filter 持续重绘 —— 这是「打开几分钟后发烫」的主因。 */
  filter: blur(48rpx);
}
.canvas-bg::after {
  content: '';
  position: absolute; inset: 0;
  background-image:
    radial-gradient(2rpx 2rpx at 14% 22%, rgba(255,255,255,0.45), transparent 60%),
    radial-gradient(2rpx 2rpx at 38% 70%, rgba(255,255,255,0.30), transparent 60%),
    radial-gradient(2rpx 2rpx at 67% 12%, rgba(255,255,255,0.40), transparent 60%),
    radial-gradient(2rpx 2rpx at 82% 80%, rgba(255,255,255,0.30), transparent 60%),
    radial-gradient(3rpx 3rpx at 22% 88%, rgba(var(--accent-rgb),0.40), transparent 60%),
    radial-gradient(3rpx 3rpx at 90% 40%, rgba(var(--investment-rgb),0.30), transparent 60%);
  opacity: 0.7;
}

/* ============================================================
   Glass surface utility
   ============================================================ */
.glass {
  background: var(--glass-1);
  -webkit-backdrop-filter: blur(28rpx) saturate(160%);
  backdrop-filter: blur(28rpx) saturate(160%);
  border: 1rpx solid var(--hairline);
  box-shadow:
    inset 0 2rpx 0 rgba(255, 255, 255, 0.08),
    0 24rpx 72rpx rgba(0, 0, 0, 0.45);
  position: relative;
}

.glass-2 {
  background: var(--glass-2);
  -webkit-backdrop-filter: blur(28rpx) saturate(160%);
  backdrop-filter: blur(28rpx) saturate(160%);
  border: 1rpx solid var(--hairline-hi);
  box-shadow:
    inset 0 2rpx 0 rgba(255, 255, 255, 0.10),
    0 24rpx 72rpx rgba(0, 0, 0, 0.4);
}

/* ============================================================
   Legacy layout utilities (kept for compatibility)
   ============================================================ */
.container { padding: 32rpx; padding-top: 24rpx; }

.card {
  background: var(--glass-1);
  border: 1rpx solid var(--hairline);
  border-radius: 32rpx;
  padding: 28rpx 32rpx;
}
.card-sub {
  background: var(--glass-2);
  border-radius: 24rpx;
  padding: 24rpx 28rpx;
}

.title-lg { font-size: 64rpx; font-weight: 200; letter-spacing: -1rpx; }
.title-md { font-size: 36rpx; font-weight: 500; }
.title-sm { font-size: 32rpx; font-weight: 500; color: var(--ink-100); }
.text-secondary { color: var(--ink-60); font-size: 26rpx; }
.text-tertiary  { color: var(--ink-40); font-size: 24rpx; }

.row { display: flex; flex-direction: row; align-items: center; }
.row-between { display: flex; flex-direction: row; align-items: center; justify-content: space-between; }
.col { display: flex; flex-direction: column; }
.gap-8 { gap: 8rpx; }
.gap-12 { gap: 12rpx; }
.gap-16 { gap: 16rpx; }
.gap-24 { gap: 24rpx; }
.gap-32 { gap: 32rpx; }

.amount-pos { color: var(--pos); }
.amount-neg { color: var(--neg); }

.cat-liquid     { color: var(--liquid); }
.cat-investment { color: var(--investment); }
.cat-fixed      { color: var(--fixed); }
.cat-receivable { color: var(--receivable); }
.cat-debt       { color: var(--debt); }

.cat-bg-liquid     { background-color: var(--liquid); }
.cat-bg-investment { background-color: var(--investment); }
.cat-bg-fixed      { background-color: var(--fixed); }
.cat-bg-receivable { background-color: var(--receivable); }
.cat-bg-debt       { background-color: var(--debt); }

/* Category "orb" radial backgrounds */
.cat-tint-liquid     { background: radial-gradient(circle at 30% 30%, rgba(var(--liquid-rgb), 0.6), rgba(var(--liquid-rgb), 0.12) 70%); border: 1rpx solid rgba(var(--liquid-rgb), 0.4); box-shadow: inset 0 2rpx 0 rgba(255,255,255,0.18), 0 0 32rpx rgba(var(--liquid-rgb), 0.25); }
.cat-tint-investment { background: radial-gradient(circle at 30% 30%, rgba(var(--investment-rgb), 0.6), rgba(var(--investment-rgb), 0.12) 70%); border: 1rpx solid rgba(var(--investment-rgb), 0.4); box-shadow: inset 0 2rpx 0 rgba(255,255,255,0.18), 0 0 32rpx rgba(var(--investment-rgb), 0.25); }
.cat-tint-fixed      { background: radial-gradient(circle at 30% 30%, rgba(var(--fixed-rgb), 0.6), rgba(var(--fixed-rgb), 0.12) 70%); border: 1rpx solid rgba(var(--fixed-rgb), 0.4); box-shadow: inset 0 2rpx 0 rgba(255,255,255,0.18), 0 0 32rpx rgba(var(--fixed-rgb), 0.25); }
.cat-tint-receivable { background: radial-gradient(circle at 30% 30%, rgba(var(--receivable-rgb), 0.6), rgba(var(--receivable-rgb), 0.12) 70%); border: 1rpx solid rgba(var(--receivable-rgb), 0.4); box-shadow: inset 0 2rpx 0 rgba(255,255,255,0.18), 0 0 32rpx rgba(var(--receivable-rgb), 0.25); }
.cat-tint-debt       { background: radial-gradient(circle at 30% 30%, rgba(var(--debt-rgb), 0.6), rgba(var(--debt-rgb), 0.12) 70%); border: 1rpx solid rgba(var(--debt-rgb), 0.4); box-shadow: inset 0 2rpx 0 rgba(255,255,255,0.18), 0 0 32rpx rgba(var(--debt-rgb), 0.25); }

/* Soft halo for each category (used in detail) */
.halo-liquid     { background: radial-gradient(circle, rgba(var(--liquid-rgb), 0.30),     transparent 70%); }
.halo-investment { background: radial-gradient(circle, rgba(var(--investment-rgb), 0.30), transparent 70%); }
.halo-fixed      { background: radial-gradient(circle, rgba(var(--fixed-rgb), 0.30),      transparent 70%); }
.halo-receivable { background: radial-gradient(circle, rgba(var(--receivable-rgb), 0.30), transparent 70%); }
.halo-debt       { background: radial-gradient(circle, rgba(var(--debt-rgb), 0.30),       transparent 70%); }

/* Buttons */
.btn {
  display: flex; align-items: center; justify-content: center;
  height: 96rpx; border-radius: 48rpx;
  font-size: 30rpx; font-weight: 500; padding: 0 36rpx; line-height: 1;
  position: relative; overflow: hidden;
}
.btn-primary {
  background: linear-gradient(135deg, var(--ice-blue), rgba(var(--accent-rgb), 0.55));
  color: #0a0d12;
  box-shadow: 0 16rpx 40rpx rgba(var(--accent-rgb), 0.35), inset 0 2rpx 0 rgba(255,255,255,0.5);
}
.btn-dark {
  background: var(--glass-2);
  color: var(--ink-100);
  border: 1rpx solid var(--hairline-hi);
  box-shadow: inset 0 2rpx 0 rgba(255,255,255,0.10);
}
.btn-ghost {
  background: var(--glass-1);
  color: var(--ink-100);
  border: 1rpx solid var(--hairline-hi);
}
.btn-block { width: 100%; }

button.btn-reset {
  background: transparent; padding: 0; margin: 0;
  line-height: inherit; font-size: inherit; color: inherit; border: none;
}
button.btn-reset::after { display: none; }

.divider { height: 1rpx; background: var(--hairline); margin: 16rpx 0; }

.empty { padding: 120rpx 64rpx; text-align: center; color: var(--ink-60); }
.empty-emoji { font-size: 96rpx; margin-bottom: 24rpx; display: block; }

/* tap feedback */
.tap { transition: opacity 0.15s, transform 0.15s; }
.tap:active { opacity: 0.85; transform: scale(0.97); }

/* ============================================================
   Reduce-motion 模式（设置页开关控制）
   挂载方式：在页面根 view / 组件根上加 class="no-motion"
   目标：降低 GPU 占用，缓解发热（移除 backdrop-filter 与无限动画）
   ============================================================ */
.no-motion .glass,
.no-motion .glass-2,
.no-motion.ai-mask,
.no-motion .ai-mask,
.no-motion .ai-sheet {
  -webkit-backdrop-filter: none !important;
  backdrop-filter: none !important;
}
.no-motion .glass,
.no-motion .glass-2 { background: var(--bg-2); }
.no-motion.ai-mask { background: rgba(5, 6, 10, 0.78); }
.no-motion .canvas-bg::before {
  animation: none !important;
  filter: none !important;
  opacity: 0.4;
}
.no-motion .canvas-bg::after { opacity: 0.3; }
.no-motion .tap:active { transform: none; }
/* 把所有动画压缩为 0.01s 单次：
   - infinite 动画跑一次就停，不再占 GPU
   - 「opacity: 0 + animation forwards」的揭示动画会瞬间跳到终态，
     避免元素永久不可见 */
.no-motion view,
.no-motion image,
.no-motion text,
.no-motion button,
.no-motion scroll-view,
.no-motion switch,
.no-motion canvas {
  animation-duration: 0.01s !important;
  animation-iteration-count: 1 !important;
  animation-delay: 0s !important;
}

/* ============================================================
   Keyframes
   ============================================================ */
@keyframes drift {
  0%   { transform: translate(0,0)    rotate(0deg);   }
  50%  { transform: translate(-3%,2%) rotate(2deg);   }
  100% { transform: translate(2%,-3%) rotate(-2deg);  }
}
@keyframes drift-icon {
  0%, 100% { transform: translateY(0) rotate(0deg); }
  50%      { transform: translateY(-3rpx) rotate(1deg); }
}
/* 性能:pulse-glow 全部用于装饰光晕/光球。原先动 scale,而这些元素多带 filter: blur(),
   缩放会让模糊层每帧重算 —— 改为只呼吸 opacity(合成层廉价),所有页面的光晕一次性受益。
   附带修复:原 scale 会覆盖元素用于居中的 translate,去掉后居中不再被打断。 */
@keyframes pulse-glow {
  0%, 100% { opacity: 0.5; }
  50%      { opacity: 0.95; }
}
@keyframes shine-sweep {
  0%   { transform: translateX(-150%) skewX(-20deg); opacity: 0; }
  20%  { opacity: 1; }
  100% { transform: translateX(220%)  skewX(-20deg); opacity: 0; }
}
@keyframes ripple-out {
  0%   { transform: scale(0);   opacity: 0.6; }
  100% { transform: scale(3.5); opacity: 0; }
}
@keyframes float-up {
  0%   { opacity: 0; transform: translateY(16rpx); }
  100% { opacity: 1; transform: translateY(0); }
}
@keyframes fade-in  { from { opacity: 0; } to { opacity: 1; } }
@keyframes fade-out { from { opacity: 1; } to { opacity: 0; } }
@keyframes wobble {
  0%   { transform: scale(1, 1); }
  30%  { transform: scale(1.04, 0.96); }
  60%  { transform: scale(0.98, 1.02); }
  100% { transform: scale(1, 1); }
}
@keyframes drawer-up {
  0%   { transform: translateY(105%); }
  65%  { transform: translateY(-1.5%); }
  100% { transform: translateY(0); }
}
@keyframes drawer-down { to { transform: translateY(105%); } }
@keyframes spin-slow   { to { transform: rotate(360deg); } }
@keyframes draw-line   { to { stroke-dashoffset: 0; } }
@keyframes blink       { 50% { opacity: 0; } }
@keyframes shatter-fly {
  0%   { opacity: 0; transform: translate(-50%, -50%) scale(0.4) rotate(0deg); }
  15%  { opacity: 1; }
  100% { opacity: 0; transform: translate(calc(-50% + var(--tx, 0rpx)), calc(-50% + var(--ty, 0rpx))) rotate(var(--rot, 0deg)) scale(1); }
}
@keyframes count-flicker { 0%, 100% { filter: brightness(1); } 50% { filter: brightness(1.25); } }
@keyframes glow-soft     { 0%, 100% { opacity: 0.55; } 50% { opacity: 0.9; } }

/* Entry animations (re-render safe with `forwards`) */
.entry-up   { animation: float-up 0.7s var(--ease-soft) both; }
.entry-up.d1 { animation-delay: 0.06s; }
.entry-up.d2 { animation-delay: 0.14s; }
.entry-up.d3 { animation-delay: 0.22s; }
.entry-up.d4 { animation-delay: 0.30s; }
.entry-up.d5 { animation-delay: 0.38s; }
.entry-up.d6 { animation-delay: 0.46s; }
.entry-up.d7 { animation-delay: 0.54s; }

.drift-slow { animation: drift-icon 6s ease-in-out infinite; }

/* ============================================================
   Line icon system (inline data-URI SVGs)
   ============================================================ */
.ic {
  width: 40rpx; height: 40rpx;
  background-size: contain; background-position: center; background-repeat: no-repeat;
  display: inline-block; flex-shrink: 0;
}
.ic-sm { width: 32rpx; height: 32rpx; }
.ic-lg { width: 56rpx; height: 56rpx; }
.ic-xs { width: 24rpx; height: 24rpx; }

