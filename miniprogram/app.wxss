/* 全局深色主题 */
page {
  --bg: #000000;
  --bg-elev: #1C1C1E;
  --card: #2C2C2E;
  --card-2: #3A3A3C;
  --line: rgba(255, 255, 255, 0.08);
  --text: #FFFFFF;
  --text-2: #EBEBF5;
  --text-3: rgba(235, 235, 245, 0.6);
  --text-4: rgba(235, 235, 245, 0.3);

  --liquid: #34D399;
  --investment: #A78BFA;
  --fixed: #FBBF24;
  --receivable: #60A5FA;
  --debt: #F87171;

  --pos: #34D399;
  --neg: #F87171;

  background-color: var(--bg);
  color: var(--text);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", Helvetica, Arial, sans-serif;
  font-size: 28rpx;
  line-height: 1.4;
  min-height: 100vh;
}

view, text {
  box-sizing: border-box;
}

.container {
  padding: 32rpx;
  padding-top: 24rpx;
}

/* 卡片 */
.card {
  background-color: var(--card);
  border-radius: 32rpx;
  padding: 28rpx 32rpx;
}

.card-sub {
  background-color: var(--card-2);
  border-radius: 24rpx;
  padding: 24rpx 28rpx;
}

/* 文字层级 */
.title-lg {
  font-size: 64rpx;
  font-weight: 600;
  letter-spacing: -1rpx;
}

.title-md {
  font-size: 36rpx;
  font-weight: 600;
}

.title-sm {
  font-size: 32rpx;
  font-weight: 500;
}

.text-secondary {
  color: var(--text-3);
  font-size: 26rpx;
}

.text-tertiary {
  color: var(--text-4);
  font-size: 24rpx;
}

/* 行 / 列 / 间距 */
.row {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.row-between {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
}

.col {
  display: flex;
  flex-direction: column;
}

.gap-8 { gap: 8rpx; }
.gap-12 { gap: 12rpx; }
.gap-16 { gap: 16rpx; }
.gap-24 { gap: 24rpx; }
.gap-32 { gap: 32rpx; }

/* 金额颜色 */
.amount-pos { color: var(--pos); }
.amount-neg { color: var(--neg); }

/* 大类色 */
.cat-liquid { color: var(--liquid); }
.cat-investment { color: var(--investment); }
.cat-fixed { color: var(--fixed); }
.cat-receivable { color: var(--receivable); }
.cat-debt { color: var(--debt); }

.cat-bg-liquid { background-color: var(--liquid); }
.cat-bg-investment { background-color: var(--investment); }
.cat-bg-fixed { background-color: var(--fixed); }
.cat-bg-receivable { background-color: var(--receivable); }
.cat-bg-debt { background-color: var(--debt); }

/* 大类图标背景：低饱和度 tint，与图标的白色线条形成对比 */
.cat-tint-liquid     { background-color: rgba(52, 211, 153, 0.18); }
.cat-tint-investment { background-color: rgba(167, 139, 250, 0.18); }
.cat-tint-fixed      { background-color: rgba(251, 191, 36, 0.18); }
.cat-tint-receivable { background-color: rgba(96, 165, 250, 0.18); }
.cat-tint-debt       { background-color: rgba(248, 113, 113, 0.18); }

/* 按钮 */
.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  border-radius: 44rpx;
  font-size: 30rpx;
  font-weight: 500;
  padding: 0 36rpx;
  line-height: 1;
}

.btn-primary {
  background-color: #FFFFFF;
  color: #000000;
}

.btn-dark {
  background-color: #1C1C1E;
  color: #FFFFFF;
  border: 1rpx solid rgba(255, 255, 255, 0.18);
}

.btn-ghost {
  background-color: transparent;
  color: #FFFFFF;
  border: 1rpx solid rgba(255, 255, 255, 0.4);
}

.btn-block { width: 100%; }

button.btn-reset {
  background: transparent;
  padding: 0;
  margin: 0;
  line-height: inherit;
  font-size: inherit;
  color: inherit;
  border: none;
}
button.btn-reset::after { display: none; }

/* 分隔线 */
.divider {
  height: 1rpx;
  background-color: var(--line);
  margin: 16rpx 0;
}

/* 空状态 */
.empty {
  padding: 120rpx 64rpx;
  text-align: center;
  color: var(--text-3);
}

.empty-emoji {
  font-size: 96rpx;
  margin-bottom: 24rpx;
  display: block;
}

/* 触感反馈 */
.tap {
  transition: opacity 0.15s, transform 0.15s;
}
.tap:active {
  opacity: 0.7;
  transform: scale(0.98);
}

/* ====== 线条图标系统 ======
 * 用法：<view class="ic ic-xxx"></view>
 * SVG 内嵌为 data URI，stroke=#FFFFFF。需要在彩色图标处加 .ic-tint-xxx 用 mix-blend / mask 不可行，
 * 所以涉及彩色的字段（如金额）由文本承担，图标始终白色线条。
 */
.ic {
  width: 40rpx;
  height: 40rpx;
  background-size: contain;
  background-position: center;
  background-repeat: no-repeat;
  display: inline-block;
  flex-shrink: 0;
}
.ic-sm { width: 32rpx; height: 32rpx; }
.ic-lg { width: 56rpx; height: 56rpx; }

