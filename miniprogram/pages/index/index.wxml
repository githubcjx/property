<view class="canvas-bg theme-{{theme}}" wx:if="{{!reduceMotion}}"></view>

<view class="page {{reduceMotion ? 'no-motion' : ''}} theme-{{theme}}">
  <!-- 顶栏 -->
  <view class="topbar" style="padding-top: {{statusBarHeight}}px;">
    <view class="top-left">
      <text class="brand">NetWorth · 净值本</text>
      <view class="eye-btn tap" hover-class="btn-hover" bindtap="onToggleHide">
        <view class="ic ic-xs {{hideAmount ? 'ic-eye-off' : 'ic-eye'}}"></view>
      </view>
    </view>
    <view class="add-btn tap" hover-class="btn-hover" bindtap="onAdd">
      <view class="ic ic-xs ic-plus"></view>
    </view>
  </view>

  <!-- Hero · 净资产 -->
  <view class="hero">
    <view class="hero-halo"></view>

    <view class="hero-eyebrow entry-up">YOUR NET WORTH · 此刻</view>

    <view class="hero-amount entry-up d1">
      <block wx:if="{{hideAmount}}">
        <text class="amt-prefix">{{baseSymbol}}</text>
        <text class="amt-int">••••••</text>
      </block>
      <block wx:else>
        <text class="amt-prefix">{{baseSymbol}}</text>
        <text class="amt-sign" wx:if="{{netSign}}">{{netSign}}</text>
        <text class="amt-int">{{netInt}}</text>
        <text class="amt-frac" wx:if="{{netHasFrac}}">.{{netFrac}}</text>
      </block>
      <view class="amt-shine"></view>
    </view>

    <view class="hero-delta entry-up d2" wx:if="{{hasDelta}}">
      <view class="delta-pill {{deltaPositive ? 'pos' : 'neg'}}">
        <view class="ic ic-xs {{deltaPositive ? 'ic-trend-up' : 'ic-trend-down'}}"></view>
        <text class="num">{{hideAmount ? '••••' : deltaText}}</text>
        <text class="delta-pct">· {{hideAmount ? '••' : deltaPctText}}</text>
      </view>
      <text class="delta-label">过去 30 天</text>
    </view>

    <!-- Composition orbs -->
    <view class="orbs entry-up d3" wx:if="{{hasData}}">
      <view
        wx:for="{{composition}}"
        wx:key="id"
        class="orb-wrap"
      >
        <view class="orb cat-tint-{{item.rgbName}} drift-slow"
              style="width:{{item.sizeRpx}}rpx;height:{{item.sizeRpx}}rpx;animation-delay:{{index * 300}}ms;"></view>
      </view>
    </view>
  </view>

  <!-- 内容 -->
  <scroll-view scroll-y class="scroll" enable-flex>
    <block wx:if="{{!loading && !hasData}}">
      <view class="empty-stage">
        <view class="empty-orb"></view>
        <view class="empty-title">还没有账户</view>
        <view class="empty-desc">点击右上角「＋」添加你的第一个账户</view>
        <view class="empty-cta tap" bindtap="onAdd">
          <view class="ic ic-xs ic-plus"></view>
          <text>添加账户</text>
        </view>
      </view>
    </block>

    <block wx:if="{{hasData}}">
      <!-- 月报横幅（月初窗口期；当前为预览强制显示） -->
      <view wx:if="{{monthlyBannerVisible}}" class="mreport-banner entry-up" bindtap="onOpenReport">
        <view class="mrb-ico"><view class="ic ic-sm ic-report"></view></view>
        <view class="mrb-txt">
          <view class="mrb-title">你的{{monthlyBanner.periodLabel}}净值小结</view>
          <view class="mrb-sub">上月小结已生成 · 看看是谁在推动 →</view>
        </view>
        <view class="mrb-x" catchtap="onDismissReportBanner"><view class="ic ic-xs ic-close"></view></view>
      </view>

      <!-- 盘点横幅（账户太久没更新时提示；月报横幅优先） -->
      <view wx:if="{{invBannerVisible}}" class="inv-banner entry-up" bindtap="onOpenInventory">
        <view class="ivb-ico"><view class="ic ic-sm ic-checklist"></view></view>
        <view class="ivb-txt">
          <view class="ivb-title">该盘点了</view>
          <view class="ivb-sub">{{invBannerSub}} · 逐个核对一遍 →</view>
        </view>
        <view class="ivb-x" catchtap="onDismissInvBanner"><view class="ic ic-xs ic-close"></view></view>
      </view>

      <view class="groups">
        <view
          wx:for="{{groups}}"
          wx:key="categoryId"
          class="cat-card entry-up d{{index + 1}}"
        >
          <view class="cat-glow halo-{{item.colorClass}}"></view>

          <view class="cat-row tap" data-id="{{item.categoryId}}" bindtap="onToggleGroup">
            <view class="cat-orb {{item.tintClass}}">
              <view class="ic-glyph {{item.glyphClass}}"></view>
            </view>
            <view class="cat-meta">
              <view class="cat-line">
                <text class="cat-name">{{item.name}}</text>
                <text class="cat-tag">{{item.colorClass}}</text>
              </view>
              <view class="cat-sub">
                <text>{{item.accounts.length}} 项</text>
                <text wx:if="{{item.lastUpdatedText}}" class="cat-sub-dot">·</text>
                <text wx:if="{{item.lastUpdatedText}}">{{item.lastUpdatedText}}</text>
              </view>
            </view>
            <view class="cat-amount cat-{{item.colorClass}}">
              <text class="num">{{hideAmount ? baseSymbol + ' ••••' : item.totalText}}</text>
            </view>
            <view class="chev {{expandedMap[item.categoryId] ? 'chev-open' : ''}}">
              <view class="ic ic-xs ic-chevron-right"></view>
            </view>
          </view>

          <view class="acc-list {{expandedMap[item.categoryId] ? 'expanded' : ''}}">
            <view
              wx:for="{{item.accounts}}"
              wx:for-item="acc"
              wx:key="_id"
              class="acc-row tap"
              data-id="{{acc._id}}"
              hover-class="acc-row-hover"
              bindtap="onAccountTap"
            >
              <view class="acc-icon cat-{{item.colorClass}}">
                <view class="ic ic-sm ic-{{acc.icon || 'folder'}}"></view>
              </view>
              <view class="acc-main">
                <text class="acc-name">{{acc.name}}</text>
                <view class="acc-sub">
                  <text wx:if="{{acc.note}}" class="acc-note">{{acc.note}}</text>
                  <text wx:if="{{!acc.includeInChart}}" class="acc-badge">未计入</text>
                  <text wx:if="{{acc.freshText}}" class="acc-fresh {{acc.freshStale ? 'is-stale' : ''}}">{{acc.freshText}}</text>
                </view>
              </view>
              <text class="acc-amount cat-{{item.colorClass}} num">{{hideAmount ? (acc.symbol || '¥') + ' ••••' : acc.balanceText}}</text>
            </view>
          </view>
        </view>
        <view class="footer-tip">{{version}} · made with care</view>
      </view>
    </block>
  </scroll-view>

  <!-- 左下：工具入口（单一入口 → 分析中心面板） -->
  <view class="fab-cluster fab-cluster-left">
    <view class="tools-entry tap" hover-class="tools-entry-hover" bindtap="onOpenTools">
      <view class="ic ic-sm ic-apps"></view>
      <text class="tools-entry-label">工具</text>
      <view wx:if="{{toolBadgeAny}}" class="tool-dot tool-dot-fab"></view>
    </view>
  </view>

  <!-- 右下：设置 -->
  <view class="fab-cluster fab-cluster-right">
    <view class="fab tap" hover-class="fab-hover" bindtap="onSettings">
      <view class="ic ic-sm ic-settings"></view>
    </view>
  </view>

  <!-- 工具 · 分析中心 面板 -->
  <view wx:if="{{toolsVisible}}" class="tools-mask {{toolsClosing ? 'closing' : ''}}" bindtap="onCloseTools">
    <view class="tools-sheet {{toolsClosing ? 'closing' : ''}}" catchtap="onSheetNoop">
      <view class="sheet-handle"></view>
      <view class="sheet-head">
        <text class="sheet-title">工具<text class="sheet-sub">分析中心</text></text>
        <view class="sheet-close tap" hover-class="btn-hover" catchtap="onCloseTools">
          <view class="ic ic-xs ic-close"></view>
        </view>
      </view>

      <view class="tool-group-label">记录</view>
      <view class="tool-grid">
        <view class="tool-cell tap" hover-class="tool-cell-hover" data-url="/pages/inventory/inventory" data-badge="inventory" bindtap="onToolTap">
          <view class="tool-chip chip-inv">
            <view class="ic ic-sm ic-checklist"></view>
            <view wx:if="{{toolBadges.inventory}}" class="tool-dot"></view>
          </view>
          <text class="tool-label">一键盘点</text>
        </view>
      </view>

      <view class="tool-group-label">回顾</view>
      <view class="tool-grid">
        <view class="tool-cell tap" hover-class="tool-cell-hover" data-url="/pages/report/report" bindtap="onToolTap">
          <view class="tool-chip chip-report"><view class="ic ic-sm ic-report"></view></view>
          <text class="tool-label">月度小结</text>
        </view>
      </view>

      <view class="tool-group-label">洞察与成长</view>
      <view class="tool-grid">
        <view class="tool-cell tap" hover-class="tool-cell-hover" data-url="/pages/health/health" bindtap="onToolTap">
          <view class="tool-chip chip-mint"><view class="ic ic-sm ic-health-pulse"></view></view>
          <text class="tool-label">财务体检</text>
        </view>
        <view class="tool-cell tap" hover-class="tool-cell-hover" data-url="/subpackages/chart-pkg/pages/chart/chart" bindtap="onToolTap">
          <view class="tool-chip chip-ice"><view class="ic ic-sm ic-chart"></view></view>
          <text class="tool-label">净值趋势</text>
        </view>
        <view class="tool-cell tap" hover-class="tool-cell-hover" data-url="/pages/insights/insights" data-badge="insights" bindtap="onToolTap">
          <view class="tool-chip chip-teal">
            <view class="ic ic-sm ic-pie"></view>
            <view wx:if="{{toolBadges.insights}}" class="tool-dot"></view>
          </view>
          <text class="tool-label">资产洞察</text>
        </view>
<!-- 「同龄对标」入口暂时下线:对照分布(benchmark.js AGE_BUCKETS)目前为占位示意数据,
     非权威真实数据,放出会让用户误以为是精确统计结论。待接入真实/可校准数据后再恢复本入口。
        <view class="tool-cell tap" hover-class="tool-cell-hover" data-url="/pages/peer-benchmark/peer-benchmark" bindtap="onToolTap">
          <view class="tool-chip chip-lav"><view class="ic ic-sm ic-peers"></view></view>
          <text class="tool-label">同龄对标</text>
        </view>
-->

        <view class="tool-cell tap" hover-class="tool-cell-hover" data-url="/pages/milestones/milestones" data-badge="milestones" bindtap="onToolTap">
          <view class="tool-chip chip-gold">
            <view class="ic ic-sm ic-trophy"></view>
            <view wx:if="{{toolBadges.milestones}}" class="tool-dot"></view>
          </view>
          <text class="tool-label">净值目标</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 版本更新提醒（玻璃弹窗，每版首次进入提示一次） -->
  <view wx:if="{{updateNoticeVisible}}" class="upd-mask" catchtap="dismissUpdateNotice">
    <view class="upd-card glass" catchtap="noop">
      <view class="upd-badge">新版本 · {{updateNotice.version}}</view>
      <view class="upd-title">{{updateNotice.title}}</view>
      <view class="upd-items">
        <view class="upd-item" wx:for="{{updateNotice.items}}" wx:key="*this">
          <view class="upd-dot"></view>
          <text class="upd-text">{{item}}</text>
        </view>
      </view>
      <view class="upd-actions">
        <view class="upd-btn upd-btn-ghost tap" hover-class="upd-btn-hover" catchtap="onViewUpdateChangelog">查看更新日志</view>
        <view class="upd-btn upd-btn-primary tap" hover-class="upd-btn-hover" catchtap="dismissUpdateNotice">知道了</view>
      </view>
    </view>
  </view>
</view>
