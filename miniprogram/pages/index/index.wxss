.page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  position: relative;
  overflow: hidden;
}

/* ============ Topbar ============ */
.topbar {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding-left: 32rpx;
  padding-right: 32rpx;
  padding-bottom: 12rpx;
}
.top-left {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 16rpx;
}
.brand {
  font-size: 22rpx;
  color: var(--ink-60);
  letter-spacing: 0.16em;
  font-weight: 500;
}
.eye-btn, .add-btn {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: var(--glass-2);
  border: 1rpx solid var(--hairline-hi);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: inset 0 1rpx 0 rgba(255,255,255,0.10), 0 8rpx 20rpx rgba(0,0,0,0.4);
}
.add-btn { 
  width: 72rpx;
  height: 72rpx;
  position: fixed;
  top: 180rpx;
  right: 32rpx;
  z-index: 9;
}
.btn-hover {
  background: var(--glass-3);
  transform: scale(0.94);
}

/* ============ Hero ============ */
.hero {
  position: relative;
  padding: 32rpx 40rpx 28rpx;
  z-index: 1;
}
.hero-halo {
  position: absolute;
  left: 50%; top: 50%;
  transform: translate(-50%, -50%);
  width: 640rpx; height: 480rpx;
  background: radial-gradient(ellipse at center, rgba(var(--accent-rgb), 0.28), transparent 65%);
  filter: blur(56rpx);
  /* 性能:仅呼吸 opacity(合成层廉价)。原 pulse-glow 会动 scale —— 缩放使 blur(56rpx)
     层包围盒每帧变化、被迫重算模糊。glow-soft 只改透明度,视觉仍是脉动光晕。 */
  animation: glow-soft 6s ease-in-out infinite;
  pointer-events: none;
  z-index: 0;
}
.hero-eyebrow {
  position: relative; z-index: 1;
  font-size: 20rpx;
  color: var(--ink-40);
  letter-spacing: 0.22em;
  font-weight: 500;
  text-transform: uppercase;
}
.hero-amount {
  position: relative;
  z-index: 1;
  margin-top: 16rpx;
  display: flex;
  align-items: baseline;
  font-weight: 200;
  letter-spacing: -2rpx;
  text-shadow: 0 0 60rpx rgba(var(--accent-rgb), 0.45), 0 0 120rpx rgba(var(--accent-rgb), 0.18);
  overflow: hidden;
}
.amt-prefix {
  font-size: 48rpx;
  color: rgba(245, 248, 255, 0.55);
  margin-right: 12rpx;
}
.amt-sign {
  font-size: 80rpx;
  color: var(--ink-100);
}
.amt-int {
  font-size: 92rpx;
  color: var(--ink-100);
  font-variant-numeric: tabular-nums;
}
.amt-frac {
  font-size: 44rpx;
  color: rgba(245, 248, 255, 0.55);
  font-variant-numeric: tabular-nums;
  margin-left: 4rpx;
}
.amt-shine {
  position: absolute; top: 0; bottom: 0; left: 0;
  width: 60%;
  background: linear-gradient(90deg, transparent, rgba(255,255,255,0.42), transparent);
  filter: blur(2rpx);
  /* 只在打开小程序、首页首次渲染时扫一次;forwards 保持终态(透明),之后不再自动重播。
     base opacity:0 确保扫光前后没有残留的静态高光带。
     (此前已去掉 mix-blend-mode: screen —— 混合模式禁止图层缓存、每帧回读背景重新合成) */
  opacity: 0;
  animation: shine-sweep 5s var(--ease-soft) forwards;
  pointer-events: none;
}

.hero-delta {
  position: relative; z-index: 1;
  margin-top: 20rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.delta-pill {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 500;
  border: 1rpx solid;
  /* 性能:药丸本身已有 .pos/.neg 着色底,backdrop-filter 视觉增益极小却要每帧重算,移除。 */
}
.delta-pill .ic { width: 18rpx; height: 18rpx; }
.delta-pill.pos {
  color: var(--ice-blue);
  background: rgba(var(--accent-rgb), 0.18);
  border-color: rgba(var(--accent-rgb), 0.35);
}
.delta-pill.neg {
  color: var(--debt);
  background: rgba(255, 179, 179, 0.18);
  border-color: rgba(255, 179, 179, 0.35);
}
.delta-pct {
  opacity: 0.75;
  margin-left: 2rpx;
}
.delta-label {
  font-size: 22rpx;
  color: var(--ink-60);
  letter-spacing: 0.12em;
}

/* ============ Composition orbs ============ */
.orbs {
  position: relative; z-index: 1;
  margin-top: 36rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.orb-wrap {
  display: flex;
  align-items: center;
  justify-content: center;
  max-width: 50px;
  max-height: 50px;
}
.orb {
  border-radius: 50%;
  position: relative;
  flex-shrink: 0;
  max-width: 50px;
  max-height: 50px;
}

/* ============ Scroll ============ */
.scroll {
  flex: 1;
  padding: 0 28rpx 220rpx;
  box-sizing: border-box;
}

/* ============ Empty state ============ */
.empty-stage {
  margin-top: 160rpx;
  text-align: center;
  padding: 60rpx 32rpx;
}
.empty-orb {
  width: 160rpx;
  height: 160rpx;
  margin: 0 auto 32rpx;
  border-radius: 50%;
  background: radial-gradient(circle at 30% 30%, rgba(var(--accent-rgb), 0.7), rgba(var(--accent-rgb), 0.1) 70%);
  border: 1rpx solid rgba(var(--accent-rgb), 0.4);
  box-shadow: inset 0 4rpx 0 rgba(255,255,255,0.25), 0 0 60rpx rgba(var(--accent-rgb), 0.4);
  /* 性能:与 hero-halo 一致,改 opacity 呼吸(glow-soft),不再动 scale */
  animation: glow-soft 5s ease-in-out infinite;
}
.empty-title {
  font-size: 36rpx;
  color: var(--ink-100);
  font-weight: 500;
}
.empty-desc {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: var(--ink-60);
}
.empty-cta {
  display: inline-flex;
  align-items: center;
  gap: 10rpx;
  margin-top: 40rpx;
  padding: 20rpx 40rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, var(--ice-blue), rgba(var(--accent-rgb), 0.5));
  color: #0a0d12;
  font-size: 26rpx;
  font-weight: 600;
  box-shadow: 0 16rpx 40rpx rgba(var(--accent-rgb), 0.4), inset 0 2rpx 0 rgba(255,255,255,0.5);
}
.empty-manual {
  margin-top: 24rpx;
  font-size: 24rpx;
  color: var(--ink-60);
  padding: 12rpx;
}

/* ============ Category cards ============ */
.groups {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  padding-top: 24rpx;
}
.cat-card {
  border-radius: 36rpx;
  overflow: hidden;
  position: relative;
  /* 性能:原先靠 .glass 的 backdrop-filter;5 张卡 × 滚动时每帧重算毛玻璃,极耗 GPU。
     改为半透明渐变 + 描边,视觉接近玻璃质感、零 backdrop-filter;彩色光晕仍由 .cat-glow 提供。 */
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.07), rgba(255, 255, 255, 0.04));
  border: 1rpx solid var(--hairline);
  box-shadow: inset 0 2rpx 0 rgba(255, 255, 255, 0.08), 0 24rpx 72rpx rgba(0, 0, 0, 0.45);
}
.cat-glow {
  position: absolute;
  right: -40rpx; top: -40rpx;
  width: 240rpx; height: 240rpx;
  filter: blur(24rpx);
  pointer-events: none;
  opacity: 0.7;
}

.cat-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx 26rpx;
  position: relative;
  z-index: 1;
}
.cat-orb {
  width: 80rpx; height: 80rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.ic-glyph {
  width: 44rpx;
  height: 44rpx;
  background-size: contain;
  background-position: center;
  background-repeat: no-repeat;
}

.cat-meta {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}
.cat-line {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
  white-space: nowrap;
  overflow: hidden;
}
.cat-name {
  font-size: 30rpx;
  color: var(--ink-100);
  font-weight: 500;
}
.cat-tag {
  font-size: 18rpx;
  color: var(--ink-40);
  letter-spacing: 0.16em;
  text-transform: uppercase;
}
.cat-sub {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 8rpx;
  font-size: 20rpx;
  color: var(--ink-40);
  white-space: nowrap;
  overflow: hidden;
}
.cat-sub-dot { opacity: 0.5; }

.cat-amount {
  flex-shrink: 0;
  text-align: right;
  font-size: 30rpx;
  font-weight: 400;
  text-shadow: 0 0 24rpx currentColor;
  font-variant-numeric: tabular-nums;
}
.chev {
  width: 32rpx; height: 32rpx;
  display: flex; align-items: center; justify-content: center;
  color: var(--ink-40);
  transition: transform 0.55s var(--ease-spring);
  flex-shrink: 0;
}
.chev-open {
  transform: rotate(90deg);
}

/* accordion */
.acc-list {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  max-height: 0;
  overflow: hidden;
  opacity: 0;
  padding: 0 16rpx;
  transition: max-height 0.5s var(--ease-spring),
              opacity 0.35s var(--ease-soft),
              padding 0.35s var(--ease-soft);
  position: relative;
  z-index: 1;
}
.acc-list.expanded {
  max-height: 4000rpx;
  opacity: 1;
  padding: 0 16rpx 20rpx;
}

.acc-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 20rpx;
  padding: 22rpx 20rpx;
  border-radius: 22rpx;
  background: rgba(255,255,255,0.03);
  border: 1rpx solid rgba(255,255,255,0.04);
}
.acc-row-hover {
  background: rgba(255,255,255,0.07);
}
.acc-icon {
  width: 56rpx; height: 56rpx;
  border-radius: 18rpx;
  background: rgba(255,255,255,0.05);
  border: 1rpx solid var(--hairline);
  display: flex; align-items: center; justify-content: center;
  flex-shrink: 0;
}
/* 子分类图标：用 mask 渲染，颜色继承类目主色（来自 .acc-icon 的 inline color） */
.acc-icon .ic {
  background-image: none !important;
  background-color: currentColor;
  -webkit-mask-image: var(--ic-src);
          mask-image: var(--ic-src);
  -webkit-mask-size: contain;
          mask-size: contain;
  -webkit-mask-position: center;
          mask-position: center;
  -webkit-mask-repeat: no-repeat;
          mask-repeat: no-repeat;
  filter: drop-shadow(0 0 6rpx currentColor);
}
.acc-main {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  min-width: 0;
}
.acc-name {
  font-size: 26rpx;
  color: var(--ink-100);
  font-weight: 400;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.acc-sub {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 10rpx;
}
.acc-note {
  font-size: 20rpx;
  color: var(--ink-40);
}
.acc-fresh {
  font-size: 20rpx;
  color: var(--ink-40);
}
.acc-fresh.is-stale { color: var(--warn); }
.acc-badge {
  font-size: 18rpx;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
  background: rgba(255,255,255,0.06);
  color: var(--ink-60);
}
.acc-amount {
  flex-shrink: 0;
  font-size: 26rpx;
  font-variant-numeric: tabular-nums;
  text-shadow: 0 0 16rpx currentColor;
}

.footer-tip {
  text-align: center;
  font-size: 18rpx;
  color: var(--ink-20);
  letter-spacing: 0.2em;
  text-transform: uppercase;
  margin: 64rpx 0 0;
}

/* ============ FAB ============ */
.fab-cluster {
  position: fixed;
  bottom: calc(56rpx + env(safe-area-inset-bottom));
  display: flex;
  gap: 16rpx;
  z-index: 100;
}
.fab-cluster-left  { left: 32rpx; }
.fab-cluster-right { right: 32rpx; }
.fab {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  /* 毛玻璃:这两个按钮在屏幕底部、远离会呼吸的 hero 光晕,背后是静态背景 ——
     blur 一次性栅格化后即被缓存,待机时几乎零开销;仅滚动时短暂重算,且只有两个小元素,可控。
     简化动效模式下会移除(见下方 .no-motion 覆盖)。 */
  background: var(--glass-2);
  -webkit-backdrop-filter: blur(28rpx) saturate(160%);
  backdrop-filter: blur(28rpx) saturate(160%);
  border: 1rpx solid var(--hairline-hi);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 12rpx 32rpx rgba(0, 0, 0, 0.5), inset 0 2rpx 0 rgba(255,255,255,0.10);
  position: relative;
}
.fab::before {
  content: '';
  position: absolute;
  inset: -8rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(var(--accent-rgb), 0.25), transparent 70%);
  filter: blur(8rpx);
  opacity: 0;
  transition: opacity 0.3s var(--ease-soft);
}
.fab-hover {
  background: var(--glass-3);
  transform: scale(0.95);
}
.fab-hover::before { opacity: 1; }

/* ============ 工具入口（带文字胶囊） ============ */
.tools-entry {
  position: relative;
  display: flex;
  align-items: center;
  gap: 12rpx;
  height: 96rpx;
  padding: 0 30rpx 0 26rpx;
  border-radius: 48rpx;
  /* 毛玻璃:这两个按钮在屏幕底部、远离会呼吸的 hero 光晕,背后是静态背景 ——
     blur 一次性栅格化后即被缓存,待机时几乎零开销;仅滚动时短暂重算,且只有两个小元素,可控。
     简化动效模式下会移除(见下方 .no-motion 覆盖)。 */
  background: var(--glass-2);
  -webkit-backdrop-filter: blur(28rpx) saturate(160%);
  backdrop-filter: blur(28rpx) saturate(160%);
  border: 1rpx solid var(--hairline-hi);
  box-shadow: 0 12rpx 32rpx rgba(0, 0, 0, 0.5), inset 0 2rpx 0 rgba(255, 255, 255, 0.10);
}
.tools-entry-label {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--ink-100);
  letter-spacing: 0.5rpx;
}
.tools-entry-hover {
  background: var(--glass-3);
  transform: scale(0.96);
}

/* 新功能红点：工具入口聚合红点 + 面板内工具条目右上角红点。
   红点是「有更新」的通知语义，用固定醒目红(区别于财务负向的 --debt 柔红)，
   box-shadow 用同底色描边，让它像浮在表面。 */
.tool-dot {
  position: absolute;
  top: -4rpx; right: -4rpx;
  width: 16rpx; height: 16rpx;
  border-radius: 50%;
  background: #fa5151;
  box-shadow: 0 0 0 3rpx var(--bg-1), 0 0 8rpx rgba(250, 81, 81, 0.6);
  z-index: 3;
}
.tool-dot-fab { top: 12rpx; right: 16rpx; }

/* ============ 工具 · 分析中心面板 ============ */
.tools-mask {
  position: fixed;
  inset: 0;
  z-index: 200;
  background: rgba(3, 4, 7, 0.6);
  -webkit-backdrop-filter: blur(6rpx);
  backdrop-filter: blur(6rpx);
  display: flex;
  align-items: flex-end;
  animation: tools-fade 0.22s var(--ease-soft);
}
.tools-mask.closing { animation: tools-fade-out 0.26s var(--ease-soft) forwards; }

.tools-sheet {
  width: 100%;
  padding: 16rpx 40rpx calc(48rpx + env(safe-area-inset-bottom));
  border-radius: 40rpx 40rpx 0 0;
  background: linear-gradient(180deg, #14161d 0%, #0a0b10 100%);
  border-top: 1rpx solid var(--hairline-hi);
  box-shadow: 0 -24rpx 60rpx rgba(0, 0, 0, 0.5);
  animation: tools-rise 0.3s var(--ease-soft);
}
.tools-sheet.closing { animation: tools-sink 0.28s var(--ease-soft) forwards; }

@keyframes tools-fade { from { opacity: 0; } to { opacity: 1; } }
@keyframes tools-rise { from { transform: translateY(100%); } to { transform: translateY(0); } }
/* 关闭:用独立的「正向」退出动画 + forwards 保持终态。
   原先用 reverse 复用开场动画,缓动被反转、且同名动画切换可能不重启,体感像「突然消失」。 */
@keyframes tools-fade-out { from { opacity: 1; } to { opacity: 0; } }
@keyframes tools-sink { from { transform: translateY(0); } to { transform: translateY(105%); } }
.no-motion .tools-mask, .no-motion .tools-sheet { animation: none; }
/* 简化动效:悬浮按钮也去掉 backdrop-filter,回退不透明深色,彻底降温 */
.no-motion .fab,
.no-motion .tools-entry {
  -webkit-backdrop-filter: none;
  backdrop-filter: none;
  background: rgba(22, 24, 30, 0.9);
}

.sheet-handle {
  width: 72rpx; height: 8rpx;
  border-radius: 4rpx;
  background: var(--ink-20);
  margin: 4rpx auto 24rpx;
}
.sheet-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8rpx;
}
.sheet-title {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--ink-100);
  letter-spacing: 0.5rpx;
}
.sheet-close {
  width: 60rpx; height: 60rpx;
  border-radius: 50%;
  background: var(--glass-1);
  border: 1rpx solid var(--hairline);
  display: flex; align-items: center; justify-content: center;
}

.tool-grid {
  display: flex;
  flex-wrap: wrap;
}
.tool-cell {
  width: 25%;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  padding: 8rpx 0 16rpx;
}
.tool-cell-hover { transform: scale(0.92); opacity: 0.85; }
.tool-chip {
  width: 104rpx; height: 104rpx;
  border-radius: 30rpx;
  display: flex; align-items: center; justify-content: center;
  position: relative;
  border: 1rpx solid var(--hairline);
}
.tool-chip::after {
  content: '';
  position: absolute; inset: 0;
  border-radius: 30rpx;
  filter: blur(16rpx);
  opacity: 0.7;
  z-index: -1;
}
.chip-ice   { background: rgba(var(--accent-rgb), 0.16); border-color: rgba(var(--accent-rgb), 0.32); }
.chip-ice::after   { background: radial-gradient(circle, rgba(var(--accent-rgb), 0.40), transparent 70%); }
.chip-gold  { background: rgba(243, 223, 163, 0.16); border-color: rgba(243, 223, 163, 0.32); }
.chip-gold::after  { background: radial-gradient(circle, rgba(243, 223, 163, 0.34), transparent 70%); }
.chip-teal  { background: rgba(var(--fixed-rgb), 0.16); border-color: rgba(var(--fixed-rgb), 0.32); }
.chip-teal::after  { background: radial-gradient(circle, rgba(var(--fixed-rgb), 0.38), transparent 70%); }
.chip-report { background: rgba(255, 207, 138, 0.16); border-color: rgba(255, 207, 138, 0.32); }
.chip-report::after { background: radial-gradient(circle, rgba(255, 207, 138, 0.36), transparent 70%); }
.chip-inv  { background: rgba(var(--good-rgb), 0.16); border-color: rgba(var(--good-rgb), 0.32); }
.chip-inv::after  { background: radial-gradient(circle, rgba(var(--good-rgb), 0.38), transparent 70%); }

/* ============ 月报横幅 ============ */
.mreport-banner {
  position: relative;
  display: flex;
  align-items: center;
  gap: 22rpx;
  margin: 0 0 24rpx;
  padding: 28rpx 26rpx;
  border-radius: 28rpx;
  overflow: hidden;
  background:
    radial-gradient(130% 120% at 0% 0%, rgba(255, 207, 138, 0.22), transparent 60%),
    linear-gradient(180deg, rgba(255, 207, 138, 0.15), rgba(255, 207, 138, 0.05));
  border: 1rpx solid rgba(255, 207, 138, 0.42);
  box-shadow: 0 12rpx 36rpx rgba(255, 207, 138, 0.12);
}
.mrb-ico {
  width: 80rpx; height: 80rpx; flex: 0 0 80rpx; border-radius: 24rpx;
  display: flex; align-items: center; justify-content: center;
  background: linear-gradient(160deg, rgba(255, 207, 138, 0.4), rgba(255, 207, 138, 0.12));
}
.mrb-txt { flex: 1; min-width: 0; }
.mrb-title { font-size: 30rpx; font-weight: 800; color: var(--ink-100); }
.mrb-sub { font-size: 24rpx; color: var(--ink-80); margin-top: 6rpx; }
.mrb-x {
  position: absolute; top: 12rpx; right: 14rpx;
  width: 40rpx; height: 40rpx; display: flex; align-items: center; justify-content: center;
  opacity: 0.5;
}

/* ============ 盘点入口（常驻，随新鲜度变脸）============ */
.inv-entry {
  position: relative;
  display: flex;
  align-items: center;
  gap: 22rpx;
  margin: 0 0 24rpx;
  padding: 22rpx 26rpx;
  border-radius: 28rpx;
  overflow: hidden;
  background: var(--glass-1);
  border: 1rpx solid var(--hairline);
}
.inv-entry-hover { transform: scale(0.99); opacity: 0.9; }
.ive-ico {
  width: 76rpx; height: 76rpx; flex: 0 0 76rpx; border-radius: 22rpx;
  display: flex; align-items: center; justify-content: center;
  background: var(--glass-2);
  border: 1rpx solid var(--hairline);
}
.ive-txt { flex: 1; min-width: 0; }
.ive-title { font-size: 28rpx; font-weight: 700; color: var(--ink-100); }
.ive-sub { font-size: 22rpx; color: var(--ink-60); margin-top: 4rpx; }
.ive-arrow { flex: 0 0 auto; opacity: 0.45; }

/* 发霉：变响。用 warn 琥珀（与账户行「N 天没核对」的 stale 色一致），不是财务负向的红 */
.inv-entry.is-stale {
  background:
    radial-gradient(130% 120% at 0% 0%, rgba(var(--warn-rgb), 0.20), transparent 60%),
    linear-gradient(180deg, rgba(var(--warn-rgb), 0.13), rgba(var(--warn-rgb), 0.05));
  border-color: rgba(var(--warn-rgb), 0.40);
  box-shadow: 0 12rpx 36rpx rgba(var(--warn-rgb), 0.10);
}
.inv-entry.is-stale .ive-ico {
  background: linear-gradient(160deg, rgba(var(--warn-rgb), 0.36), rgba(var(--warn-rgb), 0.10));
  border-color: rgba(var(--warn-rgb), 0.30);
}
.inv-entry.is-stale .ive-title { font-weight: 800; }
.inv-entry.is-stale .ive-arrow { opacity: 0.9; }
.tool-label {
  font-size: 24rpx;
  color: var(--ink-80);
  font-weight: 500;
}

