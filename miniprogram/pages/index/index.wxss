.page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  position: relative;
  overflow: hidden;
}

/* ============ Topbar ============ */
.topbar {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding-left: 32rpx;
  padding-right: 32rpx;
  padding-bottom: 12rpx;
}
.top-left {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 16rpx;
}
.brand {
  font-size: 22rpx;
  color: var(--ink-60);
  letter-spacing: 0.16em;
  font-weight: 500;
}
.eye-btn, .add-btn {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: var(--glass-2);
  border: 1rpx solid var(--hairline-hi);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: inset 0 1rpx 0 rgba(255,255,255,0.10), 0 8rpx 20rpx rgba(0,0,0,0.4);
}
.add-btn { 
  width: 72rpx;
  height: 72rpx;
  position: relative;
  top: 84rpx;
  z-index: 9;
}
.btn-hover {
  background: var(--glass-3);
  transform: scale(0.94);
}

/* ============ Hero ============ */
.hero {
  position: relative;
  padding: 32rpx 40rpx 28rpx;
  z-index: 1;
}
.hero-halo {
  position: absolute;
  left: 50%; top: 50%;
  transform: translate(-50%, -50%);
  width: 640rpx; height: 480rpx;
  background: radial-gradient(ellipse at center, rgba(167, 211, 255, 0.28), transparent 65%);
  filter: blur(56rpx);
  animation: pulse-glow 6s ease-in-out infinite;
  pointer-events: none;
  z-index: 0;
}
.hero-eyebrow {
  position: relative; z-index: 1;
  font-size: 20rpx;
  color: var(--ink-40);
  letter-spacing: 0.22em;
  font-weight: 500;
  text-transform: uppercase;
}
.hero-amount {
  position: relative;
  z-index: 1;
  margin-top: 16rpx;
  display: flex;
  align-items: baseline;
  font-weight: 200;
  letter-spacing: -2rpx;
  text-shadow: 0 0 60rpx rgba(167, 211, 255, 0.45), 0 0 120rpx rgba(167, 211, 255, 0.18);
  overflow: hidden;
}
.amt-prefix {
  font-size: 48rpx;
  color: rgba(245, 248, 255, 0.55);
  margin-right: 12rpx;
}
.amt-sign {
  font-size: 80rpx;
  color: var(--ink-100);
}
.amt-int {
  font-size: 92rpx;
  color: var(--ink-100);
  font-variant-numeric: tabular-nums;
}
.amt-frac {
  font-size: 44rpx;
  color: rgba(245, 248, 255, 0.55);
  font-variant-numeric: tabular-nums;
  margin-left: 4rpx;
}
.amt-shine {
  position: absolute; top: 0; bottom: 0; left: 0;
  width: 60%;
  background: linear-gradient(90deg, transparent, rgba(255,255,255,0.42), transparent);
  filter: blur(2rpx);
  animation: shine-sweep 5s var(--ease-soft) infinite;
  pointer-events: none;
  mix-blend-mode: screen;
}

.hero-delta {
  position: relative; z-index: 1;
  margin-top: 20rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.delta-pill {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 500;
  border: 1rpx solid;
  -webkit-backdrop-filter: blur(20rpx);
  backdrop-filter: blur(20rpx);
}
.delta-pill .ic { width: 18rpx; height: 18rpx; }
.delta-pill.pos {
  color: var(--ice-blue);
  background: rgba(167, 211, 255, 0.18);
  border-color: rgba(167, 211, 255, 0.35);
}
.delta-pill.neg {
  color: var(--debt);
  background: rgba(255, 179, 179, 0.18);
  border-color: rgba(255, 179, 179, 0.35);
}
.delta-pct {
  opacity: 0.75;
  margin-left: 2rpx;
}
.delta-label {
  font-size: 22rpx;
  color: var(--ink-60);
  letter-spacing: 0.12em;
}

/* ============ Composition orbs ============ */
.orbs {
  position: relative; z-index: 1;
  margin-top: 36rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.orb-wrap {
  display: flex;
  align-items: center;
  justify-content: center;
  max-width: 50px;
  max-height: 50px;
}
.orb {
  border-radius: 50%;
  position: relative;
  flex-shrink: 0;
  max-width: 50px;
  max-height: 50px;
}

/* ============ Scroll ============ */
.scroll {
  flex: 1;
  padding: 0 28rpx 220rpx;
  box-sizing: border-box;
}

/* ============ Empty state ============ */
.empty-stage {
  margin-top: 60rpx;
  text-align: center;
  padding: 60rpx 32rpx;
}
.empty-orb {
  width: 160rpx;
  height: 160rpx;
  margin: 0 auto 32rpx;
  border-radius: 50%;
  background: radial-gradient(circle at 30% 30%, rgba(167, 211, 255, 0.7), rgba(167, 211, 255, 0.1) 70%);
  border: 1rpx solid rgba(167, 211, 255, 0.4);
  box-shadow: inset 0 4rpx 0 rgba(255,255,255,0.25), 0 0 60rpx rgba(167, 211, 255, 0.4);
  animation: pulse-glow 5s ease-in-out infinite;
}
.empty-title {
  font-size: 36rpx;
  color: var(--ink-100);
  font-weight: 500;
}
.empty-desc {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: var(--ink-60);
}
.empty-cta {
  display: inline-flex;
  align-items: center;
  gap: 10rpx;
  margin-top: 40rpx;
  padding: 20rpx 40rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, var(--ice-blue), rgba(167, 211, 255, 0.5));
  color: #0a0d12;
  font-size: 26rpx;
  font-weight: 600;
  box-shadow: 0 16rpx 40rpx rgba(167, 211, 255, 0.4), inset 0 2rpx 0 rgba(255,255,255,0.5);
}

/* ============ Category cards ============ */
.groups {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  padding-top: 24rpx;
}
.cat-card {
  border-radius: 36rpx;
  overflow: hidden;
  position: relative;
}
.cat-glow {
  position: absolute;
  right: -40rpx; top: -40rpx;
  width: 240rpx; height: 240rpx;
  filter: blur(24rpx);
  pointer-events: none;
  opacity: 0.7;
}

.cat-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx 26rpx;
  position: relative;
  z-index: 1;
}
.cat-orb {
  width: 80rpx; height: 80rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.ic-glyph {
  width: 44rpx;
  height: 44rpx;
  background-size: contain;
  background-position: center;
  background-repeat: no-repeat;
}

.cat-meta {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}
.cat-line {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
  white-space: nowrap;
  overflow: hidden;
}
.cat-name {
  font-size: 30rpx;
  color: var(--ink-100);
  font-weight: 500;
}
.cat-tag {
  font-size: 18rpx;
  color: var(--ink-40);
  letter-spacing: 0.16em;
  text-transform: uppercase;
}
.cat-sub {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 8rpx;
  font-size: 20rpx;
  color: var(--ink-40);
  white-space: nowrap;
  overflow: hidden;
}
.cat-sub-dot { opacity: 0.5; }

.cat-amount {
  flex-shrink: 0;
  text-align: right;
  font-size: 30rpx;
  font-weight: 400;
  text-shadow: 0 0 24rpx currentColor;
  font-variant-numeric: tabular-nums;
}
.chev {
  width: 32rpx; height: 32rpx;
  display: flex; align-items: center; justify-content: center;
  color: var(--ink-40);
  transition: transform 0.55s var(--ease-spring);
  flex-shrink: 0;
}
.chev-open {
  transform: rotate(90deg);
}

/* accordion */
.acc-list {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  max-height: 0;
  overflow: hidden;
  opacity: 0;
  padding: 0 16rpx;
  transition: max-height 0.5s var(--ease-spring),
              opacity 0.35s var(--ease-soft),
              padding 0.35s var(--ease-soft);
  position: relative;
  z-index: 1;
}
.acc-list.expanded {
  max-height: 4000rpx;
  opacity: 1;
  padding: 0 16rpx 20rpx;
}

.acc-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 20rpx;
  padding: 22rpx 20rpx;
  border-radius: 22rpx;
  background: rgba(255,255,255,0.03);
  border: 1rpx solid rgba(255,255,255,0.04);
}
.acc-row-hover {
  background: rgba(255,255,255,0.07);
}
.acc-icon {
  width: 56rpx; height: 56rpx;
  border-radius: 18rpx;
  background: rgba(255,255,255,0.05);
  border: 1rpx solid var(--hairline);
  display: flex; align-items: center; justify-content: center;
  flex-shrink: 0;
}
/* 子分类图标：用 mask 渲染，颜色继承类目主色（来自 .acc-icon 的 inline color） */
.acc-icon .ic {
  background-image: none !important;
  background-color: currentColor;
  -webkit-mask-image: var(--ic-src);
          mask-image: var(--ic-src);
  -webkit-mask-size: contain;
          mask-size: contain;
  -webkit-mask-position: center;
          mask-position: center;
  -webkit-mask-repeat: no-repeat;
          mask-repeat: no-repeat;
  filter: drop-shadow(0 0 6rpx currentColor);
}
.acc-main {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  min-width: 0;
}
.acc-name {
  font-size: 26rpx;
  color: var(--ink-100);
  font-weight: 400;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.acc-sub {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 10rpx;
}
.acc-note {
  font-size: 20rpx;
  color: var(--ink-40);
}
.acc-badge {
  font-size: 18rpx;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
  background: rgba(255,255,255,0.06);
  color: var(--ink-60);
}
.acc-amount {
  flex-shrink: 0;
  font-size: 26rpx;
  font-variant-numeric: tabular-nums;
  text-shadow: 0 0 16rpx currentColor;
}

.footer-tip {
  text-align: center;
  font-size: 18rpx;
  color: var(--ink-20);
  letter-spacing: 0.2em;
  text-transform: uppercase;
  margin: 64rpx 0 0;
}

/* ============ FAB ============ */
.fab-cluster {
  position: fixed;
  right: 32rpx;
  bottom: calc(56rpx + env(safe-area-inset-bottom));
  display: flex;
  gap: 16rpx;
  z-index: 100;
}
.fab {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: var(--glass-2);
  -webkit-backdrop-filter: blur(28rpx) saturate(160%);
  backdrop-filter: blur(28rpx) saturate(160%);
  border: 1rpx solid var(--hairline-hi);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 12rpx 32rpx rgba(0, 0, 0, 0.5), inset 0 2rpx 0 rgba(255,255,255,0.10);
  position: relative;
}
.fab::before {
  content: '';
  position: absolute;
  inset: -8rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(167, 211, 255, 0.25), transparent 70%);
  filter: blur(8rpx);
  opacity: 0;
  transition: opacity 0.3s var(--ease-soft);
}
.fab-hover {
  background: var(--glass-3);
  transform: scale(0.95);
}
.fab-hover::before { opacity: 1; }
