.page {
  min-height: 100vh;
  padding: 0 32rpx 80rpx;
  position: relative;
  overflow: hidden;
}

/* ============ 透明 navbar ============ */
.navbar {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding-bottom: 14rpx;
  position: relative;
  z-index: 5;
}
.nav-title {
  font-size: 26rpx;
  color: var(--ink-80);
  font-weight: 500;
  letter-spacing: 0.04em;
}
.nav-btn {
  width: 56rpx; height: 56rpx;
  border-radius: 50%;
  background: var(--glass-1);
  border: 1rpx solid var(--hairline);
  display: flex; align-items: center; justify-content: center;
  -webkit-backdrop-filter: blur(20rpx);
  backdrop-filter: blur(20rpx);
}
.nav-btn-hover { background: var(--glass-3); transform: scale(0.95); }
.nav-spacer { width: 56rpx; }

/* ============ 实时预览 ============ */
.preview { margin-top: 12rpx; }

.hero {
  position: relative;
  padding: 36rpx 32rpx;
  border-radius: 32rpx;
  overflow: hidden;
  margin-bottom: 20rpx;
}
.hero-halo {
  position: absolute;
  top: -60rpx; right: -40rpx;
  width: 360rpx; height: 360rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(var(--accent-rgb), 0.30), transparent 70%);
  filter: blur(28rpx);
  pointer-events: none;
}
.hero-eyebrow {
  position: relative;
  font-size: 20rpx;
  letter-spacing: 0.18em;
  color: var(--ink-60);
}
.hero-amount {
  position: relative;
  margin-top: 14rpx;
  font-size: 72rpx;
  font-weight: 600;
  color: var(--ink-100);
  letter-spacing: -1rpx;
}
.hero-amount .cur {
  font-size: 36rpx;
  color: var(--ink-60);
  margin-right: 4rpx;
}
.hero-delta {
  position: relative;
  display: inline-flex;
  align-items: center;
  margin-top: 18rpx;
  padding: 6rpx 20rpx;
  border-radius: 24rpx;
  background: rgba(var(--accent-rgb), 0.16);
  border: 1rpx solid rgba(var(--accent-rgb), 0.30);
  color: var(--accent);
  font-size: 24rpx;
  font-weight: 600;
}

.cat {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 24rpx;
  padding: 24rpx 28rpx;
  border-radius: 28rpx;
  margin-bottom: 16rpx;
}
.cat-orb {
  width: 72rpx; height: 72rpx;
  border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  flex-shrink: 0;
}
.cat-name { flex: 1; font-size: 28rpx; color: var(--ink-100); }
.cat-amt { font-size: 28rpx; font-weight: 600; color: var(--ink-100); }

/* ============ 色卡 ============ */
.series-head { margin: 36rpx 4rpx 18rpx; }
.picker-title {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--ink-80);
  letter-spacing: 0.04em;
}
.series-desc {
  display: block;
  margin-top: 6rpx;
  font-size: 20rpx;
  line-height: 1.5;
  color: var(--ink-40);
}
.swatches {
  display: grid;
  grid-template-columns: 1fr 1fr 1fr;
  gap: 18rpx;
}
.swatch {
  position: relative;
  border-radius: 24rpx;
  padding: 22rpx 18rpx 18rpx;
  border: 1rpx solid var(--hairline-hi);
  overflow: hidden;
  transition: transform 0.18s var(--ease-soft), border-color 0.18s;
}
.swatch:active { transform: scale(0.96); }
.swatch.active {
  border-color: rgba(255, 255, 255, 0.5);
  box-shadow: 0 0 0 2rpx rgba(255, 255, 255, 0.28);
}
.swatch.active::after {
  content: '';
  position: absolute;
  top: 16rpx; right: 16rpx;
  width: 28rpx; height: 28rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.92) url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='16' height='16' viewBox='0 0 24 24' fill='none' stroke='%23000000' stroke-width='3' stroke-linecap='round' stroke-linejoin='round'><polyline points='20 6 9 17 4 12'/></svg>") center / 18rpx no-repeat;
}
.sw-dots { display: flex; gap: 8rpx; margin-bottom: 16rpx; }
.sw-dot { width: 30rpx; height: 30rpx; border-radius: 50%; }
.sw-name { font-size: 22rpx; color: rgba(255, 255, 255, 0.9); }
/* 浅色主题的色卡(如硬核粗野)：卡面是浅纸底，名字改墨色、色点加描边防止与底同色隐形 */
.swatch-light .sw-name { color: rgba(20, 17, 11, 0.85); }
.swatch-light .sw-dot { border: 1rpx solid rgba(20, 17, 11, 0.30); }
.swatch-light.active {
  border-color: rgba(20, 17, 11, 0.55);
  box-shadow: 0 0 0 2rpx rgba(20, 17, 11, 0.30);
}

/* 解锁质感系列：未解锁的色卡显示金底黑字「看广告解锁」角标，色点略降透明度示意锁定 */
.swatch-locked .sw-dots { opacity: 0.72; }
.sw-lock {
  position: absolute;
  top: 0; right: 0;
  padding: 4rpx 10rpx;
  font-size: 17rpx;
  font-weight: 700;
  line-height: 1.2;
  color: #14110b;
  background: #ffce2e;
  border-radius: 0 24rpx 0 12rpx;
  letter-spacing: 0.02em;
}

.hint {
  margin-top: 36rpx;
  text-align: center;
  font-size: 20rpx;
  line-height: 1.7;
  color: var(--ink-40);
}
