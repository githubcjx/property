<view class="page">
  <!-- 顶部品牌 -->
  <view class="hero">
    <image class="hero-icon" src="/assets/logo.png" mode="aspectFill" />
    <view class="hero-title">净值本</view>
    <view class="hero-sub">个人净资产快照工具 · {{version}}</view>
  </view>

  <!-- 分组 Q&A -->
  <view class="sec" wx:for="{{sections}}" wx:for-item="sec" wx:key="title">
    <view class="sec-title">{{sec.title}}</view>
    <view class="sec-card">
      <view class="qa" wx:for="{{sec.items}}" wx:for-item="qa" wx:key="q">
        <view class="qa-q">{{qa.q}}</view>
        <view class="qa-a" wx:for="{{qa.a}}" wx:for-item="p" wx:key="*this">{{p}}</view>
      </view>
    </view>
  </view>

  <view class="foot">数据归你所有</view>
</view>
