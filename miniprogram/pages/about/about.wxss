.page {
  min-height: 100vh;
  background-color: #000000;
  padding: 24rpx 32rpx 64rpx;
}

/* 顶部品牌 */
.hero {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 48rpx 0 40rpx;
  gap: 12rpx;
}
.hero-icon {
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  background-color: #1C1C1E;
  overflow: hidden;
}
.hero-title {
  font-size: 40rpx;
  font-weight: 600;
  color: #FFFFFF;
  margin-top: 8rpx;
}
.hero-sub {
  font-size: 24rpx;
  color: rgba(235, 235, 245, 0.5);
}

/* 分组 */
.sec {
  margin-top: 40rpx;
}
.sec-title {
  font-size: 24rpx;
  color: rgba(235, 235, 245, 0.4);
  padding: 0 8rpx 12rpx;
  letter-spacing: 1rpx;
}
.sec-card {
  background-color: #1C1C1E;
  border-radius: 28rpx;
  overflow: hidden;
}

/* Q&A */
.qa {
  padding: 28rpx 32rpx;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.06);
}
.qa:last-child { border-bottom: none; }
.qa-q {
  font-size: 30rpx;
  font-weight: 500;
  color: #FFFFFF;
  margin-bottom: 16rpx;
}
.qa-a {
  font-size: 26rpx;
  line-height: 1.7;
  color: rgba(235, 235, 245, 0.65);
  margin-top: 8rpx;
}
.qa-a:first-of-type { margin-top: 0; }

.foot {
  margin-top: 56rpx;
  text-align: center;
  font-size: 22rpx;
  color: rgba(235, 235, 245, 0.3);
  padding: 0 32rpx;
  line-height: 1.6;
}
