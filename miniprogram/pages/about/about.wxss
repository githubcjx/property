.page {
  min-height: 100vh;
  padding: 0 28rpx 64rpx;
  position: relative;
  overflow: hidden;
}

/* ============ 透明 navbar ============ */
.navbar {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding-bottom: 14rpx;
  position: relative;
  z-index: 5;
}
.nav-title {
  font-size: 26rpx;
  color: var(--ink-80);
  font-weight: 500;
  letter-spacing: 0.04em;
}
.nav-btn {
  width: 56rpx; height: 56rpx;
  border-radius: 50%;
  background: var(--glass-1);
  border: 1rpx solid var(--hairline);
  display: flex; align-items: center; justify-content: center;
  -webkit-backdrop-filter: blur(20rpx);
  backdrop-filter: blur(20rpx);
}
.nav-btn-hover { background: var(--glass-3); transform: scale(0.95); }
.nav-spacer { width: 56rpx; }
.about-halo {
  position: absolute;
  top: -40rpx; left: 50%;
  transform: translateX(-50%);
  width: 560rpx; height: 560rpx;
  background: radial-gradient(circle, rgba(167, 211, 255, 0.18), transparent 70%);
  filter: blur(56rpx);
  pointer-events: none;
  z-index: 0;
}

.hero-icon {
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  background-color: #1C1C1E;
  overflow: hidden;
}

.hero {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx 0 28rpx;
}
.hero-orb {
  width: 144rpx; height: 144rpx;
  border-radius: 44rpx;
  background: radial-gradient(circle at 30% 30%, rgba(167, 211, 255, 0.85), rgba(167, 211, 255, 0.18) 70%);
  border: 1rpx solid rgba(167, 211, 255, 0.5);
  box-shadow: inset 0 4rpx 0 rgba(255,255,255,0.3), 0 0 72rpx rgba(167, 211, 255, 0.42);
  display: flex; align-items: center; justify-content: center;
  animation: drift-icon 6s ease-in-out infinite;
}
.logo-shape {
  width: 64rpx; height: 64rpx;
  background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='36' height='36' viewBox='0 0 36 36' fill='none' stroke='%230a0d12' stroke-width='1.6' stroke-linejoin='round'><path d='M6 26 L 6 14 L 18 6 L 30 14 L 30 26 L 18 30 Z'/><path d='M6 14 L 18 22 L 30 14'/><path d='M18 22 L 18 30'/></svg>");
  background-size: contain;
  background-repeat: no-repeat;
  background-position: center;
}
.hero-title {
  margin-top: 22rpx;
  font-size: 32rpx;
  color: var(--ink-100);
  font-weight: 500;
}
.hero-sub {
  margin-top: 6rpx;
  font-size: 18rpx;
  color: var(--ink-40);
  letter-spacing: 0.18em;
  text-transform: uppercase;
}

.sec {
  position: relative;
  z-index: 1;
  margin-top: 28rpx;
}
.sec-title {
  display: block;
  font-size: 18rpx;
  color: var(--ink-40);
  letter-spacing: 0.2em;
  text-transform: uppercase;
  padding: 0 8rpx 12rpx;
  font-weight: 500;
}
.sec-card {
  border-radius: 28rpx;
  overflow: hidden;
}

.qa {
  padding: 24rpx 28rpx;
  border-bottom: 1rpx solid var(--hairline);
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}
.qa:last-child { border-bottom: none; }
.qa-q {
  font-size: 26rpx;
  color: var(--ink-100);
  font-weight: 500;
}
.qa-a {
  font-size: 22rpx;
  line-height: 1.7;
  color: var(--ink-80);
}

.foot {
  position: relative;
  z-index: 1;
  margin-top: 56rpx;
  text-align: center;
  font-size: 18rpx;
  color: var(--ink-20);
  letter-spacing: 0.22em;
  padding: 0 32rpx;
}
