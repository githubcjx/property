.page {
  min-height: 100vh;
  background-color: #000000;
  padding: 32rpx 32rpx 64rpx;
}

.head {
  background-color: #1C1C1E;
  border-radius: 32rpx;
  padding: 32rpx;
}
.head-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
}
.head-icon {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background-color: rgba(255, 255, 255, 0.10);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
}
.head-actions {
  display: flex;
  flex-direction: row;
  gap: 16rpx;
}
.icon-btn {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background-color: rgba(255, 255, 255, 0.10);
  display: flex;
  align-items: center;
  justify-content: center;
  color: #FFFFFF;
  font-size: 28rpx;
}
.head-icon .ic { width: 48rpx; height: 48rpx; }
.head-name {
  margin-top: 28rpx;
  font-size: 30rpx;
  color: rgba(235, 235, 245, 0.7);
}
.head-balance {
  margin-top: 8rpx;
  font-size: 72rpx;
  font-weight: 600;
  color: #FFFFFF;
  font-variant-numeric: tabular-nums;
  letter-spacing: -1rpx;
}

.ops {
  display: flex;
  flex-direction: row;
  gap: 16rpx;
  margin-top: 24rpx;
}
.ops-btn {
  flex: 1;
}

.tx-section {
  margin-top: 32rpx;
}
.tx-title {
  color: rgba(235, 235, 245, 0.5);
  font-size: 26rpx;
  padding: 8rpx 8rpx 16rpx;
}

.tx-list {
  background-color: #1C1C1E;
  border-radius: 32rpx;
  overflow: hidden;
}

.tx-row {
  position: relative;
  overflow: hidden;
}

.tx-delete-btn {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  width: 120rpx;
  background-color: #F87171;
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1;
}

.tx-item {
  position: relative;
  z-index: 2;
  background-color: #1C1C1E;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 28rpx;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.06);
  transition: transform 0.22s ease;
  will-change: transform;
}
.tx-row:last-child .tx-item { border-bottom: none; }
.tx-main {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  flex: 1;
  min-width: 0;
}
.tx-note {
  font-size: 28rpx;
  color: #FFFFFF;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.tx-time {
  font-size: 24rpx;
  color: rgba(235, 235, 245, 0.5);
}
.tx-amounts {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 6rpx;
  flex-shrink: 0;
  margin-left: 16rpx;
}
.tx-delta {
  font-size: 30rpx;
  font-weight: 500;
  font-variant-numeric: tabular-nums;
}
.tx-after {
  font-size: 22rpx;
  color: rgba(235, 235, 245, 0.4);
  font-variant-numeric: tabular-nums;
}

.empty {
  padding: 80rpx 32rpx;
  text-align: center;
}
.empty-emoji {
  display: block;
  font-size: 72rpx;
  margin-bottom: 16rpx;
}
.empty-desc {
  color: rgba(235, 235, 245, 0.5);
  font-size: 26rpx;
}
