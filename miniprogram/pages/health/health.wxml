<view class="canvas-bg theme-{{theme}}" wx:if="{{!reduceMotion}}"></view>

<view class="page {{reduceMotion ? 'no-motion' : ''}} theme-{{theme}}">
  <!-- 透明导航栏 -->
  <view class="navbar" style="padding-top: {{statusBarHeight}}px;">
    <view class="nav-btn tap" hover-class="nav-btn-hover" bindtap="onBack">
      <view class="ic ic-xs ic-back"></view>
    </view>
    <text class="nav-title">财务体检</text>
    <!-- <text class="nav-date">{{updateText}}</text> -->
  </view>

  <!-- 空态 -->
  <block wx:if="{{!loading && !hasData}}">
    <view class="empty-stage">
      <view class="empty-orb">
        <view class="ic ic-lg ic-health-pulse"></view>
      </view>
      <view class="empty-title">还没有账户数据</view>
      <view class="empty-desc">回到首页添加你的第一个账户，即可生成体检报告</view>
    </view>
  </block>

  <block wx:if="{{hasData}}">
    <scroll-view scroll-y class="scroll" enable-flex>

      <!-- Hero · 综合分 -->
      <view class="hero glass entry-up">
        <view class="hero-halo halo-{{overallStatus}}"></view>

        <view class="hero-grid">
          <view class="hero-left">
            <text class="hero-label">综合健康分</text>
            <text class="hero-status">{{overallHeadline}}</text>
            <text class="hero-desc">{{overallDesc}}</text>
          </view>

          <view class="ring-wrap">
            <view class="ring">
              <view class="ring-svg-host">
                <view class="ring-bg"></view>
                <view class="ring-fill" style="--score-deg: {{ringDeg}};"></view>
              </view>
              <view class="ring-center">
                <text class="ring-score">{{overallScore == null ? '--' : overallScore}}</text>
                <text class="ring-unit">/ 100</text>
              </view>
            </view>
          </view>
        </view>

        <view class="hero-foot">
          <view class="foot-item">
            <text class="foot-v num">{{totalsText.assets}}</text>
            <text class="foot-k">总资产</text>
          </view>
          <view class="foot-divider"></view>
          <view class="foot-item">
            <text class="foot-v num">{{totalsText.liabilities}}</text>
            <text class="foot-k">总负债</text>
          </view>
          <view class="foot-divider"></view>
          <view class="foot-item">
            <text class="foot-v num">{{totalsText.netWorth}}</text>
            <text class="foot-k">净资产</text>
          </view>
        </view>
      </view>

      <!-- Section title -->
      <view class="sec-title entry-up d1">
        <text class="sec-name">核心指标 · 6 项</text>
        <view class="sec-more tap" hover-class="sec-more-hover" bindtap="onSourceTap">
          <text>指标说明</text>
          <view class="ic ic-xs ic-info"></view>
        </view>
      </view>

      <!-- 6 项指标 -->
      <view class="grid">
        <view
          wx:for="{{metrics}}"
          wx:key="key"
          class="m-card glass entry-up d{{index + 2}} tap"
          hover-class="m-card-hover"
          data-key="{{item.key}}"
          bindtap="onMetricTap"
        >
          <view class="m-head">
            <text class="m-name">{{item.name}}</text>
            <view class="m-badge badge-{{item.status}}">
              <block wx:if="{{item.status === 'good'}}">健康</block>
              <block wx:if="{{item.status === 'warn'}}">关注</block>
              <block wx:if="{{item.status === 'alert'}}">偏离</block>
              <block wx:if="{{item.status === 'neutral'}}">参考</block>
            </view>
          </view>

          <text class="m-value num">{{item.valueText}}</text>

          <view class="m-gauge">
            <view class="m-gauge-fill fill-{{item.status}}" style="width: {{item.gaugePctText}}%;"></view>
            <view
              wx:if="{{item.markerPct != null}}"
              class="m-gauge-marker"
              style="left: {{item.markerPct}}%;"
            ></view>
          </view>

          <text class="m-source">{{item.sourceShort}}</text>
        </view>
      </view>

      <!-- 改善建议 -->
      <view class="sec-title entry-up">
        <text class="sec-name">改善建议</text>
      </view>

      <view class="advice glass entry-up">
        <view
          wx:for="{{advice}}"
          wx:key="title"
          class="advice-item"
        >
          <view class="advice-icon icon-{{item.severity}}">
            <text>{{item.iconText}}</text>
          </view>
          <view class="advice-body">
            <text class="advice-title">{{item.title}}</text>
            <text class="advice-desc">{{item.desc}}</text>
          </view>
        </view>
      </view>

      <!-- 晒一晒 -->
      <block wx:if="{{shareCard}}">
        <view class="share-cta tap" hover-class="share-cta-hover" bindtap="onShareTap">
          <view class="ic ic-sm ic-share-2"></view>
          <text class="share-cta-text">晒一晒我的体检成绩</text>
        </view>
        <view class="share-cta-hint">分享默认隐藏所有金额，只晒分数与等级</view>
      </block>

      <view class="foot-line tap" hover-class="foot-line-hover" bindtap="onSourceTap">
        指标参考 · 家庭财务指标 / 央行 2019 城镇家庭资产负债调查
      </view>

      <view class="bottom-spacer"></view>
    </scroll-view>
  </block>

  <!-- 分享面板 -->
  <share-sheet
    visible="{{shareVisible}}"
    card="{{shareCard}}"
    bind:posterready="onPosterReady"
    bind:close="onShareClose"
  ></share-sheet>

  <!-- ============ 底部上滑面板 ============ -->
  <view
    wx:if="{{sheetVisible}}"
    class="sheet-mask {{sheetClosing ? 'sheet-closing' : ''}}"
    catchtap="closeSheet"
    catchtouchmove="onSheetNoop"
  >
    <view class="sheet {{sheetClosing ? 'sheet-out' : 'sheet-in'}}" catchtap="onSheetNoop">
      <view class="sheet-handle"></view>

      <view class="sheet-head">
        <text class="sheet-title">{{sheet.title}}</text>
        <view class="sheet-close tap" hover-class="sheet-close-hover" catchtap="closeSheet">
          <view class="ic ic-xs ic-close"></view>
        </view>
      </view>

      <scroll-view scroll-y class="sheet-body" enhanced show-scrollbar="{{false}}">
        <!-- 单项指标 -->
        <block wx:if="{{sheet.kind === 'metric'}}">
          <view class="sheet-block">
            <text class="sheet-block-label">公式</text>
            <view class="sheet-formula">
              <text class="sheet-formula-text">{{sheet.formula}}</text>
            </view>
          </view>

          <view class="sheet-block">
            <text class="sheet-block-label">定义</text>
            <text class="sheet-block-text">{{sheet.definition}}</text>
          </view>

          <view class="sheet-block">
            <text class="sheet-block-label">来源</text>
            <text class="sheet-source-text">{{sheet.source}}</text>
          </view>
        </block>

        <!-- 全部来源说明 -->
        <block wx:if="{{sheet.kind === 'source'}}">
          <view class="sheet-block" wx:for="{{sheet.sourceLines}}" wx:key="*this">
            <text class="sheet-block-text">{{item}}</text>
          </view>
        </block>
      </scroll-view>
    </view>
  </view>
</view>
