.page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  position: relative;
  overflow: hidden;
}

/* ============ 透明导航栏 ============ */
.navbar {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 0 24rpx 16rpx;
  gap: 16rpx;
}
.nav-btn {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: var(--glass-1);
  border: 1rpx solid var(--hairline);
  display: flex;
  align-items: center;
  justify-content: center;
  -webkit-backdrop-filter: blur(20rpx);
  backdrop-filter: blur(20rpx);
  position: relative;
  z-index: 1;
}
.nav-btn-hover { background: var(--glass-3); transform: scale(0.96); }
.nav-title {
  position: absolute;
  left: 0; right: 0;
  font-size: 26rpx;
  font-weight: 500;
  color: var(--ink-100);
  text-align: center;
  letter-spacing: 0.5rpx;
}

/* ============ Scroll body ============ */
.scroll {
  flex: 1;
  padding: 12rpx 24rpx 0;
  box-sizing: border-box;
}

/* ============ 通用卡片 ============ */
.card {
  position: relative;
  padding: 32rpx;
  border-radius: 32rpx;
  margin-bottom: 24rpx;
  background: var(--glass-2);
  border: 1rpx solid var(--hairline);
  overflow: hidden;
}

/* ============ Section 标题 ============ */
.sec-title {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin: 8rpx 4rpx 16rpx;
}
.sec-name { font-size: 26rpx; font-weight: 600; color: var(--ink-100); }
.sec-sub { font-size: 22rpx; color: var(--ink-40); }

/* ============ 环图 ============ */
.donut-wrap {
  position: relative;
  width: 280rpx;
  height: 280rpx;
  margin: 8rpx auto 28rpx;
}
.donut {
  width: 100%;
  height: 100%;
  border-radius: 50%;
  /* background 由内联 conic-gradient 注入 */
}
.donut-hole {
  position: absolute;
  top: 50%; left: 50%;
  transform: translate(-50%, -50%);
  width: 196rpx;
  height: 196rpx;
  border-radius: 50%;
  background: var(--bg-1);
  border: 1rpx solid var(--hairline);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
}
.donut-k { font-size: 22rpx; color: var(--ink-60); }
.donut-v { font-size: 32rpx; font-weight: 600; color: var(--ink-100); }

/* ============ 图例 ============ */
.legend { display: flex; flex-direction: column; gap: 18rpx; }
.legend-row { display: flex; align-items: center; gap: 14rpx; }
.legend-dot { width: 18rpx; height: 18rpx; border-radius: 50%; flex-shrink: 0; }
.legend-name { font-size: 26rpx; color: var(--ink-80); flex: 1; }
.legend-pct { font-size: 24rpx; font-weight: 600; margin-right: 16rpx; }
.legend-amt { font-size: 26rpx; color: var(--ink-100); }

/* ============ 总计页脚 ============ */
.totals-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 28rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid var(--hairline);
}
.tf-item { flex: 1; display: flex; flex-direction: column; align-items: center; gap: 6rpx; }
.tf-v { font-size: 28rpx; font-weight: 600; color: var(--ink-100); }
.tf-k { font-size: 22rpx; color: var(--ink-60); }
.tf-divider { width: 1rpx; height: 48rpx; background: var(--hairline); }

/* ============ 关键比率 ============ */

/* ============ 集中度 ============ */
.conc { display: flex; align-items: center; gap: 20rpx; }
.conc-icon {
  width: 72rpx; height: 72rpx;
  border-radius: 20rpx;
  background: var(--glass-1);
  border: 1rpx solid var(--hairline);
  display: flex; align-items: center; justify-content: center;
  flex-shrink: 0;
}
.conc-body { flex: 1; display: flex; flex-direction: column; gap: 6rpx; }
.conc-name { font-size: 28rpx; color: var(--ink-100); }
.conc-sub { font-size: 22rpx; color: var(--ink-60); }
.conc-pct { font-size: 36rpx; font-weight: 700; }

/* ============ 注脚 ============ */
.note-line {
  font-size: 21rpx;
  color: var(--ink-40);
  line-height: 1.6;
  margin: 8rpx 8rpx 0;
}

/* ============ 大空态 ============ */
.empty-stage {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 0 64rpx;
  gap: 20rpx;
}
.empty-orb {
  width: 140rpx; height: 140rpx;
  border-radius: 50%;
  background: var(--glass-2);
  border: 1rpx solid var(--hairline);
  display: flex; align-items: center; justify-content: center;
}
.empty-title { font-size: 30rpx; color: var(--ink-100); font-weight: 600; }
.empty-desc { font-size: 24rpx; color: var(--ink-60); text-align: center; line-height: 1.6; }

/* ============ entry 动画 ============ */
.entry-up {
  animation: entryUp 0.5s cubic-bezier(0.22, 1, 0.36, 1) both;
}
@keyframes entryUp {
  from { opacity: 0; transform: translateY(24rpx); }
  to { opacity: 1; transform: translateY(0); }
}

.bottom-spacer { height: 80rpx; }
