.page {
  min-height: 100vh;
  padding: 0 32rpx 80rpx;
  position: relative;
  overflow: hidden;
}

/* ============ 透明 navbar（与 theme 页一致）============ */
.navbar {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding-bottom: 14rpx;
  position: relative;
  z-index: 5;
}
.nav-title {
  font-size: 26rpx;
  color: var(--ink-80);
  font-weight: 500;
  letter-spacing: 0.04em;
}
.nav-btn {
  width: 56rpx; height: 56rpx;
  border-radius: 50%;
  background: var(--glass-1);
  border: 1rpx solid var(--hairline);
  display: flex; align-items: center; justify-content: center;
  -webkit-backdrop-filter: blur(20rpx);
  backdrop-filter: blur(20rpx);
}
.nav-btn-hover { background: var(--glass-3); transform: scale(0.95); }
.nav-spacer { width: 56rpx; }

.rt-hint {
  margin: 8rpx 0 24rpx;
  padding: 24rpx 26rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: var(--ink-80);
  background: rgba(var(--accent-rgb), 0.08);
  border: 1rpx solid rgba(var(--accent-rgb), 0.26);
}

.rt-list {
  margin: 0;
  border-radius: 24rpx;
  background: var(--glass-1);
  border: 1rpx solid var(--hairline);
  overflow: hidden;
}

.rt-row {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 26rpx 28rpx;
  border-bottom: 1rpx solid var(--hairline);
}
.rt-row:last-child { border-bottom: none; }

.rt-sym {
  width: 60rpx;
  height: 60rpx;
  flex: 0 0 60rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 800;
  color: var(--ink-80);
  background: var(--glass-2);
  border: 1rpx solid var(--hairline-hi);
}

.rt-info { flex: 1; }
.rt-code { font-size: 28rpx; font-weight: 700; color: var(--ink-100); }

.rt-rate { text-align: right; display: flex; flex-direction: column; gap: 2rpx; }
.rt-val { font-size: 30rpx; font-weight: 800; color: var(--ink-100); }
.rt-unit { font-size: 22rpx; color: var(--ink-60); }

.rt-foot {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  margin-top: 28rpx;
  font-size: 22rpx;
  color: var(--ink-40);
}
.rt-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: var(--good, #9ee6c1);
  box-shadow: 0 0 12rpx var(--good, #9ee6c1);
}
.rt-next { margin-top: 12rpx; }
