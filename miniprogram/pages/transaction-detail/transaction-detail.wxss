.page {
  min-height: 100vh;
  padding: 0 32rpx 64rpx;
  position: relative;
  overflow: hidden;
}
.tx-halo {
  position: absolute;
  top: -40rpx; left: 50%;
  transform: translateX(-50%);
  width: 680rpx; height: 680rpx;
  filter: blur(56rpx);
  animation: pulse-glow 7s ease-in-out infinite;
  pointer-events: none;
  z-index: 0;
}

.navbar {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding: 0 4rpx 14rpx;
  position: relative;
  z-index: 5;
}
.nav-btn {
  width: 56rpx; height: 56rpx;
  border-radius: 50%;
  background: var(--glass-1);
  border: 1rpx solid var(--hairline);
  display: flex; align-items: center; justify-content: center;
}
.nav-btn-hover { background: var(--glass-3); transform: scale(0.95); }
.nav-spacer { width: 56rpx; }
.nav-title { font-size: 26rpx; color: var(--ink-80); font-weight: 500; }

.hero {
  text-align: center;
  padding: 36rpx 0 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
  z-index: 1;
}
.hero-orb {
  width: 144rpx; height: 144rpx;
  border-radius: 36rpx;
  display: flex; align-items: center; justify-content: center;
  animation: drift-icon 5s ease-in-out infinite;
}
.hero-orb .ic { width: 64rpx; height: 64rpx; }
.hero-name {
  margin-top: 28rpx;
  font-size: 32rpx;
  color: var(--ink-100);
  font-weight: 500;
}
.hero-type {
  font-size: 20rpx;
  letter-spacing: 0.18em;
  margin-top: 6rpx;
}

.hero-amount {
  display: flex;
  align-items: baseline;
  justify-content: center;
  padding: 28rpx 0 8rpx;
  font-weight: 200;
  letter-spacing: -2rpx;
  font-variant-numeric: tabular-nums;
  position: relative;
  z-index: 1;
}
.hero-amount .amt-sign { font-size: 72rpx; margin-right: 6rpx; }
.hero-amount .amt-prefix { font-size: 48rpx; opacity: 0.6; margin-right: 6rpx; }
.hero-amount .amt-int { font-size: 100rpx; }
.hero-amount .amt-frac { font-size: 48rpx; opacity: 0.6; margin-left: 4rpx; }

.hero-after {
  display: block;
  text-align: center;
  font-size: 22rpx;
  color: var(--ink-40);
  position: relative;
  z-index: 1;
}

.info {
  margin: 56rpx 4rpx 0;
  border-radius: 28rpx;
  overflow: hidden;
  position: relative;
  z-index: 1;
}
.info-row {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  padding: 26rpx 28rpx;
  border-bottom: 1rpx solid var(--hairline);
  gap: 24rpx;
}
.info-row.last { border-bottom: none; }
.info-label {
  color: var(--ink-40);
  font-size: 24rpx;
  flex-shrink: 0;
}
.info-value {
  color: var(--ink-100);
  font-size: 26rpx;
  text-align: right;
  flex: 1;
  word-break: break-all;
}
