<view class="canvas-bg theme-{{theme}}" wx:if="{{!reduceMotion}}"></view>

<view class="page {{reduceMotion ? 'no-motion' : ''}} theme-{{theme}}">
  <!-- 透明导航栏 -->
  <view class="navbar" style="padding-top: {{statusBarHeight}}px;">
    <view class="nav-btn tap" hover-class="nav-btn-hover" bindtap="onClose">
      <view class="ic ic-xs {{phase === 'wizard' && !empty && !loading ? 'ic-close' : 'ic-back'}}"></view>
    </view>
    <text class="nav-title">盘点</text>
  </view>

  <!-- 加载 / 空态 -->
  <view wx:if="{{loading}}" class="state-hint">正在加载账户…</view>
  <view wx:elif="{{empty}}" class="state-hint">还没有账户数据，先去首页添加账户吧</view>

  <!-- ============ 盘点进行中 ============ -->
  <block wx:elif="{{phase === 'wizard' && cur}}">
    <view class="wiz-meta">
      <text class="wiz-counter num">{{idx + 1}} / {{total}}</text>
      <text class="wiz-group">{{cur.groupName}} · 第 {{cur.groupIndex}} 个，共 {{cur.groupCount}} 个</text>
    </view>
    <view class="wiz-bar"><view class="wiz-fill" style="width: {{progressPct}}%;"></view></view>

    <view class="wiz-card glass entry-up">
      <view class="wiz-orb cat-tint-{{cur.colorClass}}">
        <view class="ic ic-lg ic-{{cur.icon}}"></view>
      </view>
      <view class="wiz-name">
        <text>{{cur.name}}</text>
        <text wx:if="{{cur.currency !== 'CNY'}}" class="wiz-ccy">{{cur.currency}}</text>
      </view>
      <view class="wiz-lab">{{cur.isDebt ? '记录中的欠款' : '记录中的余额'}}</view>
      <view class="wiz-bal {{cur.isDebt ? 'is-debt' : ''}} num">{{hideAmount ? cur.symbol + ' ••••' : cur.balanceText}}</view>
      <view wx:if="{{cur.checkedToday}}" class="wiz-fresh is-today">✓ 今天已核对</view>
      <view wx:elif="{{cur.freshAgo}}" class="wiz-fresh {{cur.freshStale ? 'is-stale' : ''}}">上次核对 {{cur.freshAgo}}</view>
      <view class="wiz-ask">和你现在看到的{{cur.isDebt ? '欠款' : '余额'}}一致吗？</view>
    </view>

    <view class="wiz-actions">
      <view class="wiz-btn primary tap {{submitting ? 'is-busy' : ''}}" hover-class="wiz-btn-hover" bindtap="onConfirmSame">一致，确认</view>
      <view class="wiz-btn ghost tap" hover-class="wiz-btn-hover" bindtap="onOpenEdit">不一致，改成新{{cur.isDebt ? '欠款' : '余额'}}</view>
      <view class="wiz-hint">确认只记录核对时间，不会产生变动记录</view>
      <view class="wiz-sub">
        <text class="wiz-link {{idx === 0 ? 'is-disabled' : ''}}" bindtap="onPrev">‹ 上一个</text>
        <text class="wiz-link" bindtap="onSkip">跳过 ›</text>
      </view>
    </view>
  </block>

  <!-- ============ 完成页 ============ -->
  <block wx:elif="{{phase === 'done'}}">
    <scroll-view scroll-y class="scroll" enable-flex>
      <view class="done">
        <!-- 完成确认：退到最小，不与主角争 -->
        <view class="done-confirm entry-up"><text class="dc-tick">✓</text> 盘点完成</view>

        <!-- HERO · 唯一主角：这次你的净值动了多少 -->
        <view class="hero-eyebrow entry-up d1">{{heroEyebrow}}</view>
        <view class="hero-big {{heroMode}} entry-up d1">
          <text class="num">{{hideAmount ? heroBigMasked : heroBig}}</text>
        </view>
        <view class="hero-sub entry-up d2">{{heroSub}}</view>
        <view wx:if="{{heroNetShow}}" class="hero-net entry-up d2">现在 <text class="num">{{hideAmount ? baseSymbol + ' ••••' : netText}}</text></view>
        <view wx:if="{{skipNote}}" class="hero-foot entry-up d2">{{skipNote}}</view>

        <!-- 过程：压成一行安静的小字 -->
        <view class="done-line entry-up d2">{{doneLine}}</view>

        <!-- 小树长大了：只在真的升级时出现。不升级就不占位 —— 它是事件，不是家具。
             文案一律回望（走过多久、更新过多少次），绝不写「再更新 N 次就…」：
             把进度摆成任务，会有人为了刷树而记假账（数据诚实，见 CLAUDE.md 不变量 10）。 -->
        <view wx:if="{{treeGrew}}" class="done-tree entry-up d2">
          <canvas type="2d" id="doneTree" class="done-tree-canvas"></canvas>
          <view class="done-tree-txt">
            <view class="done-tree-t">小树长大了</view>
            <view class="done-tree-s">{{treeName}} · 相伴 {{treeDays}} 天，更新过 {{treeUpdates}} 次</view>
          </view>
        </view>

        <!-- 目标进度：盘点的回报 -->
        <view wx:if="{{goal.hasGoal}}" class="done-goal tap entry-up d3" hover-class="btn-hover" bindtap="onOpenGoal">
          <view class="dg-top">
            <view class="dg-ico"><view class="ic ic-xs ic-flag"></view></view>
            <text class="dg-name">{{goal.name}}</text>
            <text class="dg-pct num">{{goal.pctText}}%</text>
          </view>
          <view class="dg-bar"><view class="dg-fill" style="width: {{goal.pct}}%;"></view></view>
          <view class="dg-sub">
            <block wx:if="{{goal.achieved}}">已达成，去看看 →</block>
            <block wx:else>还差 {{hideAmount ? '••••' : goal.remainingText}} · 看预计达成时间 →</block>
          </view>
        </view>
        <view wx:else class="done-goal-empty tap entry-up d3" hover-class="btn-hover" bindtap="onOpenGoal">
          设一个目标，让每次盘点都有奔头 →
        </view>

        <view class="done-remind entry-up d4 {{remindState === 'soon' ? 'is-soon' : ''}} {{remindState === 'on' ? 'is-on' : ''}}"
              hover-class="{{remindState === 'off' ? 'btn-hover' : ''}}" bindtap="onSubscribeTap">
          <view class="done-remind-ico"><view class="ic ic-sm ic-bell"></view></view>
          <view class="done-remind-txt">
            <view class="done-remind-t">下月初提醒我盘点</view>
            <view class="done-remind-s">
              <block wx:if="{{remindState === 'on'}}">下月 1 日发微信服务通知给你</block>
              <block wx:elif="{{remindState === 'soon'}}">微信服务通知，正在开发中</block>
              <block wx:else>微信服务通知 · 每次盘点后需重新订阅</block>
            </view>
          </view>
          <text wx:if="{{remindState === 'soon'}}" class="done-remind-soon">即将上线</text>
          <text wx:elif="{{remindState === 'on'}}" class="done-remind-done">已订阅</text>
          <text wx:else class="done-remind-go">订阅 ›</text>
        </view>

        <view class="done-cta tap entry-up d4" hover-class="wiz-btn-hover" bindtap="onDone">完成</view>
        <view class="tail-space"></view>
      </view>
    </scroll-view>
  </block>

  <!-- 退出确认（玻璃弹窗） -->
  <view wx:if="{{quitVisible}}" class="quit-mask" catchtap="onQuitContinue">
    <view class="quit-card glass" catchtap="noop">
      <view class="quit-title">结束本次盘点？</view>
      <view class="quit-sub">已确认的 {{quitCount}} 个账户都已保存，剩下的下次可以接着盘。</view>
      <view class="quit-actions">
        <view class="quit-btn tap" hover-class="btn-hover" catchtap="onQuitContinue">继续盘点</view>
        <view class="quit-btn primary tap" hover-class="btn-hover" catchtap="onQuitEnd">结束</view>
      </view>
    </view>
  </view>
</view>

<!-- 改余额半屏（复用账户详情同款组件） -->
<amount-input
  id="ai"
  visible="{{showInput}}"
  mode="set"
  account-name="{{cur.name}}"
  account-icon="{{cur.icon}}"
  account-icon-key="{{cur.icon}}"
  category-class="{{cur.colorClass}}"
  category-rgb="{{inputRgb}}"
  current-balance-fen="{{cur.balance}}"
  current-balance-text="{{cur.balanceText}}"
  currency="{{cur.currency}}"
  currency-symbol="{{cur.symbol}}"
  reduce-motion="{{reduceMotion}}"
  bindcancel="onInputCancel"
  bindconfirm="onInputConfirm"
/>
