<view class="canvas-bg theme-{{theme}}"></view>

<view class="page theme-{{theme}}">
  <!-- 透明导航栏 -->
  <view class="navbar" style="padding-top: {{statusBarHeight}}px;">
    <view class="nav-btn tap" hover-class="nav-btn-hover" bindtap="onClose">
      <view class="ic ic-xs {{phase === 'list' && !empty && !loading ? 'ic-close' : 'ic-back'}}"></view>
    </view>
    <text class="nav-title">{{navTitle}}</text>
  </view>

  <!-- 加载 / 空态 -->
  <view wx:if="{{loading}}" class="state-hint">正在加载账户…</view>
  <!-- 空态。只有固定资产的用户（比如只记了一套房）盘点列表是空的，
       这时不能只丢一句「没有账户」，要把「去重新估个价」这条出路给出来。 -->
  <block wx:elif="{{empty}}">
    <view class="state-hint">
      <block wx:if="{{scope === 'fixed'}}">还没有固定资产账户</block>
      <block wx:elif="{{fixed.count}}">没有需要每月核对的账户 —— 你记的都是长期资产</block>
      <block wx:else>还没有账户数据，先去首页添加账户吧</block>
    </view>
    <view wx:if="{{scope === 'moving' && fixed.count}}" class="inv-empty-fixed">
      <view class="inv-fixed {{fixed.due ? 'is-due' : ''}} tap" hover-class="btn-hover" bindtap="onOpenFixed">
        <view class="inv-fixed-ico"><view class="ic ic-xs ic-house"></view></view>
        <view class="inv-fixed-txt">
          <view class="inv-fixed-t">固定资产 {{fixed.count}} 项</view>
          <view class="inv-fixed-s">{{fixed.agoText}}{{fixed.agoText ? ' · ' : ''}}去重新估个价</view>
        </view>
        <view class="ic ic-xs ic-chevron-right inv-fixed-go"></view>
      </view>
    </view>
  </block>

  <!-- ============ 一屏列表：默认「没变」，只点要改的 ============ -->
  <block wx:elif="{{phase === 'list'}}">
    <view class="inv-lead">{{leadText}}</view>

    <scroll-view scroll-y class="scroll" enable-flex>
      <view class="inv-list">
        <view
          wx:for="{{rows}}"
          wx:key="_id"
          class="inv-row {{item.newBalance !== null ? 'is-edited' : ''}} {{item.failed ? 'is-failed' : ''}} tap entry-up"
          data-id="{{item._id}}"
          hover-class="inv-row-hover"
          bindtap="onRowTap"
        >
          <view class="inv-orb cat-tint-{{item.colorClass}}">
            <view class="ic ic-sm ic-{{item.icon}}"></view>
          </view>
          <view class="inv-main">
            <view class="inv-name">
              <text>{{item.name}}</text>
              <text wx:if="{{item.currency !== 'CNY'}}" class="inv-ccy">{{item.currency}}</text>
            </view>
            <view wx:if="{{item.failed}}" class="inv-fresh is-failed">没存上</view>
            <view wx:elif="{{item.freshText}}" class="inv-fresh {{item.freshStale ? 'is-stale' : ''}}">{{item.freshText}}</view>
          </view>
          <view class="inv-val">
            <view class="inv-amt {{item.isDebt ? 'is-debt' : ''}} num">
              {{hideAmount ? item.symbol + ' ••••' : (item.newBalance !== null ? item.newBalanceText : item.balanceText)}}
            </view>
            <view wx:if="{{item.deltaText}}" class="inv-delta {{item.deltaPositive ? 'is-up' : 'is-down'}} num">
              {{hideAmount ? '••••' : item.deltaText}}
            </view>
            <view wx:elif="{{item.newBalance !== null}}" class="inv-delta is-same">没变</view>
          </view>
        </view>

        <!-- 固定资产：不是流程的一步，只是一扇安静的门。
             房子和车的节奏是「一年看一次」，把它们排进月度核对列表，
             等于让一年不动的东西去拖慢每月都动的（见 services/inventory.js splitByScope）。 -->
        <view
          wx:if="{{scope === 'moving' && fixed.count}}"
          class="inv-fixed {{fixed.due ? 'is-due' : ''}} tap"
          hover-class="btn-hover"
          bindtap="onOpenFixed"
        >
          <view class="inv-fixed-ico"><view class="ic ic-xs ic-house"></view></view>
          <view class="inv-fixed-txt">
            <view class="inv-fixed-t">固定资产 {{fixed.count}} 项</view>
            <view class="inv-fixed-s">{{fixed.agoText}}{{fixed.agoText ? ' · ' : ''}}不用每月核对</view>
          </view>
          <view class="ic ic-xs ic-chevron-right inv-fixed-go"></view>
        </view>

        <view class="tail-space"></view>
      </view>
    </scroll-view>

    <!-- 底部：一个按钮。没改过就是「N 项都对，完成」，一次点击结束 -->
    <view class="inv-foot">
      <view class="inv-cta tap {{failedCount ? 'is-retry' : ''}} {{submitting ? 'is-busy' : ''}}"
            hover-class="wiz-btn-hover" bindtap="onSubmit">
        <block wx:if="{{submitting}}">正在保存…</block>
        <block wx:elif="{{failedCount}}">重试 {{failedCount}} 项</block>
        <block wx:elif="{{editedCount}}">完成盘点 · 改了 {{editedCount}} 项</block>
        <block wx:else>{{rows.length}} 项都对，完成</block>
      </view>
      <view class="inv-foot-note {{failedCount ? 'is-err' : ''}}">
        <block wx:if="{{failedCount}}">{{rows.length - failedCount}} 项已保存，这 {{failedCount}} 项没存上</block>
        <block wx:else>没改的账户记为「已核对，未变动」</block>
      </view>
    </view>
  </block>

  <!-- ============ 完成页 ============ -->
  <block wx:elif="{{phase === 'done'}}">
    <scroll-view scroll-y class="scroll" enable-flex>
      <view class="done">
        <!-- HERO · 一个东西，不是四张卡片。
             这次动了多少（数字）与你坚持了多久（树）合成一幅画：数字在上，树在下，
             一竖列读下来 —— 树是这个数字的来处。V3.1 之前它们是并列的两张卡，
             四个等重的框摆在一起，眼睛不知道该看哪个，于是哪个都不是主角。

             与上次的比对要等回算完，没算完就先占位空着 —— 宁可空一下，
             也不先亮一个待会儿要被改写的数字（那是改口，不是加载）。
             树的 canvas 也在这个 block 里，所以必须等 heroReady 后再画，
             否则 selectorQuery 取不到节点（见 inventory.js _maybeDrawTree）。 -->
        <block wx:if="{{heroReady}}">
          <view class="hero-eyebrow entry-up d1">{{heroEyebrow}}</view>
          <view class="hero-big {{heroMode}} {{heroBigLong ? 'is-long' : ''}} entry-up d1">
            <text class="num">{{hideAmount ? heroBigMasked : heroBig}}</text>
          </view>
          <view class="hero-sub entry-up d2">{{heroSub}}</view>

          <!-- 小树：每次盘点都露一面，只有这次真跨了阶段线才播生长动画（is-grew）。
               文案一律回望（走过多久、更新过多少次），绝不写「再更新 N 次就…」：
               把进度摆成任务，会有人为了刷树而记假账（数据诚实，见 CLAUDE.md 不变量 10）。 -->
          <canvas wx:if="{{treeShow}}" type="2d" id="doneTree"
                  class="hero-tree entry-up d2 {{treeGrew ? 'is-grew' : ''}}"></canvas>

          <view wx:if="{{heroNetShow}}" class="hero-net entry-up d3">现在 <text class="num">{{hideAmount ? baseSymbol + ' ••••' : netText}}</text></view>
          <view wx:if="{{treeShow}}" class="hero-treeline entry-up d3">相伴 {{treeDays}} 天 · 更新过 {{treeUpdates}} 次</view>
          <view wx:if="{{treeGrew}}" class="hero-grew entry-up d3">小树长大了 · {{treeName}}</view>
          <view wx:if="{{skipNote}}" class="hero-foot entry-up d3">{{skipNote}}</view>
        </block>
        <!-- 占位高度与成稿主角一致，落地时下面的内容不跳 -->
        <view wx:else class="hero-hold"><view class="hero-skel"></view></view>

        <!-- 上月小结：只在每月前几天出现（一年 36 天，其余时间这里是空的）。
             它刻意长在「做完之后」而不是首页门口 —— 月初那条订阅消息把人叫回来是为了盘点，
             在他动手之前拦一道「看小结」，等于用自己唯一的推送额度把人引向别处
             （首页月报横幅已于 V3.0 删除，别加回去）。 -->
        <view wx:if="{{reportRow}}" class="done-report tap entry-up d4" hover-class="btn-hover" bindtap="onOpenReport">
          <view class="dr-ico"><view class="ic ic-xs ic-report"></view></view>
          <view class="dr-txt">
            <view class="dr-t">{{reportLabel}}小结已生成</view>
            <view class="dr-s">看看上个月是谁在推动</view>
          </view>
          <view class="ic ic-xs ic-chevron-right dr-go"></view>
        </view>

        <!-- 底部：订阅是主路径，不是一张可点的卡。
             微信一次性订阅「同意一次、发一次」，每次盘点完不重新引导，下个月的循环就断了 ——
             而这条循环是这个一月一见的产品唯一的回访来源。标签写清楚会发生什么，
             点下去弹的是微信自己的授权框（仍可拒绝），旁边永远留着一条安静的「只完成」。
             文案与是否显示次要按钮由 remindState 决定，见 inventory.js _applyCta。 -->
        <block wx:if="{{ctaReady}}">
          <view class="done-cta tap entry-up d4 {{remindBusy ? 'is-busy' : ''}}"
                hover-class="wiz-btn-hover" bindtap="onPrimaryTap">{{ctaText}}</view>
          <view wx:if="{{ctaWhy}}" class="done-cta-why entry-up d4">{{ctaWhy}}</view>
          <view wx:if="{{ctaPlain}}" class="done-cta-plain tap entry-up d4"
                hover-class="btn-hover" bindtap="onDone">只完成</view>
        </block>
        <view class="tail-space"></view>
      </view>
    </scroll-view>
  </block>

  <!-- 退出确认（玻璃弹窗）。改动只在本地，走到这里说明还没提交过 ——
       点遮罩 = 继续，两个按钮分别是「丢掉」与「存下来」。 -->
  <view wx:if="{{quitVisible}}" class="quit-mask" catchtap="onQuitContinue">
    <view class="quit-card glass" catchtap="noop">
      <view class="quit-title">还有 {{touchedCount}} 项没保存</view>
      <view class="quit-sub">现在离开，这几处改动会丢掉。</view>
      <view class="quit-actions">
        <view class="quit-btn tap" hover-class="btn-hover" catchtap="onQuitDiscard">不保存，退出</view>
        <view class="quit-btn primary tap" hover-class="btn-hover" catchtap="onQuitSave">保存并完成</view>
      </view>
    </view>
  </view>
</view>

<!-- 改余额半屏（复用账户详情同款组件）。确认只改本地，落库统一在 onSubmit -->
<amount-input
  id="ai"
  visible="{{showInput}}"
  mode="set"
  account-name="{{editing.name}}"
  account-icon="{{editing.icon}}"
  account-icon-key="{{editing.icon}}"
  category-class="{{editing.colorClass}}"
  category-rgb="{{inputRgb}}"
  current-balance-fen="{{editing.balance}}"
  current-balance-text="{{editing.balanceText}}"
  currency="{{editing.currency}}"
  currency-symbol="{{editing.symbol}}"
  bindcancel="onInputCancel"
  bindconfirm="onInputConfirm"
/>
