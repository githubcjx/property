.page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  position: relative;
  overflow: hidden;
}

/* ============ 透明导航栏 ============ */
.navbar {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 0 24rpx 16rpx;
  gap: 16rpx;
}
.nav-btn {
  width: 64rpx; height: 64rpx; border-radius: 50%;
  background: var(--glass-1); border: 1rpx solid var(--hairline);
  display: flex; align-items: center; justify-content: center;
  -webkit-backdrop-filter: blur(20rpx); backdrop-filter: blur(20rpx);
  position: relative; z-index: 1;
}
.nav-btn-hover { background: var(--glass-3); transform: scale(0.96); }
.nav-title {
  position: absolute; left: 0; right: 0;
  font-size: 26rpx; font-weight: 500; color: var(--ink-100);
  text-align: center; letter-spacing: 0.5rpx;
}
.btn-hover { opacity: 0.75; transform: scale(0.96); }

.state-hint { margin-top: 120rpx; text-align: center; font-size: 26rpx; color: var(--ink-60); }

/* ============ 一屏列表 ============ */
.inv-lead {
  padding: 4rpx 44rpx 20rpx;
  text-align: center; font-size: 22rpx; color: var(--ink-40); line-height: 1.6;
}

.inv-list { padding-top: 4rpx; }

/* 一行 = 一个账户。默认即「没变」，点它才进入编辑 —— 所以整行可点，
   不再给每行配一个确认按钮（那等于把 15 次点击换个地方摆）。 */
.inv-row {
  display: flex; align-items: center; gap: 20rpx;
  padding: 26rpx 24rpx;
  margin-bottom: 16rpx;
  border-radius: 28rpx;
  background: var(--glass-1);
  border: 1rpx solid var(--hairline);
  transition: border-color 0.2s ease, background 0.2s ease;
}
.inv-row-hover { transform: scale(0.99); opacity: 0.85; }
.inv-row.is-edited {
  border-color: rgba(var(--good-rgb), 0.34);
  background: rgba(var(--good-rgb), 0.06);
}
.inv-row.is-failed {
  border-color: rgba(var(--debt-rgb), 0.5);
  background: rgba(var(--debt-rgb), 0.07);
}

.inv-orb {
  width: 68rpx; height: 68rpx; flex: 0 0 68rpx; border-radius: 22rpx;
  display: flex; align-items: center; justify-content: center;
}
.inv-main { flex: 1; min-width: 0; }
.inv-name {
  display: flex; align-items: center; gap: 10rpx;
  font-size: 28rpx; font-weight: 600; color: var(--ink-100);
}
.inv-ccy {
  font-size: 18rpx; font-weight: 500; color: var(--ink-60);
  border: 1rpx solid var(--hairline-hi); border-radius: 6rpx;
  padding: 0 8rpx;
}
.inv-fresh { margin-top: 6rpx; font-size: 20rpx; color: var(--ink-40); }
.inv-fresh.is-stale { color: var(--warn); }
.inv-fresh.is-failed { color: var(--debt); font-weight: 700; }

.inv-val { flex: 0 0 auto; text-align: right; max-width: 300rpx; }
.inv-amt { font-size: 30rpx; font-weight: 700; color: var(--ink-100); letter-spacing: 0.4rpx; }
.inv-amt.is-debt { color: var(--debt); }
.inv-delta { margin-top: 6rpx; font-size: 20rpx; font-weight: 700; }
.inv-delta.is-up { color: var(--good); }
.inv-delta.is-down { color: var(--debt); }
.inv-delta.is-same { color: var(--ink-40); font-weight: 400; }

/* 固定资产：虚线区分「这不是流程的一步」，只是一扇门 */
.inv-fixed {
  display: flex; align-items: center; gap: 18rpx;
  margin-top: 8rpx; padding: 22rpx 24rpx;
  border-radius: 28rpx;
  border: 1rpx dashed var(--hairline-hi);
}
.inv-fixed.is-due {
  border-color: rgba(var(--warn-rgb), 0.42);
  background: rgba(var(--warn-rgb), 0.05);
}
.inv-fixed-ico {
  width: 56rpx; height: 56rpx; flex: 0 0 56rpx; border-radius: 18rpx;
  display: flex; align-items: center; justify-content: center;
  background: rgba(var(--fixed-rgb), 0.14); color: var(--fixed);
}
.inv-fixed.is-due .inv-fixed-ico { background: rgba(var(--warn-rgb), 0.16); color: var(--warn); }
.inv-fixed-txt { flex: 1; min-width: 0; }
.inv-fixed-t { font-size: 24rpx; font-weight: 700; color: var(--ink-80); }
.inv-fixed-s { margin-top: 4rpx; font-size: 20rpx; color: var(--ink-40); }
.inv-fixed.is-due .inv-fixed-s { color: var(--warn); }
.inv-fixed-go { color: var(--ink-40); flex: 0 0 auto; }

/* 空态里的固定资产出路 */
.inv-empty-fixed { margin: 40rpx 32rpx 0; }

/* ============ 底部：一个按钮 ============ */
.inv-foot {
  flex: 0 0 auto;
  padding: 20rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid var(--hairline);
}
.inv-cta {
  height: 104rpx; border-radius: 32rpx;
  display: flex; align-items: center; justify-content: center;
  font-size: 30rpx; font-weight: 700;
  background: rgba(var(--good-rgb), 0.16);
  border: 1rpx solid rgba(var(--good-rgb), 0.45);
  color: var(--good);
  box-shadow: 0 12rpx 36rpx rgba(var(--good-rgb), 0.12);
}
.inv-cta.is-retry {
  background: rgba(var(--debt-rgb), 0.16);
  border-color: rgba(var(--debt-rgb), 0.45);
  color: var(--debt);
  box-shadow: none;
}
.inv-cta.is-busy { opacity: 0.55; }
.inv-foot-note {
  margin-top: 16rpx; text-align: center;
  font-size: 20rpx; color: var(--ink-40);
}
.inv-foot-note.is-err { color: var(--debt); }

/* 按下反馈：列表底部 CTA 与完成页的 .done-cta 共用 */
.wiz-btn-hover { transform: scale(0.98); opacity: 0.85; }

/* ============ 完成页 ============ */
.scroll { flex: 1; padding: 8rpx 32rpx 0; box-sizing: border-box; }
.tail-space { height: 64rpx; }

.done { display: flex; flex-direction: column; align-items: center; padding-top: 72rpx; }

/* ============ HERO · 唯一主角：这次净值动了多少 ============ */
/* 全系统唯一的一处「抬升」：主角数字的光晕（涨/起点才发光，跌不庆祝） */
.hero-eyebrow { margin-top: 56rpx; font-size: 24rpx; letter-spacing: 2rpx; color: var(--ink-60); }
/* V3.1：主角字号从 80 提到 112rpx（原型 B 的比例）。树进来之后，
   80rpx 的数字压不住一棵 400rpx 的树，主角会被自己的陪衬盖过去。 */
.hero-big {
  margin-top: 18rpx; padding: 0 16rpx;
  display: flex; align-items: center; justify-content: center;
  font-size: 112rpx; font-weight: 800; letter-spacing: -2rpx; line-height: 1.05;
}
/* 长金额（如 −¥12,345,678）在 112rpx 下会顶破 750rpx 屏宽，降一档。
   字号由 JS 按字符数决定（WXSS 没有 auto-fit），见 inventory.js heroBigLong。 */
.hero-big.is-long { font-size: 84rpx; letter-spacing: -1rpx; }
.hero-big.gain { color: var(--good); text-shadow: 0 0 60rpx rgba(var(--good-rgb), 0.45); }
.hero-big.baseline { color: var(--accent); text-shadow: 0 0 60rpx rgba(var(--accent-rgb), 0.40); }
.hero-big.loss { color: var(--debt); }   /* 跌不加光晕：只用语义红，平静呈现 */

.hero-sub {
  margin-top: 26rpx; padding: 0 32rpx;
  font-size: 24rpx; color: var(--ink-60); line-height: 1.6; text-align: center;
}
.hero-net { margin-top: 18rpx; font-size: 26rpx; color: var(--ink-80); }
.hero-foot {
  margin-top: 22rpx; padding: 0 24rpx;
  font-size: 22rpx; color: var(--warn); line-height: 1.6; text-align: center;
}

/* 主角待定时的占位：高度对齐成稿主角，这样主角落地时下面的内容一行都不动
   —— 不改口，也不跳版。V3.1 树并进了主角，占位要跟着长高：
   眉标 56+34 / 数字 18+118 / 副文 26+38 / 树 4+400−12 / 现在 18+36 / 陪伴 14+30 ≈ 780。
   （占位只在「有上次盘点、正在回算」时出现，那条路径必定带「现在 ¥X」一行。） */
.hero-hold {
  height: 780rpx;
  display: flex; align-items: flex-start; justify-content: center;
}
.hero-skel {
  margin-top: 108rpx;
  width: 300rpx; height: 84rpx; border-radius: 26rpx;
  background: linear-gradient(180deg, rgba(var(--accent-rgb), 0.16), rgba(var(--accent-rgb), 0.06));
  animation: glow-soft 1.6s ease-in-out infinite;
}

/* 小树：不再是主角下面的第二张卡，而是主角的一部分（V3.1）。
   数字在上、树在下、小字收在树脚 —— 一竖列读下来是一幅画，不是两个格子。
   没有卡片底、没有描边：一旦给它一个框，它就又变回一个并列的模块了。 */
/* 画布 540 而树只画 400（drawStage 传 pad:0.13）：多出来的一圈是给树冠外发光的。
   铺满画布时那圈光会被画布边界裁成一条直边 —— 树越大越明显。
   负外边距把这圈透明留白从版面里减回去，所以视觉间距仍是「树 400rpx」时的样子：
   上 4 − 70 = −66，下 −12 − 70 = −82。改画布尺寸时这两个数要跟着重算。 */
.hero-tree {
  width: 540rpx; height: 540rpx;
  margin: -66rpx auto -82rpx;
  display: block;
}
/* 跨线庆祝：这一次才在树脚打一圈强调色地光（动画每次都播，徽标与地光才是"长大了"的信号）。 */
.hero-tree.is-grew {
  filter: drop-shadow(0 6rpx 40rpx rgba(var(--accent-rgb), 0.35));
}
/* 陪伴的小字：一律回望（走过多久、更新过多少次），绝不写「再更新 N 次就…」，
   理由见 utils/growthTree.js —— 把进度摆成任务，就会有人为了刷树记假账。 */
.hero-treeline { margin-top: 14rpx; font-size: 22rpx; color: var(--ink-40); }
.hero-grew {
  margin-top: 16rpx; padding: 6rpx 22rpx;
  font-size: 22rpx; font-weight: 700; letter-spacing: 1rpx;
  color: var(--ink-100);
  background: rgba(var(--accent-rgb), 0.16);
  border: 1rpx solid rgba(var(--accent-rgb), 0.32);
  border-radius: 999rpx;
}

/* ============ 完成页 · 上月小结入口（每月前 3 天）============ */
.done-report {
  width: 100%; box-sizing: border-box;
  margin-top: 48rpx; padding: 20rpx 26rpx;
  border-radius: 28rpx; text-align: left;
  display: flex; align-items: center; gap: 20rpx;
  background: var(--glass-1);
  border: 1rpx solid var(--hairline);
}
.dr-ico {
  width: 56rpx; height: 56rpx; flex: 0 0 56rpx; border-radius: 18rpx;
  display: flex; align-items: center; justify-content: center;
  background: rgba(var(--accent-rgb), 0.16);
}
.dr-txt { flex: 1; min-width: 0; }
.dr-t { font-size: 26rpx; font-weight: 700; color: var(--ink-100); }
.dr-s { margin-top: 4rpx; font-size: 22rpx; color: var(--ink-40); }
.dr-go { opacity: 0.45; }

/* 主按钮。紧跟主角时拉开一档（48rpx）；跟在小结行后面只需一档。 */
.done-cta {
  width: 100%; box-sizing: border-box;
  margin-top: 48rpx;
  height: 104rpx; border-radius: 32rpx;
  display: flex; align-items: center; justify-content: center;
  font-size: 30rpx; font-weight: 700;
  background: rgba(var(--good-rgb), 0.16);
  border: 1rpx solid rgba(var(--good-rgb), 0.45);
  color: var(--good);
}
.done-report + .done-cta { margin-top: 24rpx; }
.done-cta.is-busy { opacity: 0.6; }

/* 按钮下的一行小字：说清楚点下去会发生什么。它是主按钮标签的注脚，
   不是一条独立信息 —— 所以贴着按钮、字小、灰。 */
.done-cta-why {
  margin-top: 16rpx;
  font-size: 21rpx; color: var(--ink-40);
  line-height: 1.5; text-align: center;
}
/* 「只完成」：永远在，永远安静。把默认那条路选对，不等于把另一条藏起来。 */
.done-cta-plain {
  margin-top: 26rpx;
  font-size: 26rpx; color: var(--ink-60);
  text-decoration: underline;
  text-underline-offset: 6rpx;
}

/* ============ 退出确认（玻璃弹窗） ============ */
.quit-mask {
  position: fixed; inset: 0; z-index: 90;
  display: flex; align-items: center; justify-content: center;
  padding: 56rpx;
  background: rgba(0, 0, 0, 0.55);
  -webkit-backdrop-filter: blur(8rpx); backdrop-filter: blur(8rpx);
  animation: quit-fade 0.22s ease;
}
@keyframes quit-fade { from { opacity: 0; } to { opacity: 1; } }
.quit-card {
  width: 100%; max-width: 560rpx;
  border-radius: 32rpx;
  padding: 40rpx 36rpx 28rpx;
  border: 1rpx solid var(--hairline-hi);
  box-shadow: 0 40rpx 90rpx rgba(0, 0, 0, 0.5), inset 0 1rpx 0 rgba(255, 255, 255, 0.06);
  animation: quit-pop 0.28s cubic-bezier(0.25, 1, 0.5, 1);
}
@keyframes quit-pop {
  from { transform: scale(0.92); opacity: 0; }
  to { transform: scale(1); opacity: 1; }
}
.quit-title { font-size: 32rpx; font-weight: 800; color: var(--ink-100); text-align: center; }
.quit-sub { margin-top: 16rpx; font-size: 24rpx; color: var(--ink-60); line-height: 1.7; text-align: center; }
.quit-actions { display: flex; gap: 16rpx; margin-top: 32rpx; }
.quit-btn {
  flex: 1; height: 80rpx; border-radius: 24rpx;
  display: flex; align-items: center; justify-content: center;
  font-size: 26rpx; font-weight: 700;
  background: var(--glass-1); border: 1rpx solid var(--hairline);
  color: var(--ink-100);
}
.quit-btn.primary {
  background: rgba(var(--good-rgb), 0.16);
  border-color: rgba(var(--good-rgb), 0.45);
  color: var(--good);
}

