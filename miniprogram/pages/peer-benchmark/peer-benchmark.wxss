page {
  --lavender: var(--investment);
  --gold: #f3dfa3;
}

.page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  position: relative;
  overflow: hidden;
}

/* ============ 透明导航栏 ============ */
.navbar {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 0 24rpx 16rpx;
  gap: 16rpx;
  position: relative;
}
.nav-btn {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: var(--glass-1);
  border: 1rpx solid var(--hairline);
  display: flex;
  align-items: center;
  justify-content: center;
  -webkit-backdrop-filter: blur(20rpx);
  backdrop-filter: blur(20rpx);
}
.nav-btn-hover { background: var(--glass-3); transform: scale(0.96); }
.nav-title {
  position: absolute;
  left: 0; right: 0;
  font-size: 26rpx;
  font-weight: 500;
  color: var(--ink-100);
  text-align: center;
  letter-spacing: 0.5rpx;
  pointer-events: none;
}

.scroll { flex: 1; padding: 8rpx 24rpx 0; box-sizing: border-box; }

/* ============ 空态 / 设置态 ============ */
.empty-stage, .setup-stage {
  flex: 1;
  display: flex; flex-direction: column;
  align-items: center; justify-content: center;
  padding: 0 60rpx; text-align: center;
}
.empty-orb, .setup-orb {
  width: 132rpx; height: 132rpx; border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  background: radial-gradient(circle, rgba(var(--accent-rgb),0.18), rgba(var(--accent-rgb),0.04) 70%);
  border: 1rpx solid var(--hairline);
  margin-bottom: 28rpx;
}
.empty-title, .setup-title {
  font-size: 32rpx; font-weight: 600; color: var(--ink-100); margin-bottom: 12rpx;
}
.empty-desc, .setup-desc {
  font-size: 24rpx; color: var(--ink-60); line-height: 1.6; max-width: 480rpx;
}
.setup-cta {
  margin-top: 32rpx;
  padding: 20rpx 48rpx;
  border-radius: 20rpx;
  background: rgba(var(--accent-rgb),0.16);
  border: 1rpx solid rgba(var(--accent-rgb),0.4);
  color: var(--ice-blue);
  font-size: 28rpx; font-weight: 600;
}

/* ============ Hero ============ */
.hero {
  position: relative;
  padding: 28rpx 32rpx 28rpx;
  border-radius: 36rpx;
  margin-bottom: 24rpx;
  background: linear-gradient(155deg, rgba(var(--accent-rgb),0.13), rgba(var(--investment-rgb),0.07) 65%, rgba(255,255,255,0.02));
  border: 1rpx solid var(--hairline);
  overflow: hidden;
}
.hero::before {
  content: '';
  position: absolute; top: -90rpx; right: -70rpx;
  width: 480rpx; height: 480rpx; border-radius: 50%;
  pointer-events: none;
  background: radial-gradient(circle, rgba(var(--accent-rgb),0.28), transparent 70%);
  filter: blur(26rpx);
}
.hero-top {
  position: relative;
  display: flex; align-items: center; justify-content: space-between;
  margin-bottom: 18rpx;
}
.eyebrow { font-size: 18rpx; color: var(--ink-60); letter-spacing: 3rpx; text-transform: uppercase; }
.cohort-chip {
  display: inline-flex; align-items: center; gap: 8rpx;
  padding: 7rpx 16rpx; border-radius: 18rpx;
  background: var(--glass-1); border: 1rpx solid var(--hairline);
  font-size: 20rpx; color: var(--ink-80);
}
.cohort-chip .pen { font-size: 18rpx; color: var(--ink-40); }

.unlock-pill {
  position: relative;
  display: inline-flex; align-items: center; gap: 8rpx;
  margin-bottom: 18rpx;
  padding: 5rpx 16rpx; border-radius: 14rpx;
  background: rgba(var(--accent-rgb),0.14); border: 1rpx solid rgba(var(--accent-rgb),0.3);
  font-size: 18rpx; color: var(--ice-blue); letter-spacing: 0.5rpx;
}
.unlock-pill .d { width: 9rpx; height: 9rpx; border-radius: 50%; background: var(--ice-blue); box-shadow: 0 0 10rpx var(--ice-blue); }

.headline { position: relative; display: flex; align-items: baseline; gap: 12rpx; margin-bottom: 10rpx; }
.headline .lead { font-size: 30rpx; color: var(--ink-80); font-weight: 500; }
.headline .pct {
  font-size: 116rpx; font-weight: 700; line-height: 1; letter-spacing: -4rpx;
  font-variant-numeric: tabular-nums;
  color: #eaf4ff;
  text-shadow: 0 0 30rpx rgba(var(--accent-rgb),0.55);
}
.headline .unit { font-size: 44rpx; color: var(--ink-80); font-weight: 600; }

.sub-row { position: relative; display: flex; align-items: center; gap: 16rpx; margin-bottom: 18rpx; }
.tier-badge {
  padding: 5rpx 16rpx; border-radius: 14rpx;
  background: rgba(243,223,163,0.14); border: 1rpx solid rgba(243,223,163,0.3);
  color: var(--gold); font-size: 22rpx; font-weight: 600;
}
.sub-note { font-size: 20rpx; color: var(--ink-60); }

/* 百分位分布条 */
.dist { position: relative; margin: 8rpx 0 26rpx; padding-top: 48rpx; }
.dist-track {
  position: relative; height: 16rpx; border-radius: 8rpx;
  background: linear-gradient(90deg, rgba(255,255,255,0.06), rgba(var(--accent-rgb),0.10));
}
.dist-fill {
  position: absolute; left: 0; top: 0; bottom: 0; border-radius: 8rpx;
  background: linear-gradient(90deg, rgba(var(--accent-rgb),0.5), var(--accent));
  box-shadow: 0 0 12rpx rgba(var(--accent-rgb),0.5);
  transition: width 0.6s var(--ease-soft);
}
.dist-tick { position: absolute; top: -5rpx; bottom: -5rpx; width: 2rpx; background: rgba(255,255,255,0.18); transform: translateX(-50%); }
.dist-pin { position: absolute; top: 50%; transform: translate(-50%, -50%); display: flex; align-items: center; justify-content: center; }
.pin-dot {
  width: 24rpx; height: 24rpx; border-radius: 50%; background: #fff;
  border: 3rpx solid rgba(var(--accent-rgb),0.7);
  box-shadow: 0 0 14rpx rgba(var(--accent-rgb),0.9), 0 0 30rpx rgba(var(--accent-rgb),0.5);
}
.pin-flag {
  position: absolute; bottom: 30rpx; white-space: nowrap;
  padding: 5rpx 14rpx; border-radius: 14rpx;
  background: rgba(var(--accent-rgb),0.2); border: 1rpx solid rgba(var(--accent-rgb),0.42);
  color: var(--ice-blue); font-size: 20rpx; font-weight: 600;
  font-variant-numeric: tabular-nums;
}
.dist-axis { position: relative; height: 26rpx; margin-top: 16rpx; }
.dist-axis .ax { position: absolute; transform: translateX(-50%); font-size: 18rpx; color: var(--ink-40); white-space: nowrap; }

.hero-meta { position: relative; display: grid; grid-template-columns: 1fr 1fr; gap: 14rpx; }
.meta-item { padding: 16rpx 18rpx; border-radius: 18rpx; background: rgba(255,255,255,0.04); border: 1rpx solid var(--hairline); }
.meta-k { font-size: 18rpx; color: var(--ink-60); letter-spacing: 0.5rpx; }
.meta-v { margin-top: 8rpx; font-size: 32rpx; font-weight: 600; color: var(--ink-100); letter-spacing: -0.4rpx; }

.hero-tip {
  position: relative; margin-top: 20rpx; padding-top: 18rpx;
  border-top: 1rpx solid var(--hairline);
  font-size: 22rpx; color: var(--ink-80); line-height: 1.6;
}
.hero-tip .em { color: var(--gold); font-weight: 600; }

/* ============ section ============ */
.section-title { display: flex; align-items: center; justify-content: space-between; padding: 0 8rpx; margin: 26rpx 0 14rpx; }
.section-title .sec-name { font-size: 24rpx; font-weight: 600; color: var(--ink-80); letter-spacing: 1rpx; }
.section-title .sec-sub { font-size: 20rpx; color: var(--ink-60); }

/* ============ 财富阶梯 ============ */
.ladder { padding: 4rpx 28rpx; border-radius: 28rpx; background: var(--glass-0); border: 1rpx solid var(--hairline); }
.lad-row { display: flex; align-items: center; justify-content: space-between; padding: 24rpx 0; border-bottom: 1rpx solid var(--hairline); }
.lad-row:last-child { border-bottom: none; }
.lad-k { font-size: 26rpx; color: var(--ink-80); }
.lad-v { font-size: 30rpx; font-weight: 600; color: var(--ink-100); letter-spacing: -0.4rpx; }
.lad-row.top .lad-k, .lad-row.top .lad-v { color: var(--gold); }
.lad-row.median .lad-k, .lad-row.median .lad-v { color: var(--ink-60); }

.lad-you {
  margin: 14rpx -16rpx;
  padding: 22rpx 22rpx;
  border-radius: 22rpx;
  background: linear-gradient(135deg, rgba(var(--accent-rgb),0.16), rgba(var(--investment-rgb),0.08));
  border: 1rpx solid rgba(var(--accent-rgb),0.42);
  box-shadow: 0 0 28rpx rgba(var(--accent-rgb),0.16);
  display: flex; align-items: center; justify-content: space-between;
}
.lad-you .yk { display: flex; align-items: center; gap: 14rpx; }
.lad-you .you-tag { font-size: 20rpx; padding: 3rpx 14rpx; border-radius: 12rpx; background: var(--ice-blue); color: #07131f; font-weight: 700; }
.lad-you .yl { font-size: 26rpx; color: var(--ink-100); font-weight: 600; }
.lad-you .yv { font-size: 34rpx; font-weight: 700; color: #fff; letter-spacing: -0.5rpx; }

/* ============ 来源 ============ */
.source-card {
  margin-top: 18rpx; padding: 20rpx 22rpx;
  border-radius: 20rpx; background: var(--glass-0); border: 1rpx solid var(--hairline);
  display: flex; gap: 14rpx; align-items: flex-start;
}
.source-card .src-ic {
  flex-shrink: 0; width: 30rpx; height: 30rpx; border-radius: 50%;
  background: var(--glass-2); display: flex; align-items: center; justify-content: center;
  font-size: 20rpx; color: var(--ink-60);
}
.source-card .src-txt { font-size: 20rpx; color: var(--ink-60); line-height: 1.65; }
.source-card .src-txt .b { color: var(--ink-80); font-weight: 600; }

.bottom-spacer { height: 80rpx; }

.num { font-variant-numeric: tabular-nums; }
