<view class="canvas-bg theme-{{theme}}" wx:if="{{!reduceMotion}}"></view>

<view class="page {{reduceMotion ? 'no-motion' : ''}} theme-{{theme}}">
  <view class="settings-halo"></view>

  <!-- 透明导航栏 -->
  <view class="navbar" style="padding-top: {{statusBarHeight}}px;">
    <view class="nav-btn tap" hover-class="nav-btn-hover" bindtap="onBack">
      <view class="ic ic-xs ic-back"></view>
    </view>
    <text class="nav-title">设置</text>
    <view class="nav-spacer"></view>
  </view>

  <!-- Brand -->
  <view class="hero entry-up">
    <view>
      <image class="hero-icon" src="/assets/logo.png" mode="aspectFill" />
    </view>
    <text class="hero-title">净值本</text>
    <text class="hero-sub">{{version}}</text>
  </view>

  <view class="sec-card glass entry-up d1">
    <view class="row tap" hover-class="row-hover" bindtap="onBaseCurrency">
      <view class="row-icon"><view class="ic ic-sm ic-coin"></view></view>
      <view class="row-main">
        <text class="row-title">本位币</text>
      </view>
      <text class="row-trailing">{{baseCurrencyText}}</text>
      <view class="row-arrow"><view class="ic ic-xs ic-chevron-right"></view></view>
    </view>
    <view class="row tap" hover-class="row-hover" bindtap="onRates">
      <view class="row-icon"><view class="ic ic-sm ic-exchange"></view></view>
      <view class="row-main">
        <text class="row-title">汇率</text>
      </view>
      <text class="row-trailing">{{fxDate}}</text>
      <view class="row-arrow"><view class="ic ic-xs ic-chevron-right"></view></view>
    </view>
    <view class="row tap" hover-class="row-hover" bindtap="onTheme">
      <view class="row-icon"><view class="ic ic-sm ic-palette"></view></view>
      <view class="row-main">
        <text class="row-title">主题</text>
      </view>
      <text class="row-trailing">{{themeName}}</text>
      <view class="row-arrow"><view class="ic ic-xs ic-chevron-right"></view></view>
    </view>
    <view class="row row-switch">
      <view class="row-icon"><view class="ic ic-sm ic-settings"></view></view>
      <view class="row-main">
        <text class="row-title">简化动效</text>
      </view>
      <switch checked="{{reduceMotion}}" bindchange="onReduceMotionChange" color="{{accentColor}}" />
    </view>
    <view class="row tap" hover-class="row-hover" bindtap="onExport">
      <view class="row-icon"><view class="ic ic-sm ic-export"></view></view>
      <view class="row-main">
        <text class="row-title">导出数据</text>
      </view>
      <view class="row-arrow"><view class="ic ic-xs ic-chevron-right"></view></view>
    </view>
    <button class="feedback-row tap" hover-class="row-hover" open-type="feedback">
      <view class="row-icon"><view class="ic ic-sm ic-edit"></view></view>
      <view class="row-main">
        <text class="row-title">反馈</text>
      </view>
      <view class="row-arrow"><view class="ic ic-xs ic-chevron-right"></view></view>
    </button>
    <view class="row tap" hover-class="row-hover" bindtap="onChangelog">
      <view class="row-icon"><view class="ic ic-sm ic-clock"></view></view>
      <view class="row-main">
        <text class="row-title">更新日志</text>
      </view>
      <view class="row-arrow"><view class="ic ic-xs ic-chevron-right"></view></view>
    </view>
    <view class="row tap" hover-class="row-hover" bindtap="onAbout">
      <view class="row-icon"><view class="ic ic-sm ic-info"></view></view>
      <view class="row-main">
        <text class="row-title">关于小程序</text>
      </view>
      <view class="row-arrow"><view class="ic ic-xs ic-chevron-right"></view></view>
    </view>
  </view>

  <view class="foot">{{version}} · 用心打磨</view>

  <!-- 转发面板：文件已生成，由用户点按钮同步触发转发（满足 shareFileMessage 的点击手势要求） -->
  <view wx:if="{{sharePanelVisible}}" class="share-mask" bindtap="onCloseSharePanel">
    <view class="share-sheet" catchtap="noop">
      <view class="share-handle"></view>
      <view class="share-title">文件已准备好</view>
      <view class="share-file glass">
        <view class="share-file-icon"><view class="ic ic-sm ic-export"></view></view>
        <view class="share-file-info">
          <text class="share-file-name">{{exportFileName}}</text>
          <text class="share-file-meta">{{exportKindText}} · {{exportCount}} 条</text>
        </view>
      </view>
      <view class="share-tip">点下方按钮，选择「文件传输助手」或指定联系人。金额为明文，注意不要误发他人。</view>
      <view class="share-btn tap" hover-class="share-btn-hover" bindtap="onSharePrepared">转发到微信会话</view>
      <view class="share-cancel tap" bindtap="onCloseSharePanel">取消</view>
    </view>
  </view>
</view>
