<view class="page">
  <!-- 顶部品牌 -->
  <view class="hero">
    <image class="hero-icon" src="/assets/logo.png" mode="aspectFill" />
    <view class="hero-title">净值本</view>
    <view class="hero-sub">个人净资产快照工具 · {{version}}</view>
  </view>
  <view class="sec">
    <view class="sec-card">
      <button class="feedback row tap" open-type="feedback">
        <view class="row-icon">
          <view class="ic ic-edit"></view>
        </view>
        <view class="row-main">
          <view class="row-title">反馈</view>
          <view class="row-sub">欢迎提建议！开发者会尽力满足你的需求！</view>
        </view>
        <view class="row-arrow">›</view>
      </button>
      <view class="row tap" bindtap="onAbout">
        <view class="row-icon">
          <view class="ic ic-info"></view>
        </view>
        <view class="row-main">
          <view class="row-title">关于小程序</view>
          <view class="row-sub">数据存储 / 隐私 / 使用提示</view>
        </view>
        <view class="row-arrow">›</view>
      </view>
    </view>
  </view>

  <view class="foot">{{version}}</view>
</view>