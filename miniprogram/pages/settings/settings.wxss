.page {
  min-height: 100vh;
  background-color: #000000;
  padding: 24rpx 32rpx 64rpx;
}

/* 顶部品牌 */
.hero {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 48rpx 0 40rpx;
  gap: 12rpx;
}
.hero-icon {
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  background-color: #1C1C1E;
  overflow: hidden;
}
.hero-title {
  font-size: 40rpx;
  font-weight: 600;
  color: #FFFFFF;
  margin-top: 8rpx;
}
.hero-sub {
  font-size: 24rpx;
  color: rgba(235, 235, 245, 0.5);
}

.sec {
  margin-top: 24rpx;
}
.sec-title {
  font-size: 24rpx;
  color: rgba(235, 235, 245, 0.4);
  padding: 0 8rpx 12rpx;
  letter-spacing: 1rpx;
}
.sec-card {
  background-color: #1C1C1E;
  border-radius: 24rpx;
  overflow: hidden;
}

button.feedback {
  width: 100%;
  margin: 0;
  background: transparent;
  text-align: left;
  font-weight: 400;
}

.row {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 18rpx;
  padding: 24rpx 28rpx;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.06);
}
.row:last-child { border-bottom: none; }

.row-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 16rpx;
  background-color: rgba(255, 255, 255, 0.08);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.row-main {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  min-width: 0;
}
.row-title {
  font-size: 30rpx;
  color: #FFFFFF;
}
.row-danger { color: #F87171; }
.row-sub {
  font-size: 22rpx;
  color: rgba(235, 235, 245, 0.5);
}
.row-value {
  font-size: 28rpx;
  color: rgba(235, 235, 245, 0.6);
  flex-shrink: 0;
}
.row-arrow {
  color: rgba(235, 235, 245, 0.3);
  font-size: 36rpx;
  flex-shrink: 0;
}

.foot {
  margin-top: 64rpx;
  text-align: center;
  font-size: 22rpx;
  color: rgba(235, 235, 245, 0.3);
}

/* 重置 button 默认样式，使反馈行与普通行视觉一致 */
.row-btn {
  width: 100%;
  background: none;
  border-radius: 0;
  padding: 24rpx 28rpx;
  margin: 0;
  line-height: normal;
}
.row-btn::after { border: none; }
