.page {
  min-height: 100vh;
  padding: 0 32rpx 64rpx;
  position: relative;
  overflow: hidden;
}

/* ============ 透明 navbar ============ */
.navbar {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding-left: 0;
  padding-right: 0;
  padding-bottom: 14rpx;
  position: relative;
  z-index: 5;
}
.nav-title {
  font-size: 26rpx;
  color: var(--ink-80);
  font-weight: 500;
  letter-spacing: 0.04em;
}
.nav-btn {
  width: 56rpx; height: 56rpx;
  border-radius: 50%;
  background: var(--glass-1);
  border: 1rpx solid var(--hairline);
  display: flex; align-items: center; justify-content: center;
  -webkit-backdrop-filter: blur(20rpx);
  backdrop-filter: blur(20rpx);
}
.nav-btn-hover { background: var(--glass-3); transform: scale(0.95); }
.nav-spacer { width: 56rpx; }
.settings-halo {
  position: absolute;
  top: -40rpx; left: 50%;
  transform: translateX(-50%);
  width: 560rpx; height: 560rpx;
  background: radial-gradient(circle, rgba(var(--accent-rgb), 0.22), transparent 70%);
  filter: blur(56rpx);
  animation: pulse-glow 7s ease-in-out infinite;
  pointer-events: none;
  z-index: 0;
}

.hero-icon {
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  background-color: #1C1C1E;
  overflow: hidden;
}

.hero {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 48rpx 0 40rpx;
}
.hero-orb {
  width: 160rpx; height: 160rpx;
  border-radius: 48rpx;
  background: radial-gradient(circle at 30% 30%, rgba(var(--accent-rgb), 0.85), rgba(var(--accent-rgb), 0.18) 70%);
  border: 1rpx solid rgba(var(--accent-rgb), 0.5);
  box-shadow: inset 0 4rpx 0 rgba(255,255,255,0.3), 0 0 80rpx rgba(var(--accent-rgb), 0.45);
  display: flex; align-items: center; justify-content: center;
  animation: drift-icon 6s ease-in-out infinite;
}
.logo-shape {
  width: 72rpx; height: 72rpx;
  background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='36' height='36' viewBox='0 0 36 36' fill='none' stroke='%230a0d12' stroke-width='1.6' stroke-linejoin='round'><path d='M6 26 L 6 14 L 18 6 L 30 14 L 30 26 L 18 30 Z'/><path d='M6 14 L 18 22 L 30 14'/><path d='M18 22 L 18 30'/></svg>");
  background-size: contain;
  background-repeat: no-repeat;
  background-position: center;
}
.hero-title {
  margin-top: 28rpx;
  font-size: 36rpx;
  color: var(--ink-100);
  font-weight: 500;
}
.hero-sub {
  margin-top: 6rpx;
  font-size: 20rpx;
  color: var(--ink-40);
  letter-spacing: 0.18em;
  text-transform: uppercase;
}

.sec-card {
  position: relative;
  z-index: 1;
  margin: 24rpx 0;
  border-radius: 28rpx;
  overflow: hidden;
}

.feedback-row,
.row {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 20rpx;
  padding: 28rpx 28rpx;
  width: 100% !important;
  box-sizing: border-box;
  border-bottom: 1rpx solid var(--hairline);
  background: transparent;
  text-align: left;
  font-weight: 400;
  margin: 0 !important;
  line-height: normal;
}
.feedback-row::after { border: none; }
.sec-card .row:last-child,
.sec-card .feedback-row:last-child { border-bottom: none; }
.row-hover { background: var(--glass-1); }

.row-icon {
  width: 64rpx; height: 64rpx;
  border-radius: 18rpx;
  background: var(--glass-2);
  border: 1rpx solid var(--hairline);
  display: flex; align-items: center; justify-content: center;
  color: var(--ice-blue);
  flex-shrink: 0;
}
.row-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}
.row-title { font-size: 28rpx; color: var(--ink-100); font-weight: 500; }
.row-sub   { font-size: 20rpx; color: var(--ink-40); }
.row-arrow { color: var(--ink-40); }
.row-trailing { font-size: 20rpx; color: var(--ink-40); }

.foot {
  text-align: center;
  margin-top: 72rpx;
  font-size: 18rpx;
  color: var(--ink-20);
  letter-spacing: 0.22em;
}
