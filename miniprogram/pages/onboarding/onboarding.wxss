.page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  position: relative;
  overflow: hidden;
}

/* ============ 导航栏 ============ */
.navbar {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 0 24rpx 8rpx;
  min-height: 64rpx;
}
.nav-btn {
  width: 64rpx; height: 64rpx; border-radius: 50%;
  background: var(--glass-1); border: 1rpx solid var(--hairline);
  display: flex; align-items: center; justify-content: center;
}
.nav-btn-hover { background: var(--glass-3); transform: scale(0.96); }

/* ============ 挑账户 ============ */
.scroll { flex: 1; padding: 8rpx 32rpx 0; box-sizing: border-box; }
.head { margin: 8rpx 4rpx 8rpx; }
.head-title { font-size: 40rpx; font-weight: 800; color: var(--ink-100); }
.head-sub { margin-top: 10rpx; font-size: 24rpx; color: var(--ink-60); }

.sec { margin-top: 28rpx; }
.sec-label { font-size: 22rpx; letter-spacing: 2rpx; color: var(--ink-40); margin: 0 4rpx 14rpx; }
.chips { display: grid; grid-template-columns: 1fr 1fr; gap: 14rpx; }
.chip {
  position: relative;
  display: flex; align-items: center; gap: 16rpx;
  padding: 20rpx 20rpx;
  border-radius: 22rpx;
  background: var(--glass-1);
  border: 1rpx solid var(--hairline);
}
.chip.sel { border-color: rgba(var(--accent-rgb), 0.5); background: rgba(var(--accent-rgb), 0.10); }
.chip-hover { transform: scale(0.97); opacity: 0.9; }
.chip-ico {
  width: 56rpx; height: 56rpx; flex: 0 0 56rpx; border-radius: 16rpx;
  display: flex; align-items: center; justify-content: center;
}
.chip-name { flex: 1; min-width: 0; font-size: 27rpx; color: var(--ink-100); }
.chip-check { flex: 0 0 auto; font-size: 26rpx; font-weight: 800; }

/* ============ 底部主按钮 ============ */
.footer { padding: 20rpx 32rpx calc(40rpx + env(safe-area-inset-bottom)); }
.pbtn {
  height: 104rpx; border-radius: 32rpx;
  display: flex; align-items: center; justify-content: center;
  font-size: 30rpx; font-weight: 700;
  color: #0a1017;
  background: var(--accent);
  box-shadow: 0 12rpx 36rpx rgba(var(--accent-rgb), 0.28);
}
.pbtn-hover { transform: scale(0.98); opacity: 0.9; }
.pbtn.is-disabled { opacity: 0.35; pointer-events: none; box-shadow: none; }

/* ============ 逐个估余额（wizard）============ */
.wiz-meta { padding: 8rpx 32rpx 0; }
.wiz-counter { font-size: 26rpx; font-weight: 700; color: var(--ink-80); letter-spacing: 1rpx; }
.wiz-bar {
  height: 8rpx; border-radius: 8rpx; overflow: hidden;
  margin: 16rpx 32rpx 8rpx;
  background: var(--glass-1); border: 1rpx solid var(--hairline);
}
.wiz-fill {
  height: 100%; border-radius: 8rpx;
  background: linear-gradient(90deg, rgba(var(--accent-rgb), 0.5), var(--accent));
  transition: width 0.3s ease;
}
.wiz-card {
  margin: 40rpx 32rpx 0;
  border-radius: 36rpx;
  padding: 56rpx 32rpx 48rpx;
  text-align: center;
  background: var(--glass-1);
  border: 1rpx solid var(--hairline);
}
.wiz-orb {
  width: 120rpx; height: 120rpx; border-radius: 34rpx;
  margin: 0 auto;
  display: flex; align-items: center; justify-content: center;
}
.wiz-name { margin-top: 28rpx; font-size: 36rpx; font-weight: 800; color: var(--ink-100); }
.wiz-ask { margin-top: 20rpx; font-size: 24rpx; color: var(--ink-60); }

.wiz-actions { margin-top: auto; padding: 32rpx 32rpx calc(40rpx + env(safe-area-inset-bottom)); }
.wiz-skip { text-align: center; margin-top: 24rpx; font-size: 26rpx; color: var(--ink-60); padding: 12rpx; }

/* ============ 揭晓 ============ */
.reveal {
  flex: 1;
  display: flex; flex-direction: column; align-items: center;
  padding: 0 40rpx calc(40rpx + env(safe-area-inset-bottom));
}
.rv-eyebrow { margin-top: 200rpx; font-size: 24rpx; letter-spacing: 2rpx; color: var(--ink-60); }
.rv-big {
  margin-top: 20rpx;
  font-size: 84rpx; font-weight: 800; letter-spacing: -2rpx;
  color: var(--accent);
  text-shadow: 0 0 60rpx rgba(var(--accent-rgb), 0.45);
}
.rv-sub { margin-top: 22rpx; font-size: 24rpx; color: var(--ink-60); text-align: center; line-height: 1.7; }
.rv-cta {
  margin-top: auto; width: 100%; box-sizing: border-box;
  height: 104rpx; border-radius: 32rpx;
  display: flex; align-items: center; justify-content: center;
  font-size: 30rpx; font-weight: 700;
  color: #0a1017;
  background: var(--accent);
  box-shadow: 0 12rpx 36rpx rgba(var(--accent-rgb), 0.28);
}

.tail-space { height: 40rpx; }
