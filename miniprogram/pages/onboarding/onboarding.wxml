<view class="canvas-bg theme-{{theme}}" wx:if="{{!reduceMotion}}"></view>

<view class="page {{reduceMotion ? 'no-motion' : ''}} theme-{{theme}}">
  <view class="navbar" style="padding-top: {{statusBarHeight}}px;">
    <view wx:if="{{step !== 'reveal'}}" class="nav-btn tap" hover-class="nav-btn-hover" bindtap="onBack">
      <view class="ic ic-xs ic-back"></view>
    </view>
  </view>

  <!-- ============ 挑账户 ============ -->
  <block wx:if="{{step === 'pick'}}">
    <scroll-view scroll-y class="scroll" enable-flex>
      <view class="head entry-up">
        <view class="head-title">你有哪些账户？</view>
        <view class="head-sub">点亮你有的，先不用填数字</view>
      </view>

      <view wx:for="{{sections}}" wx:key="section" wx:for-item="sec" wx:for-index="si" class="sec">
        <view class="sec-label">{{sec.section}}</view>
        <view class="chips">
          <view
            wx:for="{{sec.items}}" wx:key="key" wx:for-item="it" wx:for-index="ii"
            class="chip {{it.selected ? 'sel' : ''}} tap" hover-class="chip-hover"
            data-s="{{si}}" data-i="{{ii}}" bindtap="onToggle"
          >
            <view class="chip-ico cat-tint-{{it.colorClass}}"><view class="ic ic-sm ic-{{it.icon}}"></view></view>
            <text class="chip-name">{{it.name}}</text>
            <text wx:if="{{it.selected}}" class="chip-check cat-{{it.colorClass}}">✓</text>
          </view>
        </view>
      </view>

      <view class="tail-space"></view>
    </scroll-view>

    <view class="footer">
      <view class="pbtn tap {{selectedCount ? '' : 'is-disabled'}}" hover-class="pbtn-hover" bindtap="onPickNext">
        下一步{{selectedCount ? ' · 已选 ' + selectedCount + ' 个' : ''}}
      </view>
    </view>
  </block>

  <!-- ============ 逐个估余额（复用盘点 wizard + amount-input）============ -->
  <block wx:elif="{{step === 'fill' && cur}}">
    <view class="wiz-meta"><text class="wiz-counter num">{{idx + 1}} / {{total}}</text></view>
    <view class="wiz-bar"><view class="wiz-fill" style="width: {{idx / total * 100}}%;"></view></view>

    <view class="wiz-card entry-up">
      <view class="wiz-orb cat-tint-{{cur.colorClass}}"><view class="ic ic-lg ic-{{cur.icon}}"></view></view>
      <view class="wiz-name">{{cur.name}}</view>
      <view class="wiz-ask">你大概有多少？估个大概就行，以后随时改</view>
    </view>

    <view class="wiz-actions">
      <view class="pbtn tap" hover-class="pbtn-hover" bindtap="onFillOpen">填余额</view>
      <view class="wiz-skip tap" bindtap="onSkip">先跳过，账户先建好、稍后再填 ›</view>
    </view>
  </block>

  <!-- ============ 揭晓 ============ -->
  <block wx:elif="{{step === 'reveal'}}">
    <view class="reveal">
      <view class="rv-eyebrow entry-up">这是你此刻的净资产</view>
      <view class="rv-big entry-up d1 num">{{netText}}</view>
      <view class="rv-sub entry-up d2">之后每次盘点，看着它长大</view>
      <view class="rv-cta tap entry-up d3" hover-class="pbtn-hover" bindtap="onEnter">进入净值本</view>
    </view>
  </block>
</view>

<amount-input
  id="ai"
  visible="{{showInput}}"
  mode="set"
  account-name="{{cur.name}}"
  account-icon-key="{{cur.icon}}"
  category-class="{{cur.colorClass}}"
  category-rgb="{{inputRgb}}"
  current-balance-text="未填写"
  currency="CNY"
  currency-symbol="¥"
  reduce-motion="{{reduceMotion}}"
  bindcancel="onInputCancel"
  bindconfirm="onInputConfirm"
/>
