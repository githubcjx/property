.bc-hint {
  margin: 8rpx 32rpx 24rpx;
  padding: 24rpx 26rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: var(--ink-80);
  background: rgba(246, 214, 138, 0.08);
  border: 1rpx solid rgba(246, 214, 138, 0.28);
}

.bc-list {
  margin: 0 32rpx;
  border-radius: 24rpx;
  background: var(--glass-1);
  border: 1rpx solid var(--hairline);
  overflow: hidden;
}

.bc-row {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 28rpx 28rpx;
  border-bottom: 1rpx solid var(--hairline);
}
.bc-row:last-child { border-bottom: none; }
.bc-row.sel { background: rgba(var(--accent-rgb), 0.08); }
.row-hover { background: rgba(255, 255, 255, 0.04); }

.bc-sym {
  width: 64rpx;
  height: 64rpx;
  flex: 0 0 64rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 800;
  color: var(--ink-80);
  background: var(--glass-2);
  border: 1rpx solid var(--hairline-hi);
}

.bc-info { flex: 1; display: flex; flex-direction: column; gap: 4rpx; }
.bc-code { font-size: 30rpx; font-weight: 700; color: var(--ink-100); }
.bc-sub { font-size: 22rpx; color: var(--ink-60); }

.bc-check {
  font-size: 34rpx;
  font-weight: 800;
  color: var(--accent);
  flex: 0 0 auto;
}
